{
  "name": "superframe",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "One engine for every medium: describe a piece in words, render it from a seed as paint, type, line, material, sound and touch, and read it back as a study.",
  "license": "FSL-1.1-MIT",
  "bin": {
    "superframe": "superframe/cli/superframe.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test superframe/tests/*.test.mjs creation/tests/*.test.mjs sound/reference/tests/*.test.mjs sound/tests/*.test.mjs typeface/forge/tests/*.test.mjs glass/tests/*.test.js lettering/tests/*.test.mjs name-art/tests/node.test.mjs studio/tests/*.test.mjs techniques/tests/*.test.mjs typeengine/tests/*.test.mjs visualizer/tests/*.test.mjs",
    "test:slow": "node --test --test-concurrency=1 name-art/tests/mosaic.test.mjs packages/site-music/tests/music.slow.mjs packages/ear/controls/controls.slow.mjs",
    "test:packages": "node --test \"packages/**/*.test.js\" \"packages/**/*.test.mjs\" && node packages/superstack/tests/run_vectors.mjs && python packages/superstack/tests/run_vectors.py",
    "test:py": "python -m pytest -q -p no:cacheprovider --import-mode=importlib packages && python -m pytest -q -p no:cacheprovider --import-mode=importlib library/open-archives",
    "test:games": "node --test \"games/low-water/game/engine/tests/!(community|fate|ledgerrun|lore|worldrecord).test.mjs\" \"games/low-water/game/engine/combat/tests/*.test.mjs\" \"games/low-water/game/engine/light/tests/*.test.mjs\" \"games/low-water/game/engine/fx/tests/*.test.mjs\" \"games/low-water/game/engine/paint/tests/bluenoise.test.mjs\" \"games/low-water/game/engine/paint/tests/charset.test.mjs\" \"games/low-water/game/engine/paint/tests/determinism.test.mjs\" \"games/low-water/game/engine/paint/tests/paint.test.mjs\" \"games/low-water/game/engine/paint/tests/parity.test.mjs\" \"games/low-water/game/engine/paint/tests/portrait.test.mjs\" \"games/low-water/game/engine/paint/tests/recipe.test.mjs\" \"games/low-water/game/engine/paint/tests/styles.test.mjs\" \"games/low-water/tools/studio/tests/*.test.mjs\" \"games/low-water/tools/tests/*.test.mjs\"",
    "test:games:open": "node --test \"games/low-water/game/engine/tests/community.test.mjs\" \"games/low-water/game/engine/tests/fate.test.mjs\" \"games/low-water/game/engine/tests/ledgerrun.test.mjs\" \"games/low-water/game/engine/tests/lore.test.mjs\" \"games/low-water/game/engine/tests/worldrecord.test.mjs\"",
    "test:rooms": "node --test \"packages/rooms/tests/*.test.mjs\"",
    "make": "node superframe/cli/superframe.mjs make"
  },
  "author": "Zain Dana Harper <zaindharper@gmail.com>",
  "repository": "github:HarperZ9/superframe"
}
