{
  "name": "superframe",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "One engine for every medium: describe a piece in words, render it from a seed as paint, type, line, material, sound and touch, and read it back as a study.",
  "license": "FSL-1.1-MIT",
  "bin": {
    "superframe": "superframe/cli/superframe.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test superframe/tests/*.test.mjs creation/tests/*.test.mjs sound/reference/tests/*.test.mjs typeface/forge/tests/*.test.mjs",
    "test:packages": "node --test \"packages/**/*.test.js\" \"packages/**/*.test.mjs\" && node packages/superstack/tests/run_vectors.mjs && python packages/superstack/tests/run_vectors.py",
    "test:py": "python -m pytest -q -p no:cacheprovider --import-mode=importlib packages",
    "test:games": "node --test \"games/low-water/game/engine/tests/*.test.mjs\" \"games/low-water/game/engine/combat/tests/*.test.mjs\"",
    "test:rooms": "node --test \"packages/rooms/tests/*.test.mjs\"",
    "make": "node superframe/cli/superframe.mjs make"
  },
  "author": "Zain Dana Harper <zaindharper@gmail.com>",
  "repository": "github:HarperZ9/superframe"
}
