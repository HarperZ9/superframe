# Low Water's native shell, milestone N0 (games/low-water/runtime/README.md). Off by default.
#   RAW_NATIVE_LW_SHELL=ON   builds the game code from BuildLang and links it over its C ABI:
#     lw_game          the C that buildc's C backend writes for games/low-water/runtime/game,
#                      compiled by this build's C compiler (no fused multiply-adds, as in the
#                      action timeline), with the header buildc generates
#     lw_shell_replay  replays an input trace on its tile with no window or GPU (every platform)
#     lw_shell         the game on Windows: window, keyboard and XInput pad, D3D12 with a
#                      waitable swapchain, frame and input traces (needs RAW_NATIVE_GPU_D3D12=ON)
# Needs buildc 1.15.0 or later: RAW_NATIVE_BUILDC, else BUILDC from the environment, else PATH.
option(RAW_NATIVE_LW_SHELL "Build Low Water's native shell from the BuildLang game code" OFF)
if(NOT RAW_NATIVE_LW_SHELL OR EMSCRIPTEN)
    return()
endif()
enable_language(C)
if(NOT RAW_NATIVE_BUILDC)
    if(DEFINED ENV{BUILDC})
        set(RAW_NATIVE_BUILDC "$ENV{BUILDC}")
    else()
        find_program(RAW_NATIVE_BUILDC buildc REQUIRED)
    endif()
endif()
set(LW_GAME_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../games/low-water/runtime/game")
set(lwgen "${CMAKE_CURRENT_BINARY_DIR}/gen-lwshell")
file(MAKE_DIRECTORY "${lwgen}")
add_custom_command(OUTPUT "${lwgen}/lw_game.c" "${lwgen}/lw_game.h"
    COMMAND "${RAW_NATIVE_BUILDC}" build --release --emit c .
    COMMAND "${RAW_NATIVE_BUILDC}" build --release --emit header .
    COMMAND ${CMAKE_COMMAND} -E copy target/release/main.c "${lwgen}/lw_game.c"
    COMMAND ${CMAKE_COMMAND} -E copy target/release/main.h "${lwgen}/lw_game.h"
    WORKING_DIRECTORY "${LW_GAME_DIR}"
    DEPENDS "${LW_GAME_DIR}/main.bld" VERBATIM
    COMMENT "buildc: Low Water game code to C")
add_library(lw_game STATIC "${lwgen}/lw_game.c")
target_include_directories(lw_game PUBLIC "${lwgen}")
target_compile_options(lw_game PRIVATE "$<IF:$<C_COMPILER_ID:MSVC>,/fp:precise;/W0;/wd4005,-ffp-contract=off;-w>")
if(WIN32)
    target_link_libraries(lw_game PUBLIC ws2_32)   # the BuildLang runtime's sockets (main.link)
else()
    target_link_libraries(lw_game PUBLIC m)
endif()

set(lwdir "${CMAKE_CURRENT_SOURCE_DIR}/src/tools/lwshell")
add_executable(lw_shell_replay app/lw_shell_replay.cpp "${lwdir}/lwshell_replay.cpp" "${lwdir}/lwshell_trace.cpp")
target_include_directories(lw_shell_replay PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}" "${lwdir}")
target_compile_features(lw_shell_replay PRIVATE cxx_std_23)
target_link_libraries(lw_shell_replay PRIVATE lw_game)

# The tier choice is pure logic over a probe; its test runs on every platform.
add_executable(lw_shell_tier_test tests/lwshell/tier_test.cpp "${lwdir}/lwshell_tier.cpp")
target_include_directories(lw_shell_tier_test PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}" "${lwdir}" "${CMAKE_CURRENT_SOURCE_DIR}/tests")
target_compile_features(lw_shell_tier_test PRIVATE cxx_std_23)
if(RAW_NATIVE_BUILD_TESTS)
    add_test(NAME lw_shell_tier COMMAND lw_shell_tier_test)
endif()

if(NOT RAW_NATIVE_GPU_D3D12)
    return()
endif()
# The shell's passes: one HLSL file, each entry compiled by dxc and embedded in raw_lwshell_shaders.hpp.
set(src "${lwdir}/shaders/lwshell.hlsl")
set(headers "")
set(includes "")
set(table "")
foreach(e "sky_vs|vs" "sky_fs|ps" "terrain_vs|vs" "terrain_fs|ps" "capsule_vs|vs" "capsule_fs|ps" "post_vs|vs" "post_fs|ps")
    string(REPLACE "|" ";" f "${e}")
    list(GET f 0 name)
    list(GET f 1 stage)
    set(h "${lwgen}/lwshell_${name}.h")
    add_custom_command(OUTPUT "${h}"
        COMMAND "${RAW_NATIVE_DXC}" -T ${stage}_6_0 -E ${name} -HV 2021 -O3 -Qstrip_debug -Qstrip_reflect
                -Fh "${h}" -Vn "kLwShell_${name}" "${src}"
        DEPENDS "${src}" VERBATIM COMMENT "dxc lwshell.hlsl (${name})")
    list(APPEND headers "${h}")
    string(APPEND includes "#include \"lwshell_${name}.h\"\n")
    string(APPEND table "    {\"${name}\", kLwShell_${name}, sizeof kLwShell_${name}},\n")
endforeach()
file(WRITE "${lwgen}/raw_lwshell_shaders.hpp.tmp"
    "#pragma once\n// Generated by cmake/lwshell.cmake. Do not edit.\n#include <cstddef>\n#include \"raw/rhi/rhi.hpp\"\n${includes}"
    "struct LwShellShaderBlob { const char* name; const void* bytes; std::size_t size; };\n"
    "inline constexpr raw::rhi::ShaderFormat kLwShellShaderFormat = raw::rhi::ShaderFormat::Dxil;\n"
    "inline constexpr LwShellShaderBlob kLwShellShaders[] = {\n${table}};\n")
configure_file("${lwgen}/raw_lwshell_shaders.hpp.tmp" "${lwgen}/raw_lwshell_shaders.hpp" COPYONLY)
add_executable(lw_shell app/lw_shell_main.cpp "${lwdir}/lwshell_cmd.cpp" "${lwdir}/lwshell_run.cpp" "${lwdir}/lwshell_render.cpp"
    "${lwdir}/lwshell_frametrace.cpp" "${lwdir}/lwshell_trace.cpp" "${lwdir}/lwshell_tier.cpp"
    src/platform/win32/window_win32.cpp src/platform/win32/input_win32.cpp ${headers})
target_include_directories(lw_shell PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}" "${lwdir}" "${lwgen}")
target_link_libraries(lw_shell PRIVATE raw_native_d3d12 lw_game user32 xinput)
message(STATUS "raw-native: Low Water shell on, game code by ${RAW_NATIVE_BUILDC}")
