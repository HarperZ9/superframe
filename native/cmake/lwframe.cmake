# The Low Water hero frame (raw/rhi/hw_frame.hpp): a night street on D3D12 with DXR inline ray
# queries. Off by default; needs RAW_NATIVE_GPU_D3D12=ON and a DXR tier 1.1 adapter to run.
#   RAW_NATIVE_LW_FRAME=ON   builds raw_native_hf (src/rhi/d3d12/hf_*.cpp and its shaders in
#                            src/rhi/d3d12/hw_shaders/hf_*.hlsl, embedded in raw_hf_dxil.hpp) and
#                            lw_frame (app/lw_frame.cpp, src/tools/lwframe/), which reads the hero
#                            kit's .glb (games/low-water/world/walk/build/hero) and CC0 texture sets
option(RAW_NATIVE_LW_FRAME "Build the Low Water hero frame (D3D12 + DXR)" OFF)
if(NOT RAW_NATIVE_LW_FRAME OR NOT RAW_NATIVE_GPU_D3D12)
    return()
endif()
set(hfdir "${CMAKE_CURRENT_SOURCE_DIR}/src/rhi/d3d12/hw_shaders")
set(hfgen "${CMAKE_CURRENT_BINARY_DIR}/gen-hf")
file(MAKE_DIRECTORY "${hfgen}")
file(GLOB hfincludes "${hfdir}/hf_*.hlsli")
# name|source|profile|defines|entry (the GTAO entries are bench/ao's fast kernel, unchanged)
set(hfentries
    "hf_cluster|hf_cluster|cs_6_5||main" "hf_gbuffer_vs|hf_gbuffer|vs_6_5||vs" "hf_gbuffer_ps|hf_gbuffer|ps_6_5||ps"
    "hf_gtao_pack|hf_gtao|cs_6_5|-DMODE=0|main" "hf_gtao_unpack|hf_gtao|cs_6_5|-DMODE=1|main"
    "hf_gtao_fpack|../../../../bench/ao/shaders/ours_gtao_fast|cs_6_0||CSPack" "hf_gtao_fmain|../../../../bench/ao/shaders/ours_gtao_fast|cs_6_0||CSMain"
    "hf_gtao_fblur|../../../../bench/ao/shaders/ours_gtao_fast|cs_6_0||CSBlur"
    "hf_direct_initial|hf_direct|cs_6_5|-DMODE=0|main" "hf_direct_shade|hf_direct|cs_6_5|-DMODE=1|main"
    "hf_gi|hf_indirect|cs_6_5|-DMODE=0|main" "hf_reflect|hf_indirect|cs_6_5|-DMODE=1|main"
    "hf_fog_inject|hf_fog|cs_6_5|-DMODE=0|main" "hf_fog_integrate|hf_fog|cs_6_5|-DMODE=1|main"
    "hf_temporal|hf_denoise|cs_6_5|-DMODE=0|main" "hf_atrous|hf_denoise|cs_6_5|-DMODE=1|main"
    "hf_composite|hf_post|cs_6_5|-DMODE=0|main" "hf_taa|hf_post|cs_6_5|-DMODE=1|main" "hf_bloom_down|hf_post|cs_6_5|-DMODE=2|main"
    "hf_bloom_up|hf_post|cs_6_5|-DMODE=3|main" "hf_tonemap|hf_post|cs_6_5|-DMODE=4|main" "hf_pt_resolve|hf_post|cs_6_5|-DMODE=5|main"
    "hf_snow_vs|hf_snow|vs_6_5||vs" "hf_snow_ps|hf_snow|ps_6_5||ps" "hf_pt|hf_pt|cs_6_5||main")
set(hfheaders "")
set(hfinc "")
set(hftable "")
foreach(e ${hfentries})
    string(REPLACE "|" ";" f "${e}")
    list(GET f 0 name)
    list(GET f 1 src)
    list(GET f 2 profile)
    list(GET f 3 defs)
    list(GET f 4 entry)
    separate_arguments(defs)
    set(h "${hfgen}/hfdxil_${name}.h")
    add_custom_command(OUTPUT "${h}"
        COMMAND "${RAW_NATIVE_DXC}" -T ${profile} -E ${entry} -HV 2021 -O3 -Qstrip_debug -Qstrip_reflect ${defs}
                -I "${hfdir}" -Fh "${h}" -Vn "kHfDxil_${name}" "${hfdir}/${src}.hlsl"
        DEPENDS "${hfdir}/${src}.hlsl" ${hfincludes} VERBATIM COMMENT "dxc ${src}.hlsl (${name})")
    list(APPEND hfheaders "${h}")
    string(APPEND hfinc "#include \"hfdxil_${name}.h\"\n")
    string(APPEND hftable "    {\"${name}\", kHfDxil_${name}, sizeof kHfDxil_${name}},\n")
endforeach()
file(WRITE "${hfgen}/raw_hf_dxil.hpp.tmp"
    "#pragma once\n// Generated by cmake/lwframe.cmake. Do not edit.\n#include <cstddef>\n${hfinc}"
    "struct HfDxilBlob { const char* name; const void* bytes; std::size_t size; };\n"
    "inline constexpr HfDxilBlob kHfDxil[] = {\n${hftable}};\n")
configure_file("${hfgen}/raw_hf_dxil.hpp.tmp" "${hfgen}/raw_hf_dxil.hpp" COPYONLY)
add_library(raw_native_hf STATIC src/rhi/d3d12/hf_device.cpp src/rhi/d3d12/hf_targets.cpp src/rhi/d3d12/hf_scene.cpp
    src/rhi/d3d12/hf_record.cpp src/rhi/d3d12/hf_frame.cpp ${hfheaders})
target_include_directories(raw_native_hf PRIVATE "${hfgen}" "${CMAKE_CURRENT_SOURCE_DIR}/src/rhi/d3d12")
target_link_libraries(raw_native_hf PUBLIC raw_native_d3d12)
set(lwfdir "${CMAKE_CURRENT_SOURCE_DIR}/src/tools/lwframe")
add_executable(lw_frame app/lw_frame.cpp "${lwfdir}/lwframe_scene.cpp" "${lwfdir}/lwframe_materials.cpp" "${lwfdir}/lwframe_sky.cpp" "${lwfdir}/lwframe_bc7.cpp"
    src/platform/win32/image_codec_win32.cpp)
target_include_directories(lw_frame PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}")
target_link_libraries(lw_frame PRIVATE raw_native_hf windowscodecs ole32)
message(STATUS "raw-native: Low Water hero frame on (lw_frame)")
