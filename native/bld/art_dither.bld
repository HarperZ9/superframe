    ];
    let mut v: Vec<u64> = Vec::new();
    let mut i: i32 = 0;
    while i < 1024 {
        v.push(arr[i as usize]);
        i = i + 1;
    }
    v
}

fn blue_threshold(tbl: &Vec<u64>, x: i32, y: i32) -> f32 {
    let xi: i32 = x & 63;
    let yi: i32 = y & 63;
    let idx: i32 = yi * 64 + xi;
    let word: u64 = tbl[(idx >> 2) as usize];
    let shift: u64 = ((idx & 3) * 12) as u64;
    let rank: i32 = ((word >> shift) & 4095u64) as i32;
    ((rank as f32) + 0.5f32) * (1.0f32 / 4096.0f32)
}

fn fnv_f32_vec(v: &Vec<f32>) -> u64 {
    let mut h: u64 = 1469598103934665603u64;
    let n: usize = v.len();
    let mut i: usize = 0;
    while i < n {
        let b: u32 = v[i].to_bits();
        let mut k: u32 = 0;
        while k < 4 {
            h = h ^ (((b >> (8 * k)) & 255u32) as u64);
            h = h.wrapping_mul(1099511628211u64);
            k = k + 1;
        }
        i = i + 1;
    }
    h
}

fn diffuse(
    g: &Vec<f32>,
    w: i32,
    h: i32,
    levels: i32,
    dx: &Vec<i32>,
    dy: &Vec<i32>,
    tw: &Vec<f32>,
    denom: f32,
) -> Vec<f32> {
    let n_px: usize = g.len();
    let mut e: Vec<f32> = Vec::new();
    let mut out: Vec<f32> = Vec::new();
    let mut i: usize = 0;
    while i < n_px {
        e.push(g[i]);
        out.push(0.0f32);
        i = i + 1;
    }
    let n_taps: usize = dx.len();
    let mut y: i32 = 0;
    while y < h {
        let mut x: i32 = 0;
        while x < w {
            let idx: usize = (y * w + x) as usize;
            let q: f32 = quant(e[idx], levels);
            let err: f32 = e[idx] - q;
            out[idx] = q;
            let mut k: usize = 0;
            while k < n_taps {
                let xx: i32 = x + dx[k];
                let yy: i32 = y + dy[k];
                if xx >= 0 && xx < w && yy < h {
                    let dst: usize = (yy * w + xx) as usize;
                    e[dst] = e[dst] + err * tw[k] / denom;
                }
                k = k + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    out
}

fn apply_method(method: i32, g: &Vec<f32>, w: i32, h: i32, bn: &Vec<u64>) -> Vec<f32> {
    let levels: i32 = 2;
    let period: i32 = 6;
    let bands: i32 = 6;
    if method == 0 || method == 1 || method == 2 {
        let n: i32 = if method == 0 { 2 } else if method == 1 { 4 } else { 8 };
        let n2: f32 = (n * n) as f32;
        let mut out: Vec<f32> = Vec::new();
        let mut y: i32 = 0;
        while y < h {
            let mut x: i32 = 0;
            while x < w {
                let v: f32 = g[(y * w + x) as usize];
                let t: f32 = ((bayer_rank(n, x % n, y % n) as f32) + 0.5f32) / n2;
                out.push(ordered(v, t, levels));
                x = x + 1;
            }
            y = y + 1;
        }
        return out;
    }
    if method == 3 {
        let mut dx: Vec<i32> = Vec::new();
        dx.push(1); dx.push(-1); dx.push(0); dx.push(1);
        let mut dy: Vec<i32> = Vec::new();
        dy.push(0); dy.push(1); dy.push(1); dy.push(1);
        let mut tw: Vec<f32> = Vec::new();
        tw.push(7.0f32); tw.push(3.0f32); tw.push(5.0f32); tw.push(1.0f32);
        return diffuse(g, w, h, levels, &dx, &dy, &tw, 16.0f32);
    }
    if method == 4 {
        let mut dx: Vec<i32> = Vec::new();
        dx.push(1); dx.push(2); dx.push(-1); dx.push(0); dx.push(1); dx.push(0);
        let mut dy: Vec<i32> = Vec::new();
        dy.push(0); dy.push(0); dy.push(1); dy.push(1); dy.push(1); dy.push(2);
        let mut tw: Vec<f32> = Vec::new();
        tw.push(1.0f32); tw.push(1.0f32); tw.push(1.0f32);
        tw.push(1.0f32); tw.push(1.0f32); tw.push(1.0f32);
        return diffuse(g, w, h, levels, &dx, &dy, &tw, 8.0f32);
    }
    if method == 5 {
        let mut dx: Vec<i32> = Vec::new();
        dx.push(1); dx.push(2); dx.push(-2); dx.push(-1); dx.push(0); dx.push(1);
        dx.push(2); dx.push(-2); dx.push(-1); dx.push(0); dx.push(1); dx.push(2);
        let mut dy: Vec<i32> = Vec::new();
        dy.push(0); dy.push(0); dy.push(1); dy.push(1); dy.push(1); dy.push(1);
        dy.push(1); dy.push(2); dy.push(2); dy.push(2); dy.push(2); dy.push(2);
        let mut tw: Vec<f32> = Vec::new();
        tw.push(8.0f32); tw.push(4.0f32); tw.push(2.0f32); tw.push(4.0f32);
        tw.push(8.0f32); tw.push(4.0f32); tw.push(2.0f32); tw.push(1.0f32);
        tw.push(2.0f32); tw.push(4.0f32); tw.push(2.0f32); tw.push(1.0f32);
        return diffuse(g, w, h, levels, &dx, &dy, &tw, 42.0f32);
    }
    if method == 6 {
        let mut out: Vec<f32> = Vec::new();
        let mut y: i32 = 0;
        while y < h {
            let mut x: i32 = 0;
            while x < w {
                let v: f32 = g[(y * w + x) as usize];
                out.push(ordered(v, blue_threshold(bn, x, y), levels));
                x = x + 1;
            }
            y = y + 1;
        }
        return out;
    }
    if method == 7 {
        let mut out: Vec<f32> = Vec::new();
        let mut y: i32 = 0;
        while y < h {
            let mut x: i32 = 0;
            while x < w {
                let v: f32 = g[(y * w + x) as usize];
                let ph: i32 = ((x + y) % period + period) % period;
                let lhs: f32 = ((ph as f32) + 0.5f32) / (period as f32);
                let rhs: f32 = 1.0f32 - clamp01(v);
                out.push(if lhs < rhs { 0.0f32 } else { 1.0f32 });
                x = x + 1;
            }
            y = y + 1;
        }
        return out;
    }
    let mut out: Vec<f32> = Vec::new();
    let mut y: i32 = 0;
    while y < h {
        let mut x: i32 = 0;
        while x < w {
            let v: f32 = g[(y * w + x) as usize];
            let k: i32 = min_i32(bands - 1, (clamp01(v) * (bands as f32)) as i32);
            let mut edge: bool = false;
            if x + 1 < w {
                let vr: f32 = g[(y * w + x + 1) as usize];
                let kr: i32 = min_i32(bands - 1, (clamp01(vr) * (bands as f32)) as i32);
                if kr != k { edge = true; }
            }
            if y + 1 < h {
                let vd: f32 = g[((y + 1) * w + x) as usize];
                let kd: i32 = min_i32(bands - 1, (clamp01(vd) * (bands as f32)) as i32);
                if kd != k { edge = true; }
            }
            out.push(if edge { 0.0f32 } else { 1.0f32 });
            x = x + 1;
        }
        y = y + 1;
    }
    out
}

fn min_i32(a: i32, b: i32) -> i32 {
    if a < b { a } else { b }
}

fn build_ramp(eps: f32) -> Vec<f32> {
    let mut px: Vec<f32> = Vec::new();
    let mut y: i32 = 0;
    while y < 64 {
        let mut x: i32 = 0;
        while x < 256 {
            px.push(((x as f32) + 0.5f32) / 256.0f32 + eps);
            x = x + 1;
        }
        y = y + 1;
    }
    px
}

fn build_card(eps: f32) -> Vec<f32> {
    let mut px: Vec<f32> = Vec::new();
    let mut y: i32 = 0;
    while y < 128 {
        let mut x: i32 = 0;
        while x < 128 {
            let mut v: f32 = if y < 64 {
                ((x as f32) + 0.5f32) / 128.0f32
            } else {
                (((y - 64) as f32) + 0.5f32) / 64.0f32
            };
            let dx: f32 = (x as f32) - 40.0f32;
            let dy: f32 = (y as f32) - 40.0f32;
            let ex: f32 = (x as f32) - 92.0f32;
            let ey: f32 = (y as f32) - 92.0f32;
            if dx * dx + dy * dy < 400.0f32 { v = 0.25f32; }
            if ex * ex + ey * ey < 576.0f32 { v = 0.8f32; }
            px.push(v + eps);
            x = x + 1;
        }
        y = y + 1;
    }
    px
}

pub fn dither_goldens_hash(eps: f64) -> u64 {
    let eps32: f32 = eps as f32;
    let bn: Vec<u64> = blue_noise_packed();
    let ramp: Vec<f32> = build_ramp(eps32);
    let card: Vec<f32> = build_card(eps32);
    let mut all: u64 = 1469598103934665603u64;
    let mut m: i32 = 0;
    while m < 9 {
        let img: Vec<f32> = apply_method(m, &ramp, 256, 64, &bn);
        all = all ^ fnv_f32_vec(&img);
        all = all.wrapping_mul(1099511628211u64);
        m = m + 1;
    }
    m = 0;
    while m < 9 {
        let img: Vec<f32> = apply_method(m, &card, 128, 128, &bn);
        all = all ^ fnv_f32_vec(&img);
        all = all.wrapping_mul(1099511628211u64);
        m = m + 1;
    }
    all
}
