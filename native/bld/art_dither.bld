// Renderer module #12: src/renderer/dither.cpp + raw/renderer/dither.hpp
// Reproduces tests/test_dither.cpp golden set pin 0xb9ca7e2db4a440f7 (GCC 13.3 and MSVC VS 18)
// across all 9 methods (Bayer2/4/8, Floyd-Steinberg, Atkinson, Stucki, BlueNoise, LineFill,
// ContourFill) on both ditherRamp (256 x 64) and ditherCard (128 x 128).

fn clamp01(v: f32) -> f32 {
    if v < 0.0f32 { return 0.0f32; }
    if v > 1.0f32 { return 1.0f32; }
    v
}

fn floor_f32(v: f32) -> f32 {
    floor(v as f64) as f32
}

fn quant(v: f32, levels: i32) -> f32 {
    let s: f32 = (levels - 1) as f32;
    floor_f32(clamp01(v) * s + 0.5f32) / s
}

fn ordered(v: f32, t: f32, levels: i32) -> f32 {
    let s: f32 = (levels - 1) as f32;
    let x: f32 = clamp01(v) * s;
    let lo: f32 = floor_f32(x);
    let step: f32 = if (x - lo) > t { 1.0f32 } else { 0.0f32 };
    (lo + step) / s
}

pub fn bayer_rank(n: i32, x: i32, y: i32) -> i32 {
    let mut k: i32 = 0;
    let mut m: i32 = n;
    while m > 1 {
        m = m >> 1;
        k = k + 1;
    }
    let mut r: i32 = 0;
    let mut b: i32 = 0;
    while b < k {
        let bit1: i32 = (((x ^ y) >> b) & 1) << (2 * (k - 1 - b) + 1);
        let bit0: i32 = ((y >> b) & 1) << (2 * (k - 1 - b));
        r = r | bit1 | bit0;
        b = b + 1;
    }
    r
}

