//
// Superframe Renderer Module #37: Photochemical Developer Adjacency Reaction-Diffusion PDE
// Bit-exact 0-ULP port of native/src/renderer/style_adjacency.cpp:
// coupled two-species developer exhaustion and bromide inhibition PDE on a multi-scale coarse
// chemistry grid with Michaelis-Menten silver development kinetics, reflecting Neumann borders,
// bilinear upsampling, and Eberhard/Mackie local-contrast edge enhancement.


pub struct M37AdjPlan {
    dev_um: f64,
    brom_um: f64,
    k_rate: f64,
    eta: f64,
    r_repl: f64,
    beta: f64,
    eta_b: f64,
    r_b: f64,
    gamma: f64,
    h0: f64,
    exposure: f64,
    pitch_um: f64,
    t_total: f64,
    w: i32,
    h: i32,
    s: i32,
    cw: i32,
    ch: i32,
    steps: i32,
    dc: f64,
    db: f64,
    dt: f64,
    decay: f64,
    lap_centre: f64,
}

fn m37_min_d(a: f64, b: f64) -> f64 {
    if b < a { return b; }
    a
}

fn m37_max_d(a: f64, b: f64) -> f64 {
    if a < b { return b; }
    a
}

fn m37_min_i(a: i32, b: i32) -> i32 {
    if b < a { return b; }
    a
}

fn m37_max_i(a: i32, b: i32) -> i32 {
    if a < b { return b; }
    a
}

fn m37_resolve(kind: i32, w: i32, h: i32) -> M37AdjPlan {
    // 0=eberhard, 1=mackie, 2=exhausted, 3=mackie coarse (pitchUm=90), 4=mackie un-exhausted ctrl
    let mut dev_um: f64 = 450.0;
    let mut brom_um: f64 = 300.0;
    let mut eta: f64 = 0.6;
    let mut r_repl: f64 = 1.5;
    let mut beta: f64 = 2.0;
    let mut eta_b: f64 = 0.5;
    let mut r_b: f64 = 1.0;
    let mut gamma: f64 = 1.6;
    let mut pitch_um: f64 = 0.0;
    if kind == 1 || kind == 3 || kind == 4 {
        brom_um = 700.0; beta = 6.0; eta_b = 0.8; r_b = 0.6;
        if kind == 3 { pitch_um = 90.0; }
        if kind == 4 { eta = 0.0; eta_b = 0.0; }
    } else if kind == 2 {
        dev_um = 800.0; brom_um = 350.0; eta = 0.7; r_repl = 0.3; eta_b = 0.4; gamma = 1.4;
    }
    if pitch_um <= 0.0 {
        pitch_um = 24900.0 / (w as f64);
    }
    let k_rate: f64 = 3.0;
    let t_total: f64 = 1.0;
    let s: i32 = m37_max_i(1, floor(m37_max_d(dev_um, brom_um) / (pitch_um * 2.5)) as i32);
    let cw: i32 = ceil((w as f64) / (s as f64)) as i32;
    let ch: i32 = ceil((h as f64) / (s as f64)) as i32;
    let px: f64 = pitch_um * (s as f64);
    let dc: f64 = pow(dev_um / px, 2.0) / t_total;
    let db: f64 = pow(brom_um / px, 2.0) / t_total;
    let max_r: f64 = m37_max_d(dc, m37_max_d(db, k_rate));
    let steps: i32 = m37_max_i(16, ceil((t_total * max_r) / 0.2) as i32);
    let dt: f64 = t_total / (steps as f64);
    let decay: f64 = pow(1.0 - k_rate * dt, steps as f64);
    M37AdjPlan {
        dev_um: dev_um, brom_um: brom_um, k_rate: k_rate, eta: eta, r_repl: r_repl,
        beta: beta, eta_b: eta_b, r_b: r_b, gamma: gamma, h0: 0.18, exposure: 1.0,
        pitch_um: pitch_um, t_total: t_total, w: w, h: h, s: s, cw: cw, ch: ch,
        steps: steps, dc: dc, db: db, dt: dt, decay: decay, lap_centre: 4.0,
    }
}

fn m37_developable(p: &M37AdjPlan, hv: f64) -> f64 {
    if hv <= 0.0 { return 0.0; }
    let q: f64 = pow(p.h0 / hv, p.gamma);
    1.0 / (1.0 + q)
}

fn m37_coarse_at(p: &M37AdjPlan, f_fld: &Vec<f64>, comp: i32, x: i32, y: i32) -> f64 {
    let s: f64 = p.s as f64;
    let cw: i32 = p.cw;
    let ch: i32 = p.ch;
    let u: f64 = ((x as f64) + 0.5) / s - 0.5;
    let v: f64 = ((y as f64) + 0.5) / s - 0.5;
    let x0: i32 = m37_max_i(0, m37_min_i(cw - 1, floor(u) as i32));
    let y0: i32 = m37_max_i(0, m37_min_i(ch - 1, floor(v) as i32));
    let x1: i32 = m37_min_i(cw - 1, x0 + 1);
    let y1: i32 = m37_min_i(ch - 1, y0 + 1);
    let fx: f64 = m37_max_d(0.0, m37_min_d(1.0, u - (x0 as f64)));
    let fy: f64 = m37_max_d(0.0, m37_min_d(1.0, v - (y0 as f64)));
    let g00: f64 = f_fld[(y0 * cw + x0) * 2 + comp];
    let g10: f64 = f_fld[(y0 * cw + x1) * 2 + comp];
    let g01: f64 = f_fld[(y1 * cw + x0) * 2 + comp];
    let g11: f64 = f_fld[(y1 * cw + x1) * 2 + comp];
    (g00 * (1.0 - fx) + g10 * fx) * (1.0 - fy) + (g01 * (1.0 - fx) + g11 * fx) * fy
}

fn m37_at(f_fld: &Vec<f64>, cw: i32, ch: i32, ii: i32, jj: i32, comp: i32) -> f64 {
    let ic: i32 = m37_max_i(0, m37_min_i(cw - 1, ii));
    let jc: i32 = m37_max_i(0, m37_min_i(ch - 1, jj));
    f_fld[(jc * cw + ic) * 2 + comp]
}

fn m37_run_adj_hash(p: &M37AdjPlan, scene: &Vec<f32>, h0: u64) -> u64 {
    let w: i32 = p.w;
    let h: i32 = p.h;
    let s: i32 = p.s;
    let cw: i32 = p.cw;
    let ch: i32 = p.ch;
    let n: i32 = w * h;
    let m: i32 = cw * ch;

    let mut a_buf: Vec<f64> = Vec::new();
    let mut d_buf: Vec<f64> = Vec::new();
    let mut i: i32 = 0;
    while i < n {
        a_buf.push(m37_developable(p, p.exposure * (scene[i * 4] as f64)));
        a_buf.push(m37_developable(p, p.exposure * (scene[i * 4 + 1] as f64)));
        a_buf.push(m37_developable(p, p.exposure * (scene[i * 4 + 2] as f64)));
        d_buf.push(0.0); d_buf.push(0.0); d_buf.push(0.0);
        i = i + 1;
    }

    let mut f_fld: Vec<f64> = Vec::new();
    i = 0;
    while i < m {
        f_fld.push(1.0);
        f_fld.push(0.0);
        i = i + 1;
    }

    let dt: f64 = p.dt;
    let mut it: i32 = 0;
    while it < p.steps {
        let mut dsum: Vec<f64> = Vec::new();
        let mut y: i32 = 0;
        while y < h {
            let mut x: i32 = 0;
            while x < w {
                let idx: i32 = y * w + x;
                let c: f64 = m37_coarse_at(p, &f_fld, 0, x, y);
                let b: f64 = m37_coarse_at(p, &f_fld, 1, x, y);
                let rate: f64 = (p.k_rate * c) / (1.0 + p.beta * b);
                let d0: f64 = rate * (a_buf[idx * 3] - d_buf[idx * 3]) * dt;
                d_buf[idx * 3] = d_buf[idx * 3] + d0;
                let d1: f64 = rate * (a_buf[idx * 3 + 1] - d_buf[idx * 3 + 1]) * dt;
                d_buf[idx * 3 + 1] = d_buf[idx * 3 + 1] + d1;
                let d2: f64 = rate * (a_buf[idx * 3 + 2] - d_buf[idx * 3 + 2]) * dt;
                d_buf[idx * 3 + 2] = d_buf[idx * 3 + 2] + d2;
                dsum.push(d0 + d1 + d2);
                x = x + 1;
            }
            y = y + 1;
        }
        let mut g_fld: Vec<f64> = Vec::new();
        let mut j: i32 = 0;
        while j < ch {
            let mut ci: i32 = 0;
            while ci < cw {
                let mut used: f64 = 0.0;
                let mut cnt: f64 = 0.0;
                let y_lim: i32 = m37_min_i(h, j * s + s);
                let x_lim: i32 = m37_min_i(w, ci * s + s);
                let mut yy: i32 = j * s;
                while yy < y_lim {
                    let mut xx: i32 = ci * s;
                    while xx < x_lim {
                        used = used + dsum[yy * w + xx];
                        cnt = cnt + 1.0;
                        xx = xx + 1;
                    }
                    yy = yy + 1;
                }
                used = used / cnt;
                let o: i32 = (j * cw + ci) * 2;
                let c0: f64 = f_fld[o];
                let b0: f64 = f_fld[o + 1];
                let lc: f64 = m37_at(&f_fld, cw, ch, ci - 1, j, 0)
                    + m37_at(&f_fld, cw, ch, ci + 1, j, 0)
                    + m37_at(&f_fld, cw, ch, ci, j - 1, 0)
                    + m37_at(&f_fld, cw, ch, ci, j + 1, 0)
                    - p.lap_centre * c0;
                let lb: f64 = m37_at(&f_fld, cw, ch, ci - 1, j, 1)
                    + m37_at(&f_fld, cw, ch, ci + 1, j, 1)
                    + m37_at(&f_fld, cw, ch, ci, j - 1, 1)
                    + m37_at(&f_fld, cw, ch, ci, j + 1, 1)
                    - p.lap_centre * b0;
                g_fld.push(c0 + p.dc * lc * dt - p.eta * used + p.r_repl * (1.0 - c0) * dt);
                g_fld.push(b0 + p.db * lb * dt + p.eta_b * used - p.r_b * b0 * dt);
                ci = ci + 1;
            }
            j = j + 1;
        }
        f_fld = g_fld;
        it = it + 1;
    }

    let free_d: f64 = 1.0 - p.decay;
    let eps: f64 = 1.0e-6;
    let mut hash: u64 = h0;
    i = 0;
    while i < n {
        let r_o: f64 = (scene[i * 4] as f64) * ((d_buf[i * 3] + eps) / (a_buf[i * 3] * free_d + eps));
        let g_o: f64 = (scene[i * 4 + 1] as f64) * ((d_buf[i * 3 + 1] + eps) / (a_buf[i * 3 + 1] * free_d + eps));
        let b_o: f64 = (scene[i * 4 + 2] as f64) * ((d_buf[i * 3 + 2] + eps) / (a_buf[i * 3 + 2] * free_d + eps));
        hash = kit::fnv_f32(hash, r_o);
        hash = kit::fnv_f32(hash, g_o);
        hash = kit::fnv_f32(hash, b_o);
        hash = kit::fnv_f32(hash, 1.0);
        i = i + 1;
    }
    hash
}

fn m37_make_chart(w: i32, h: i32) -> Vec<f32> {
    let mut src: Vec<f32> = Vec::new();
    let mut y: i32 = 0;
    while y < h {
        let mut x: i32 = 0;
        while x < w {
            let mut r: f64 = 0.05;
            let mut g: f64 = 0.06;
            let mut b: f64 = 0.07;
            if x >= w / 2 {
                r = 0.92; g = 0.84; b = 0.72;
            }
            if x >= 9 && x <= 10 && y >= 5 && y <= 26 {
                r = 0.90; g = 0.88; b = 0.85;
            }
            if x >= 32 && x <= 39 && y >= 10 && y <= 20 {
                r = 0.04; g = 0.05; b = 0.06;
            }
            src.push(r as f32); src.push(g as f32); src.push(b as f32); src.push(1.0 as f32);
            x = x + 1;
        }
        y = y + 1;
    }
    src
}

pub fn run_adjacency_parity() -> (u64, u64, u64, u64, u64, u64) {
    let w: i32 = 48;
    let h: i32 = 32;
    let src: Vec<f32> = m37_make_chart(w, h);
    let pl_eb: M37AdjPlan = m37_resolve(0, w, h);
    let pl_mac: M37AdjPlan = m37_resolve(1, w, h);
    let pl_exh: M37AdjPlan = m37_resolve(2, w, h);
    let pl_crs: M37AdjPlan = m37_resolve(3, w, h);
    let pl_ctrl: M37AdjPlan = m37_resolve(4, w, h);

    let h_eb: u64 = m37_run_adj_hash(&pl_eb, &src, kit::fnv_start());
    let h_mac: u64 = m37_run_adj_hash(&pl_mac, &src, kit::fnv_start());
    let h_exh: u64 = m37_run_adj_hash(&pl_exh, &src, kit::fnv_start());
    let h_crs: u64 = m37_run_adj_hash(&pl_crs, &src, kit::fnv_start());
    let h_ctrl: u64 = m37_run_adj_hash(&pl_ctrl, &src, kit::fnv_start());

    let mut h_all: u64 = kit::fnv_start();
    h_all = m37_run_adj_hash(&pl_eb, &src, h_all);
    h_all = m37_run_adj_hash(&pl_mac, &src, h_all);
    h_all = m37_run_adj_hash(&pl_exh, &src, h_all);
    h_all = m37_run_adj_hash(&pl_crs, &src, h_all);

    (h_eb, h_mac, h_exh, h_crs, h_all, h_ctrl)
}
