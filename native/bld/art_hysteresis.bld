//
// Superframe Renderer Module #32: Temporal Schmitt-Trigger Hysteresis Quantisation
// Bit-exact 0-ULP port of native/src/renderer/style_hysteresis.cpp:
// soft-shoulder tone curve, OKLab projection, bands6 and PICO-8 palette Schmitt-trigger
// temporal persistence with motion-vector reprojection, depth-discontinuity guard, K-frame
// hold counter, and sRGB 8-bit display encoding.


pub struct M32PalLab {
    l: f64,
    a: f64,
    b: f64,
}

pub struct M32HystPlan {
    bands: bool,
    n_bands: i32,
    margin: f64,
    gain: f64,
    depth_tol: f64,
    keep_half: f64,
    k_persist: i32,
    pal: Vec<M32PalLab>,
}

fn m32_min_d(a: f64, b: f64) -> f64 {
    if b < a { return b; }
    a
}

fn m32_max_d(a: f64, b: f64) -> f64 {
    if a < b { return b; }
    a
}

fn m32_shoulder(v: f64, g: f64) -> f64 {
    1.0 - exp(-m32_max_d(0.0, v) * g)
}

fn m32_srgb_to_lin(c: f64) -> f64 {
    if c <= 0.04045 { return c / 12.92; }
    pow((c + 0.055) / 1.055, 2.4)
}

fn m32_lin_to_oklab(r: f64, g: f64, b: f64) -> (f64, f64, f64) {
    let l: f64 = cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
    let m: f64 = cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
    let s: f64 = cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
    (
        0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
        1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
        0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s,
    )
}

fn m32_from_oklab(ol: f64, oa: f64, ob: f64) -> (f64, f64, f64) {
    let l: f64 = pow(ol + 0.3963377774 * oa + 0.2158037573 * ob, 3.0);
    let m: f64 = pow(ol - 0.1055613458 * oa - 0.0638541728 * ob, 3.0);
    let s: f64 = pow(ol - 0.0894841775 * oa - 1.2914855480 * ob, 3.0);
    (
        4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
        -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
        -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s,
    )
}

fn m32_enc8(v: f64) -> u64 {
    let c: f64 = m32_min_d(1.0, m32_max_d(0.0, v));
    let s: f64 = if c <= 0.0031308 { c * 12.92 } else { 1.055 * pow(c, 1.0 / 2.4) - 0.055 };
    floor(s * 255.0 + 0.5) as u64
}

fn m32_dist3(al: f64, aa: f64, ab: f64, bl: f64, ba: f64, bb: f64) -> f64 {
    let dx: f64 = kit::absd(al - bl);
    let dy: f64 = kit::absd(aa - ba);
    let dz: f64 = kit::absd(ab - bb);
    let mx: f64 = m32_max_d(dx, m32_max_d(dy, dz));
    if mx == 0.0 { return 0.0; }
    let sx: f64 = dx / mx;
    let sy: f64 = dy / mx;
    let sz: f64 = dz / mx;
    mx * sqrt(sx * sx + sy * sy + sz * sz)
}

fn m32_push_pico(pal: &mut Vec<M32PalLab>, r: i32, g: i32, b: i32) {
    let (ol, oa, ob) = m32_lin_to_oklab(
        m32_srgb_to_lin((r as f64) / 255.0),
        m32_srgb_to_lin((g as f64) / 255.0),
        m32_srgb_to_lin((b as f64) / 255.0),
    );
    pal.push(M32PalLab { l: ol, a: oa, b: ob });
}

fn m32_pico8_pal() -> Vec<M32PalLab> {
    let mut p: Vec<M32PalLab> = Vec::new();
    m32_push_pico(&mut p, 0, 0, 0); m32_push_pico(&mut p, 29, 43, 83);
    m32_push_pico(&mut p, 126, 37, 83); m32_push_pico(&mut p, 0, 135, 81);
    m32_push_pico(&mut p, 171, 82, 54); m32_push_pico(&mut p, 95, 87, 79);
    m32_push_pico(&mut p, 194, 195, 199); m32_push_pico(&mut p, 255, 241, 232);
    m32_push_pico(&mut p, 255, 0, 77); m32_push_pico(&mut p, 255, 163, 0);
    m32_push_pico(&mut p, 255, 236, 39); m32_push_pico(&mut p, 0, 228, 54);
    m32_push_pico(&mut p, 41, 173, 255); m32_push_pico(&mut p, 131, 118, 156);
    m32_push_pico(&mut p, 255, 119, 168); m32_push_pico(&mut p, 255, 204, 170);
    p
}

fn m32_preset(kind: i32) -> M32HystPlan {
    // 0 = bands6, 1 = pico8, 2 = bands6 zero-hysteresis control (margin=0, K=1)
    let k_p: i32 = if kind == 2 { 1 } else { 5 };
    if kind == 1 {
        return M32HystPlan {
            bands: false, n_bands: 6, margin: 0.03, gain: 2.4,
            depth_tol: 0.03, keep_half: 0.5, k_persist: k_p, pal: m32_pico8_pal(),
        };
    }
    let mrg: f64 = if kind == 2 { 0.0 } else { 0.3 };
    let empty_pal: Vec<M32PalLab> = Vec::new();
    M32HystPlan {
        bands: true, n_bands: 6, margin: mrg, gain: 2.4,
        depth_tol: 0.03, keep_half: 0.5, k_persist: k_p, pal: empty_pal,
    }
}

fn m32_plain(p: &M32HystPlan, ol: f64, oa: f64, ob: f64) -> i32 {
    if p.bands {
        let x: f64 = ol * (p.n_bands as f64);
        return m32_min_d(p.n_bands as f64, m32_max_d(0.0, floor(x + 0.5))) as i32;
    }
    let n: i32 = p.pal.len() as i32;
    let mut best: i32 = 0;
    let mut bd: f64 = 1.0e30;
    let mut k: i32 = 0;
    while k < n {
        let d: f64 = m32_dist3(ol, oa, ob, p.pal[k].l, p.pal[k].a, p.pal[k].b);
        if d < bd {
            bd = d;
            best = k;
        }
        k = k + 1;
    }
    best
}

fn m32_keep(p: &M32HystPlan, ol: f64, oa: f64, ob: f64, prev: i32, pl: i32) -> bool {
    if p.bands {
        let x: f64 = ol * (p.n_bands as f64);
        let lo: f64 = (prev as f64) - p.keep_half - p.margin;
        let hi: f64 = (prev as f64) + p.keep_half + p.margin;
        return x >= lo && x <= hi;
    }
    let dp: f64 = m32_dist3(ol, oa, ob, p.pal[prev].l, p.pal[prev].a, p.pal[prev].b);
    let db: f64 = m32_dist3(ol, oa, ob, p.pal[pl].l, p.pal[pl].a, p.pal[pl].b);
    dp <= db + p.margin
}

fn m32_run_seq(p: &M32HystPlan, w: i32, h: i32, use_motion: bool, h0: u64) -> u64 {
    let n: i32 = w * h;
    let mut st_idx: Vec<i32> = Vec::new();
    let mut st_cnt: Vec<i32> = Vec::new();
    let mut st_dist: Vec<f32> = Vec::new();
    let mut has_state: bool = false;
    let mut hash: u64 = h0;

    let mut frame: i32 = 0;
    while frame < 6 {
        let osc: f64 = 0.065 * sin((frame as f64) * 1.15);
        let drift: f64 = 0.032 * (frame as f64);
        let mut rgba: Vec<f32> = Vec::new();
        let mut dist: Vec<f32> = Vec::new();
        let mut mv: Vec<f32> = Vec::new();
        let mut y: i32 = 0;
        while y < h {
            let mut x: i32 = 0;
            while x < w {
                let mut r: f64 = 0.04 + 0.95 * ((x as f64) / (w as f64)) + osc + drift;
                let mut g: f64 = 0.06 + 0.85 * ((y as f64) / (h as f64)) - 0.5 * osc + 0.5 * drift;
                let mut b: f64 = 0.05 + 0.75 * (1.0 - (x as f64) / (w as f64)) + 0.4 * osc;
                if r < 0.0 { r = 0.0; }
                if g < 0.0 { g = 0.0; }
                if b < 0.0 { b = 0.0; }
                rgba.push(r as f32); rgba.push(g as f32); rgba.push(b as f32); rgba.push(1.0 as f32);
                let fg: bool = x >= 10 + frame && x <= 18 + frame && y >= 6 && y <= 15;
                let dv: f64 = if fg { 2.5 } else { 10.0 };
                dist.push(dv as f32);
                if use_motion {
                    let mvx: f64 = if fg { 1.0 } else { 0.25 };
                    let mvy: f64 = if fg { 0.0 } else { -0.20 };
                    mv.push(mvx as f32);
                    mv.push(mvy as f32);
                }
                x = x + 1;
            }
            y = y + 1;
        }

        let mut next_idx: Vec<i32> = Vec::new();
        let mut next_cnt: Vec<i32> = Vec::new();
        let mut out_rgba: Vec<u64> = Vec::new();
        y = 0;
        while y < h {
            let mut x: i32 = 0;
            while x < w {
                let i: i32 = y * w + x;
                let o: i32 = i * 4;
                let (ol, oa, ob) = m32_lin_to_oklab(
                    m32_shoulder(rgba[o] as f64, p.gain),
                    m32_shoulder(rgba[o + 1] as f64, p.gain),
                    m32_shoulder(rgba[o + 2] as f64, p.gain),
                );
                let pl: i32 = m32_plain(p, ol, oa, ob);
                let mut d: i32 = pl;
                let mut nc: i32 = 0;
                if has_state {
                    let mx: f64 = if use_motion { mv[i * 2] as f64 } else { 0.0 };
                    let my: f64 = if use_motion { mv[i * 2 + 1] as f64 } else { 0.0 };
                    let px: i32 = floor((x as f64) + 0.5 - mx) as i32;
                    let py: i32 = floor((y as f64) + 0.5 - my) as i32;
                    if px >= 0 && py >= 0 && px < w && py < h {
                        let j: i32 = py * w + px;
                        let expect: f64 = dist[i] as f64;
                        let gap: f64 = kit::absd((st_dist[j] as f64) - expect);
                        let tol: f64 = p.depth_tol * expect;
                        if gap <= tol {
                            let prev: i32 = st_idx[j];
                            if prev != pl && m32_keep(p, ol, oa, ob, prev, pl) {
                                let c_next: i32 = st_cnt[j] + 1;
                                if c_next < p.k_persist {
                                    d = prev;
                                    nc = c_next;
                                }
                            }
                        }
                    }
                }
                next_idx.push(d);
                next_cnt.push(nc);
                let mut r0: f64 = 0.0;
                let mut g0: f64 = 0.0;
                let mut b0: f64 = 0.0;
                if p.bands {
                    let lq: f64 = (d as f64) / (p.n_bands as f64);
                    let sc: f64 = if ol > 1.0e-9 { lq / ol } else { 0.0 };
                    let (rr, gg, bb) = m32_from_oklab(lq, oa * sc, ob * sc);
                    r0 = rr; g0 = gg; b0 = bb;
                } else {
                    let (rr, gg, bb) = m32_from_oklab(p.pal[d].l, p.pal[d].a, p.pal[d].b);
                    r0 = rr; g0 = gg; b0 = bb;
                }
                out_rgba.push(m32_enc8(r0));
                out_rgba.push(m32_enc8(g0));
                out_rgba.push(m32_enc8(b0));
                out_rgba.push(255);
                x = x + 1;
            }
            y = y + 1;
        }

        let mut hi: i32 = 0;
        while hi < n {
            hash = kit::fnv_u8(hash, (next_idx[hi] & 255) as u64);
            hash = kit::fnv_u8(hash, (next_cnt[hi] & 255) as u64);
            hi = hi + 1;
        }
        let nr: i32 = out_rgba.len() as i32;
        let mut ri: i32 = 0;
        while ri < nr {
            hash = kit::fnv_u8(hash, out_rgba[ri]);
            ri = ri + 1;
        }
        st_idx = next_idx;
        st_cnt = next_cnt;
        st_dist = dist;
        has_state = true;
        frame = frame + 1;
    }
    hash
}

pub fn run_hysteresis_parity() -> (u64, u64, u64, u64, u64, u64) {
    let w: i32 = 32;
    let h: i32 = 24;
    let p_bands: M32HystPlan = m32_preset(0);
    let p_pico: M32HystPlan = m32_preset(1);
    let p_ctrl: M32HystPlan = m32_preset(2);

    let h_bstat: u64 = m32_run_seq(&p_bands, w, h, false, kit::fnv_start());
    let h_bmot: u64 = m32_run_seq(&p_bands, w, h, true, kit::fnv_start());
    let h_pstat: u64 = m32_run_seq(&p_pico, w, h, false, kit::fnv_start());
    let h_pmot: u64 = m32_run_seq(&p_pico, w, h, true, kit::fnv_start());
    let h_ctrl: u64 = m32_run_seq(&p_ctrl, w, h, true, kit::fnv_start());

    let mut h_all: u64 = kit::fnv_start();
    h_all = m32_run_seq(&p_bands, w, h, false, h_all);
    h_all = m32_run_seq(&p_bands, w, h, true, h_all);
    h_all = m32_run_seq(&p_pico, w, h, false, h_all);
    h_all = m32_run_seq(&p_pico, w, h, true, h_all);

    (h_bstat, h_bmot, h_pstat, h_pmot, h_all, h_ctrl)
}
