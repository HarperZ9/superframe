//
// Superframe native/bld Module #17: Float64 SDF evaluator, sphere tracer, shading terms,
// analytic and Simpson-marched height fog, Henyey-Greenstein phase, and god rays.
// Bit-exact 0 ULP port of native/src/renderer/sdf_eval.cpp and sdf_march.cpp.


pub struct S3 { x: f64, y: f64, z: f64 }
pub struct F3 { x: f32, y: f32, z: f32 }
pub struct SdfSample { d: f64, mat: i32 }
pub struct SdfHit { hit: bool, t: f64, mat: i32, n: S3, closest: f64, steps: i32 }
pub struct SdfProg { nodes: Vec<f32>, fractal: bool }
pub struct SdfScene {
    prog: SdfProg,
    eye: F3,
    target: F3,
    up: F3,
    fovy: f32,
    sun_dir: F3,
    fog_a: f32,
    fog_b: f32,
}

pub fn s3(x: f64, y: f64, z: f64) -> S3 { S3 { x: x, y: y, z: z } }
pub fn f3(x: f32, y: f32, z: f32) -> F3 { F3 { x: x, y: y, z: z } }
pub fn d3_of(v: F3) -> S3 { s3(v.x as f64, v.y as f64, v.z as f64) }

fn add3(a: S3, b: S3) -> S3 { s3(a.x + b.x, a.y + b.y, a.z + b.z) }
fn sub3(a: S3, b: S3) -> S3 { s3(a.x - b.x, a.y - b.y, a.z - b.z) }
fn mul3(a: S3, s: f64) -> S3 { s3(a.x * s, a.y * s, a.z * s) }
fn at3(o: S3, d: S3, t: f64) -> S3 { s3(o.x + d.x * t, o.y + d.y * t, o.z + d.z * t) }
fn dot3(a: S3, b: S3) -> f64 { a.x * b.x + a.y * b.y + a.z * b.z }
fn len3(a: S3) -> f64 { sqrt(dot3(a, a)) }
fn unit3(a: S3) -> S3 {
    let l: f64 = sqrt(dot3(a, a));
    s3(a.x / l, a.y / l, a.z / l)
}
fn absd(x: f64) -> f64 { if x < 0.0 { -x } else { x } }
fn maxd(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
fn mind(a: f64, b: f64) -> f64 { if a < b { a } else { b } }
fn clampd(v: f64, lo: f64, hi: f64) -> f64 { mind(maxd(v, lo), hi) }

// Float32 Vec3 helpers matching raw/math/vec.hpp
fn f3_sub(a: F3, b: F3) -> F3 { f3(a.x - b.x, a.y - b.y, a.z - b.z) }
fn f3_add(a: F3, b: F3) -> F3 { f3(a.x + b.x, a.y + b.y, a.z + b.z) }
fn f3_mul(a: F3, s: f32) -> F3 { f3(a.x * s, a.y * s, a.z * s) }
fn f3_dot(a: F3, b: F3) -> f32 { a.x * b.x + a.y * b.y + a.z * b.z }
fn f3_cross(a: F3, b: F3) -> F3 {
    f3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x)
}
fn f3_norm(v: F3) -> F3 {
    let l: f32 = sqrt(f3_dot(v, v) as f64) as f32;
    if l > 0.0 { f3_mul(v, (1.0 as f32) / l) } else { v }
}

pub fn prog_new() -> SdfProg { SdfProg { nodes: Vec::new(), fractal: false } }

fn push_pad(nodes: &mut Vec<f32>, count: i32) {
    let mut k: i32 = 0;
    while k < count { nodes.push(0.0 as f32); k = k + 1; }
}

pub fn prog_sphere(p: &mut SdfProg, r: f32, m: i32) {
    p.nodes.push(1.0 as f32); p.nodes.push(m as f32); p.nodes.push(r);
    push_pad(&mut p.nodes, 13);
}

pub fn prog_box(p: &mut SdfProg, h: F3, m: i32) {
    p.nodes.push(2.0 as f32); p.nodes.push(m as f32);
    p.nodes.push(h.x); p.nodes.push(h.y); p.nodes.push(h.z);
    push_pad(&mut p.nodes, 11);
}

pub fn prog_round_box(p: &mut SdfProg, h: F3, r: f32, m: i32) {
    p.nodes.push(3.0 as f32); p.nodes.push(m as f32);
    p.nodes.push(h.x); p.nodes.push(h.y); p.nodes.push(h.z); p.nodes.push(r);
    push_pad(&mut p.nodes, 10);
}

pub fn prog_torus(p: &mut SdfProg, big_r: f32, r: f32, m: i32) {
    p.nodes.push(4.0 as f32); p.nodes.push(m as f32);
    p.nodes.push(big_r); p.nodes.push(r);
    push_pad(&mut p.nodes, 12);
}

pub fn prog_capsule(p: &mut SdfProg, a: F3, b: F3, r: f32, m: i32) {
    p.nodes.push(5.0 as f32); p.nodes.push(m as f32);
    p.nodes.push(a.x); p.nodes.push(a.y); p.nodes.push(a.z);
    p.nodes.push(b.x); p.nodes.push(b.y); p.nodes.push(b.z);
    p.nodes.push(r);
    push_pad(&mut p.nodes, 7);
}

pub fn prog_cylinder(p: &mut SdfProg, r: f32, h: f32, m: i32) {
    p.nodes.push(6.0 as f32); p.nodes.push(m as f32);
    p.nodes.push(r); p.nodes.push(h);
    push_pad(&mut p.nodes, 12);
}

pub fn prog_plane(p: &mut SdfProg, n: F3, h: f32, m: i32) {
    p.nodes.push(7.0 as f32); p.nodes.push(m as f32);
    p.nodes.push(n.x); p.nodes.push(n.y); p.nodes.push(n.z); p.nodes.push(h);
    push_pad(&mut p.nodes, 10);
}

pub fn prog_bulb(p: &mut SdfProg, it: i32, pw: f32, m: i32) {
    p.nodes.push(8.0 as f32); p.nodes.push(m as f32);
    p.nodes.push(it as f32); p.nodes.push(pw);
    push_pad(&mut p.nodes, 12);
    p.fractal = true;
}

pub fn prog_mandelbox(p: &mut SdfProg, it: i32, sc: f32, m: i32) {
    p.nodes.push(9.0 as f32); p.nodes.push(m as f32);
    p.nodes.push(it as f32); p.nodes.push(sc);
    push_pad(&mut p.nodes, 12);
    p.fractal = true;
}

pub fn prog_op(p: &mut SdfProg, o: i32, k: f32) {
    p.nodes.push(o as f32); p.nodes.push(0.0 as f32); p.nodes.push(k);
    push_pad(&mut p.nodes, 13);
    if o == 21 { p.fractal = true; }
}

pub fn prog_push_rot(
    p: &mut SdfProg,
    t: F3,
    r0: f32, r1: f32, r2: f32,
    r3: f32, r4: f32, r5: f32,
    r6: f32, r7: f32, r8: f32,
    s: f32,
) {
    p.nodes.push(30.0 as f32); p.nodes.push(0.0 as f32);
    p.nodes.push(r0); p.nodes.push(r1); p.nodes.push(r2);
    p.nodes.push(r3); p.nodes.push(r4); p.nodes.push(r5);
    p.nodes.push(r6); p.nodes.push(r7); p.nodes.push(r8);
    p.nodes.push(t.x); p.nodes.push(t.y); p.nodes.push(t.z);
    p.nodes.push(s); p.nodes.push(0.0 as f32);
}

pub fn prog_push(p: &mut SdfProg, t: F3, s: f32) {
    prog_push_rot(
        p, t,
        1.0 as f32, 0.0 as f32, 0.0 as f32,
        0.0 as f32, 1.0 as f32, 0.0 as f32,
        0.0 as f32, 0.0 as f32, 1.0 as f32,
        s,
    );
}

pub fn prog_pop(p: &mut SdfProg) {
    p.nodes.push(31.0 as f32);
    push_pad(&mut p.nodes, 15);
}

pub fn prog_repeat(p: &mut SdfProg, per: F3) {
    p.nodes.push(32.0 as f32); p.nodes.push(0.0 as f32);
    p.nodes.push(per.x); p.nodes.push(per.y); p.nodes.push(per.z);
    push_pad(&mut p.nodes, 11);
}

fn eval_bulb(p: S3, iters: i32, power: f64) -> f64 {
    let mut z: S3 = p;
    let mut dr: f64 = 1.0;
    let mut r: f64 = len3(z);
    let mut i: i32 = 0;
    while i < iters {
        r = len3(z);
        if r > 2.0 { break; }
        let theta: f64 = acos(clampd(z.z / r, -1.0, 1.0)) * power;
        let phi: f64 = atan2(z.y, z.x) * power;
        dr = pow(r, power - 1.0) * power * dr + 1.0;
        let zr: f64 = pow(r, power);
        let dir: S3 = s3(sin(theta) * cos(phi), sin(phi) * sin(theta), cos(theta));
        z = add3(mul3(dir, zr), p);
        i = i + 1;
    }
    r = len3(z);
    0.5 * ln(r) * r / dr
}

fn eval_mandelbox(p: S3, iters: i32, scale: f64) -> f64 {
    let fold: f64 = 1.0;
    let min_r2: f64 = 0.25;
    let fixed_r2: f64 = 1.0;
    let mut z: S3 = p;
    let mut dr: f64 = 1.0;
    let mut i: i32 = 0;
    while i < iters {
        z = s3(
            clampd(z.x, -fold, fold) * 2.0 - z.x,
            clampd(z.y, -fold, fold) * 2.0 - z.y,
            clampd(z.z, -fold, fold) * 2.0 - z.z,
        );
        let r2: f64 = dot3(z, z);
        if r2 < min_r2 {
            let k: f64 = fixed_r2 / min_r2;
            z = mul3(z, k);
            dr = dr * k;
        } else if r2 < fixed_r2 {
            let k: f64 = fixed_r2 / r2;
            z = mul3(z, k);
            dr = dr * k;
        }
        z = add3(mul3(z, scale), p);
        dr = dr * absd(scale) + 1.0;
        i = i + 1;
    }
    len3(z) / absd(dr)
}

fn eval_primitive(nodes: &Vec<f32>, base: i32, p: S3) -> f64 {
    let op: i32 = nodes[base] as i32;
    if op == 1 { return len3(p) - (nodes[base + 2] as f64); }
    if op == 2 || op == 3 {
        let r: f64 = if op == 3 { nodes[base + 5] as f64 } else { 0.0 };
        let q: S3 = s3(
            absd(p.x) - ((nodes[base + 2] as f64) - r),
            absd(p.y) - ((nodes[base + 3] as f64) - r),
            absd(p.z) - ((nodes[base + 4] as f64) - r),
        );
        let outside: f64 = len3(s3(maxd(q.x, 0.0), maxd(q.y, 0.0), maxd(q.z, 0.0)));
        return outside + mind(maxd(q.x, maxd(q.y, q.z)), 0.0) - r;
    }
    if op == 4 {
        let a: f64 = sqrt(p.x * p.x + p.z * p.z) - (nodes[base + 2] as f64);
        return sqrt(a * a + p.y * p.y) - (nodes[base + 3] as f64);
    }
    if op == 5 {
        let a: S3 = s3(nodes[base + 2] as f64, nodes[base + 3] as f64, nodes[base + 4] as f64);
        let b: S3 = s3(nodes[base + 5] as f64, nodes[base + 6] as f64, nodes[base + 7] as f64);
        let pa: S3 = sub3(p, a);
        let ba: S3 = sub3(b, a);
        let h: f64 = clampd(dot3(pa, ba) / dot3(ba, ba), 0.0, 1.0);
        return len3(sub3(pa, mul3(ba, h))) - (nodes[base + 8] as f64);
    }
    if op == 6 {
        let dx: f64 = sqrt(p.x * p.x + p.z * p.z) - (nodes[base + 2] as f64);
        let dy: f64 = absd(p.y) - (nodes[base + 3] as f64);
        let ox: f64 = maxd(dx, 0.0);
        let oy: f64 = maxd(dy, 0.0);
        return mind(maxd(dx, dy), 0.0) + sqrt(ox * ox + oy * oy);
    }
    if op == 7 {
        return p.x * (nodes[base + 2] as f64)
            + p.y * (nodes[base + 3] as f64)
            + p.z * (nodes[base + 4] as f64)
            + (nodes[base + 5] as f64);
    }
    if op == 8 { return eval_bulb(p, nodes[base + 2] as i32, nodes[base + 3] as f64); }
    eval_mandelbox(p, nodes[base + 2] as i32, nodes[base + 3] as f64)
}

fn rep_axis(v: f64, per: f64) -> f64 {
    if per > 0.0 { v - per * floor(v / per + 0.5) } else { v }
}

pub fn eval_sdf(prog: &SdfProg, q: S3) -> SdfSample {
    let mut st_d: Vec<f64> = Vec::new();
    let mut st_m: Vec<i32> = Vec::new();
    let mut fp_x: Vec<f64> = Vec::new();
    let mut fp_y: Vec<f64> = Vec::new();
    let mut fp_z: Vec<f64> = Vec::new();
    let mut fs: Vec<f64> = Vec::new();
    let mut k0: i32 = 0;
    while k0 < 16 {
        st_d.push(0.0); st_m.push(-1);
        fp_x.push(0.0); fp_y.push(0.0); fp_z.push(0.0); fs.push(1.0);
        k0 = k0 + 1;
    }
    let mut sp: i32 = 0;
    let mut fsp: i32 = 0;
    let mut p: S3 = q;
    let mut scale: f64 = 1.0;
    let total: i32 = prog.nodes.len() as i32;
    let mut i: i32 = 0;
    while i + 16 <= total {
        let o: i32 = prog.nodes[i] as i32;
        if o < 20 {
            st_d[sp] = eval_primitive(&prog.nodes, i, p) * scale;
            st_m[sp] = prog.nodes[i + 1] as i32;
            sp = sp + 1;
            i = i + 16;
            continue;
        }
        if o == 30 {
            fp_x[fsp] = p.x; fp_y[fsp] = p.y; fp_z[fsp] = p.z;
            fs[fsp] = scale;
            fsp = fsp + 1;
            let d: S3 = sub3(p, s3(prog.nodes[i + 11] as f64, prog.nodes[i + 12] as f64, prog.nodes[i + 13] as f64));
            let rx: f64 = (prog.nodes[i + 2] as f64) * d.x
                + (prog.nodes[i + 3] as f64) * d.y
                + (prog.nodes[i + 4] as f64) * d.z;
            let ry: f64 = (prog.nodes[i + 5] as f64) * d.x
                + (prog.nodes[i + 6] as f64) * d.y
                + (prog.nodes[i + 7] as f64) * d.z;
            let rz: f64 = (prog.nodes[i + 8] as f64) * d.x
                + (prog.nodes[i + 9] as f64) * d.y
                + (prog.nodes[i + 10] as f64) * d.z;
            let sc: f64 = prog.nodes[i + 14] as f64;
            p = mul3(s3(rx, ry, rz), 1.0 / sc);
            scale = scale * sc;
            i = i + 16;
            continue;
        }
        if o == 31 {
            fsp = fsp - 1;
            p = s3(fp_x[fsp], fp_y[fsp], fp_z[fsp]);
            scale = fs[fsp];
            i = i + 16;
            continue;
        }
        if o == 32 {
            p = s3(
                rep_axis(p.x, prog.nodes[i + 2] as f64),
                rep_axis(p.y, prog.nodes[i + 3] as f64),
                rep_axis(p.z, prog.nodes[i + 4] as f64),
            );
            i = i + 16;
            continue;
        }
        sp = sp - 1;
        let bd: f64 = st_d[sp];
        let bm: i32 = st_m[sp];
        sp = sp - 1;
        let ad: f64 = st_d[sp];
        let am: i32 = st_m[sp];
        let mut rd: f64 = ad;
        let mut rm: i32 = am;
        if o == 20 {
            if bd < ad { rd = bd; rm = bm; }
        } else if o == 22 {
            rd = maxd(ad, -bd);
            rm = am;
        } else if o == 23 {
            if ad < bd { rd = bd; rm = bm; }
        } else {
            let k: f64 = prog.nodes[i + 2] as f64;
            let h: f64 = clampd(0.5 + 0.5 * (bd - ad) / k, 0.0, 1.0);
            rd = bd + (ad - bd) * h - k * h * (1.0 - h);
            rm = if h > 0.5 { am } else { bm };
        }
        st_d[sp] = rd;
        st_m[sp] = rm;
        sp = sp + 1;
        i = i + 16;
    }
    if sp > 0 { SdfSample { d: st_d[sp - 1], mat: st_m[sp - 1] } } else { SdfSample { d: 1.0e30, mat: -1 } }
}

pub fn sdf_normal(prog: &SdfProg, x: S3, t: f64) -> S3 {
    let e: f64 = 1.0e-4 * (1.0 + t);
    let a: f64 = eval_sdf(prog, s3(x.x + e, x.y - e, x.z - e)).d;
    let b: f64 = eval_sdf(prog, s3(x.x - e, x.y - e, x.z + e)).d;
    let c: f64 = eval_sdf(prog, s3(x.x - e, x.y + e, x.z - e)).d;
    let d: f64 = eval_sdf(prog, s3(x.x + e, x.y + e, x.z + e)).d;
    unit3(s3(a - b - c + d, -a - b + c + d, -a + b - c + d))
}

fn refine_hit(prog: &SdfProg, o: S3, d: S3, t: f64, e: f64) -> f64 {
    let mut t2: f64 = t;
    let mut step: f64 = e;
    let mut inside: bool = false;
    let mut k: i32 = 0;
    while k < 64 && !inside {
        t2 = t2 + step;
        inside = eval_sdf(prog, at3(o, d, t2)).d < 0.0;
        k = k + 1;
    }
    k = 0;
    while k < 16 && !inside {
        t2 = t2 + step;
        step = step * 2.0;
        inside = eval_sdf(prog, at3(o, d, t2)).d < 0.0;
        k = k + 1;
    }
    if !inside { return t; }
    let mut a: f64 = t;
    let mut b: f64 = t2;
    let mut i: i32 = 0;
    while i < 40 {
        let m: f64 = 0.5 * (a + b);
        if eval_sdf(prog, at3(o, d, m)).d > 0.0 { a = m; } else { b = m; }
        i = i + 1;
    }
    0.5 * (a + b)
}

pub fn march_sdf(prog: &SdfProg, o: S3, d: S3, t_max: f64, eps: f64, do_refine: bool) -> SdfHit {
    let step: f64 = if prog.fractal { 0.6 } else { 1.0 };
    let mut t: f64 = 0.0;
    let mut closest: f64 = 1.0e30;
    let mut i: i32 = 0;
    while i < 512 {
        let steps: i32 = i + 1;
        let s: SdfSample = eval_sdf(prog, at3(o, d, t));
        closest = mind(closest, s.d / (1.0 + t));
        if s.d < eps * (1.0 + t) {
            let ht: f64 = if do_refine { refine_hit(prog, o, d, t, eps * (1.0 + t)) } else { t };
            let hn: S3 = sdf_normal(prog, at3(o, d, ht), ht);
            return SdfHit { hit: true, t: ht, mat: s.mat, n: hn, closest: closest, steps: steps };
        }
        t = t + s.d * step;
        if t > t_max {
            return SdfHit { hit: false, t: 0.0, mat: -1, n: s3(0.0, 0.0, 0.0), closest: closest, steps: steps };
        }
        i = i + 1;
    }
    SdfHit { hit: false, t: 0.0, mat: -1, n: s3(0.0, 0.0, 0.0), closest: closest, steps: 512 }
}

pub fn soft_shadow(prog: &SdfProg, x: S3, l: S3, k: f64) -> f64 {
    let mut res: f64 = 1.0;
    let mut t: f64 = 0.02;
    let mut i: i32 = 0;
    while i < 128 {
        let h: f64 = eval_sdf(prog, at3(x, l, t)).d;
        res = mind(res, k * h / t);
        if res < 1.0e-3 { return 0.0; }
        t = t + clampd(h, 0.01, 0.5);
        if t > 30.0 { break; }
        i = i + 1;
    }
    clampd(res, 0.0, 1.0)
}

pub fn ambient_occlusion(prog: &SdfProg, x: S3, n: S3) -> f64 {
    let mut occ: f64 = 0.0;
    let mut sca: f64 = 1.0;
    let mut i: i32 = 0;
    while i < 5 {
        let h: f64 = 0.02 + 0.12 * (i as f64);
        occ = occ + (h - eval_sdf(prog, at3(x, n, h)).d) * sca;
        sca = sca * 0.85;
        i = i + 1;
    }
    clampd(1.0 - 3.0 * occ, 0.0, 1.0)
}

pub fn hard_shadow(prog: &SdfProg, x: S3, l: S3) -> bool {
    march_sdf(prog, at3(x, l, 0.02), l, 30.0, 1.0e-4, true).hit
}

pub fn fog_homogeneous(sigma: f64, t: f64) -> f64 { exp(-sigma * t) }

pub fn fog_height(a: f64, b: f64, o: S3, d: S3, t: f64) -> f64 {
    let base: f64 = a * exp(-b * o.y);
    let k: f64 = b * d.y;
    let optical: f64 = if absd(k) < 1.0e-9 { base * t } else { base * (1.0 - exp(-k * t)) / k };
    exp(-optical)
}

pub fn fog_height_march(a: f64, b: f64, o: S3, d: S3, t: f64, n: i32) -> f64 {
    let dt: f64 = t / (n as f64);
    let mut sum: f64 = 0.0;
    let mut i: i32 = 0;
    while i <= n {
        let w: f64 = if i == 0 || i == n { 1.0 } else if (i % 2) != 0 { 4.0 } else { 2.0 };
        sum = sum + w * a * exp(-b * (o.y + d.y * (i as f64) * dt));
        i = i + 1;
    }
    exp(-sum * dt / 3.0)
}

pub fn henyey_greenstein(c: f64, g: f64) -> f64 {
    (1.0 - g * g) / (4.0 * 3.14159265358979 * pow(1.0 + g * g - 2.0 * g * c, 1.5))
}

pub fn god_rays(sc: &SdfScene, o: S3, d: S3, t_end: f64) -> (f64, i32) {
    let l: S3 = unit3(d3_of(sc.sun_dir));
    let dt: f64 = t_end / 64.0;
    let phase: f64 = henyey_greenstein(dot3(d, l), 0.6);
    let mut rad: f64 = 0.0;
    let mut vis: i32 = 0;
    let fa: f64 = sc.fog_a as f64;
    let fb: f64 = sc.fog_b as f64;
    let mut i: i32 = 0;
    while i < 64 {
        let t: f64 = ((i as f64) + 0.5) * dt;
        let x: S3 = at3(o, d, t);
        if !hard_shadow(&sc.prog, x, l) {
            vis = vis + 1;
            rad = rad + fa * exp(-fb * x.y) * fog_height(fa, fb, o, d, t) * phase * dt;
        }
        i = i + 1;
    }
    (rad, vis)
}

pub fn camera_ray(sc: &SdfScene, x: i32, y: i32, w: i32, h: i32) -> S3 {
    let f: F3 = f3_norm(f3_sub(sc.target, sc.eye));
    let sd: F3 = f3_norm(f3_cross(f, sc.up));
    let u: F3 = f3_cross(sd, f);
    let th: f32 = tan((sc.fovy * (0.5 as f32)) as f64) as f32;
    let aspect: f32 = (w as f32) / (h as f32);
    let nx: f32 = (((x as f32) + (0.5 as f32)) / (w as f32)) * (2.0 as f32) - (1.0 as f32);
    let ny: f32 = (1.0 as f32) - (((y as f32) + (0.5 as f32)) / (h as f32)) * (2.0 as f32);
    let dir: F3 = f3_norm(f3_add(f3_add(f, f3_mul(sd, nx * th * aspect)), f3_mul(u, ny * th)));
    d3_of(dir)
}

fn fnv_u32(h0: u64, b: u32) -> u64 {
    let mut h: u64 = h0;
    let mut k: u32 = 0;
    while k < 4 {
        h = (h ^ (((b >> (8 * k)) & 255) as u64)).wrapping_mul(1099511628211);
        k = k + 1;
    }
    h
}

fn fnv_u64(h0: u64, v: u64) -> u64 {
    let mut h: u64 = h0;
    let mut k: u32 = 0;
    while k < 8 {
        h = (h ^ ((v >> (8 * k)) & 255)).wrapping_mul(1099511628211);
        k = k + 1;
    }
    h
}

fn make_csg_program() -> SdfProg {
    let mut p: SdfProg = prog_new();
    prog_plane(&mut p, f3(0.0 as f32, 1.0 as f32, 0.0 as f32), 1.2 as f32, 1);
    prog_push(&mut p, f3(-0.9 as f32, 0.1 as f32, -4.0 as f32), 1.0 as f32);
    prog_sphere(&mut p, 0.85 as f32, 2);
    prog_pop(&mut p);
    prog_op(&mut p, 21, 0.25 as f32);
    let c1: f32 = cos(0.5) as f32;
    let s1: f32 = sin(0.5) as f32;
    prog_push_rot(
        &mut p, f3(0.85 as f32, -0.1 as f32, -4.2 as f32),
        c1, 0.0 as f32, -s1, 0.0 as f32, 1.0 as f32, 0.0 as f32, s1, 0.0 as f32, c1,
        0.9 as f32,
    );
    prog_round_box(&mut p, f3(0.65 as f32, 0.55 as f32, 0.60 as f32), 0.12 as f32, 3);
    prog_sphere(&mut p, 0.45 as f32, 4);
    prog_op(&mut p, 22, 0.0 as f32);
    prog_pop(&mut p);
    prog_op(&mut p, 20, 0.0 as f32);
    let c2: f32 = cos(0.8) as f32;
    let s2: f32 = sin(0.8) as f32;
    prog_push_rot(
        &mut p, f3(0.0 as f32, 0.65 as f32, -4.8 as f32),
        1.0 as f32, 0.0 as f32, 0.0 as f32, 0.0 as f32, c2, s2, 0.0 as f32, -s2, c2,
        1.0 as f32,
    );
    prog_torus(&mut p, 0.75 as f32, 0.22 as f32, 5);
    prog_box(&mut p, f3(0.9 as f32, 0.9 as f32, 0.45 as f32), 6);
    prog_op(&mut p, 23, 0.0 as f32);
    prog_pop(&mut p);
    prog_op(&mut p, 20, 0.0 as f32);
    prog_push(&mut p, f3(0.0 as f32, -0.35 as f32, -3.5 as f32), 1.0 as f32);
    prog_capsule(
        &mut p,
        f3(-0.5 as f32, 0.0 as f32, 0.0 as f32),
        f3(0.5 as f32, 0.35 as f32, -0.2 as f32),
        0.16 as f32,
        7,
    );
    prog_pop(&mut p);
    prog_op(&mut p, 20, 0.0 as f32);
    prog_push(&mut p, f3(0.0 as f32, 0.0 as f32, -7.5 as f32), 1.0 as f32);
    prog_repeat(&mut p, f3(2.4 as f32, 0.0 as f32, 0.0 as f32));
    prog_cylinder(&mut p, 0.28 as f32, 1.4 as f32, 8);
    prog_pop(&mut p);
    prog_op(&mut p, 20, 0.0 as f32);
    p
}

fn make_fractal_program() -> SdfProg {
    let mut p: SdfProg = prog_new();
    prog_push(&mut p, f3(-0.85 as f32, 0.0 as f32, 0.0 as f32), 0.8 as f32);
    prog_bulb(&mut p, 6, 8.0 as f32, 10);
    prog_pop(&mut p);
    prog_push(&mut p, f3(0.95 as f32, 0.0 as f32, 0.0 as f32), 0.5 as f32);
    prog_mandelbox(&mut p, 8, 2.0 as f32, 11);
    prog_pop(&mut p);
    prog_op(&mut p, 20, 0.0 as f32);
    p
}

pub fn run_sdf_parity() -> (u64, u64, u64, u64, u64, u64, i32, i32, i32) {
    let csg: SdfProg = make_csg_program();
    let frac: SdfProg = make_fractal_program();

    let mut h_csg: u64 = kit::fnv_start();
    let mut i: i32 = 0;
    while i < 1024 {
        let x: f64 = -2.2 + 4.4 * ((i % 16) as f64) / 15.0;
        let y: f64 = -1.4 + 2.8 * (((i / 16) % 8) as f64) / 7.0;
        let z: f64 = -8.0 + 5.5 * ((i / 128) as f64) / 7.0;
        let s: SdfSample = eval_sdf(&csg, s3(x, y, z));
        h_csg = kit::fnv_f32(h_csg, s.d);
        h_csg = fnv_u32(h_csg, (s.mat + 100) as u32);
        i = i + 1;
    }

    let mut h_frac: u64 = kit::fnv_start();
    i = 0;
    while i < 512 {
        let x: f64 = -1.8 + 3.6 * ((i % 8) as f64) / 7.0;
        let y: f64 = -1.2 + 2.4 * (((i / 8) % 8) as f64) / 7.0;
        let z: f64 = -1.2 + 2.4 * ((i / 64) as f64) / 7.0;
        let s: SdfSample = eval_sdf(&frac, s3(x, y, z));
        h_frac = kit::fnv_f32(h_frac, s.d);
        h_frac = fnv_u32(h_frac, (s.mat + 100) as u32);
        i = i + 1;
    }

    let sc: SdfScene = SdfScene {
        prog: csg,
        eye: f3(0.25 as f32, 0.45 as f32, 0.4 as f32),
        target: f3(0.0 as f32, -0.1 as f32, -4.4 as f32),
        up: f3(0.0 as f32, 1.0 as f32, 0.0 as f32),
        fovy: 0.75 as f32,
        sun_dir: f3(0.5 as f32, 0.8 as f32, 0.3 as f32),
        fog_a: 0.08 as f32,
        fog_b: 0.35 as f32,
    };
    let o: S3 = d3_of(sc.eye);
    let sun_l: S3 = unit3(d3_of(sc.sun_dir));

    let mut h_march: u64 = kit::fnv_start();
    let mut h_ctrl: u64 = kit::fnv_start();
    let mut hits: i32 = 0;
    let mut total_steps: i32 = 0;
    let mut py: i32 = 0;
    while py < 24 {
        let mut px: i32 = 0;
        while px < 24 {
            let d: S3 = camera_ray(&sc, px, py, 24, 24);
            let mh: SdfHit = march_sdf(&sc.prog, o, d, 20.0, 1.0e-4, true);
            let mc: SdfHit = march_sdf(&sc.prog, o, d, 20.0, 1.0e-2, false);
            total_steps = total_steps + mh.steps;
            h_march = fnv_u32(h_march, if mh.hit { 1 } else { 0 });
            h_march = fnv_u32(h_march, (mh.mat + 100) as u32);
            h_march = fnv_u32(h_march, mh.steps as u32);
            h_march = kit::fnv_f32(h_march, mh.t);
            h_march = kit::fnv_f32(h_march, mh.closest);
            if mh.hit {
                hits = hits + 1;
                let hp: S3 = at3(o, d, mh.t);
                let sh: f64 = soft_shadow(&sc.prog, hp, sun_l, 12.0);
                let ao: f64 = ambient_occlusion(&sc.prog, hp, mh.n);
                h_march = kit::fnv_f32(h_march, mh.n.x);
                h_march = kit::fnv_f32(h_march, mh.n.y);
                h_march = kit::fnv_f32(h_march, mh.n.z);
                h_march = kit::fnv_f32(h_march, sh);
                h_march = kit::fnv_f32(h_march, ao);
            }
            h_ctrl = fnv_u32(h_ctrl, if mc.hit { 1 } else { 0 });
            h_ctrl = kit::fnv_f32(h_ctrl, mc.t);
            px = px + 1;
        }
        py = py + 1;
    }

    let mut h_fog: u64 = kit::fnv_start();
    let mut total_vis: i32 = 0;
    i = 0;
    while i < 64 {
        let px: i32 = (i % 8) * 3 + 1;
        let py2: i32 = (i / 8) * 3 + 1;
        let d: S3 = camera_ray(&sc, px, py2, 24, 24);
        let t_end: f64 = 4.0 + 0.25 * ((i % 16) as f64);
        let fh: f64 = fog_homogeneous(0.08, t_end);
        let fht: f64 = fog_height(sc.fog_a as f64, sc.fog_b as f64, o, d, t_end);
        let fhm: f64 = fog_height_march(sc.fog_a as f64, sc.fog_b as f64, o, d, t_end, 32);
        let hg: f64 = henyey_greenstein(dot3(d, sun_l), 0.6);
        let (gr, vis) = god_rays(&sc, o, d, t_end);
        total_vis = total_vis + vis;
        h_fog = kit::fnv_f32(h_fog, fh);
        h_fog = kit::fnv_f32(h_fog, fht);
        h_fog = kit::fnv_f32(h_fog, fhm);
        h_fog = kit::fnv_f32(h_fog, hg);
        h_fog = kit::fnv_f32(h_fog, gr);
        h_fog = fnv_u32(h_fog, vis as u32);
        i = i + 1;
    }

    let mut h_all: u64 = kit::fnv_start();
    h_all = fnv_u64(h_all, h_csg);
    h_all = fnv_u64(h_all, h_frac);
    h_all = fnv_u64(h_all, h_march);
    h_all = fnv_u64(h_all, h_fog);

    (h_csg, h_frac, h_march, h_fog, h_all, h_ctrl, hits, total_steps, total_vis)
}
