// Renderer module #15: src/renderer/colour_math.cpp + raw/renderer/colour.hpp
// Reproduces exact C++23 FNV-1a pins across primary matrices (Rec709, P3D65, Rec2020, AP0, AP1)
// with Bradford adaptation, sRGB / BT.1886 / SMPTE ST 2084 PQ transfer functions, Khronos PBR
// Neutral, and Filament AgX over the canonical 33x33x33 RGB cube (35,937 samples / 107,811 ch).

struct Mat3 {
    m0: f64, m1: f64, m2: f64,
    m3: f64, m4: f64, m5: f64,
    m6: f64, m7: f64, m8: f64,
}

struct Prim {
    rx: f64, ry: f64,
    gx: f64, gy: f64,
    bx: f64, by: f64,
    wx: f64, wy: f64,
}

struct C3 { r: f64, g: f64, b: f64 }

fn m15_max_f(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
fn m15_min_f(a: f64, b: f64) -> f64 { if a < b { a } else { b } }
fn m15_clamp_f(v: f64, lo: f64, hi: f64) -> f64 { if v < lo { lo } else if v > hi { hi } else { v } }

fn mat_at(m: Mat3, i: i32) -> f64 {
    if i == 0 { return m.m0; }
    if i == 1 { return m.m1; }
    if i == 2 { return m.m2; }
    if i == 3 { return m.m3; }
    if i == 4 { return m.m4; }
    if i == 5 { return m.m5; }
    if i == 6 { return m.m6; }
    if i == 7 { return m.m7; }
    m.m8
}

fn mat_mul(a: Mat3, b: Mat3) -> Mat3 {
    Mat3 {
        m0: a.m0 * b.m0 + a.m1 * b.m3 + a.m2 * b.m6,
        m1: a.m0 * b.m1 + a.m1 * b.m4 + a.m2 * b.m7,
        m2: a.m0 * b.m2 + a.m1 * b.m5 + a.m2 * b.m8,
        m3: a.m3 * b.m0 + a.m4 * b.m3 + a.m5 * b.m6,
        m4: a.m3 * b.m1 + a.m4 * b.m4 + a.m5 * b.m7,
        m5: a.m3 * b.m2 + a.m4 * b.m5 + a.m5 * b.m8,
        m6: a.m6 * b.m0 + a.m7 * b.m3 + a.m8 * b.m6,
        m7: a.m6 * b.m1 + a.m7 * b.m4 + a.m8 * b.m7,
        m8: a.m6 * b.m2 + a.m7 * b.m5 + a.m8 * b.m8,
    }
}

fn mat_inv(m: Mat3) -> Mat3 {
    let a: f64 = m.m0;
    let b: f64 = m.m1;
    let c: f64 = m.m2;
    let d: f64 = m.m3;
    let e: f64 = m.m4;
    let f: f64 = m.m5;
    let g: f64 = m.m6;
    let h: f64 = m.m7;
    let k: f64 = m.m8;
    let ca: f64 = e * k - f * h;
    let cb: f64 = -(d * k - f * g);
    let cc: f64 = d * h - e * g;
    let det: f64 = a * ca + b * cb + c * cc;
    Mat3 {
        m0: ca / det,
        m1: -(b * k - c * h) / det,
        m2: (b * f - c * e) / det,
        m3: cb / det,
        m4: (a * k - c * g) / det,
        m5: -(a * f - c * d) / det,
        m6: cc / det,
        m7: -(a * h - b * g) / det,
        m8: (a * e - b * d) / det,
    }
}

fn rgb_to_xyz(p: Prim) -> Mat3 {
    let xyz: Mat3 = Mat3 {
        m0: p.rx, m1: p.gx, m2: p.bx,
        m3: p.ry, m4: p.gy, m5: p.by,
        m6: 1.0 - p.rx - p.ry, m7: 1.0 - p.gx - p.gy, m8: 1.0 - p.bx - p.by,
    };
    let inv: Mat3 = mat_inv(xyz);
    let w0: f64 = p.wx / p.wy;
    let w1: f64 = 1.0;
    let w2: f64 = (1.0 - p.wx - p.wy) / p.wy;
    let g0: f64 = w0 * inv.m0 + w1 * inv.m1 + w2 * inv.m2;
    let g1: f64 = w0 * inv.m3 + w1 * inv.m4 + w2 * inv.m5;
    let g2: f64 = w0 * inv.m6 + w1 * inv.m7 + w2 * inv.m8;
    Mat3 {
        m0: g0 * xyz.m0, m1: g1 * xyz.m1, m2: g2 * xyz.m2,
        m3: g0 * xyz.m3, m4: g1 * xyz.m4, m5: g2 * xyz.m5,
        m6: g0 * xyz.m6, m7: g1 * xyz.m7, m8: g2 * xyz.m8,
    }
}

fn bradford(sw: C3, dw: C3) -> Mat3 {
    let bm: Mat3 = Mat3 {
        m0: 0.8951, m1: 0.2664, m2: -0.1614,
        m3: -0.7502, m4: 1.7135, m5: 0.0367,
        m6: 0.0389, m7: -0.0685, m8: 1.0296,
    };
    let s0: f64 = bm.m0 * sw.r + bm.m1 * sw.g + bm.m2 * sw.b;
    let s1: f64 = bm.m3 * sw.r + bm.m4 * sw.g + bm.m5 * sw.b;
    let s2: f64 = bm.m6 * sw.r + bm.m7 * sw.g + bm.m8 * sw.b;
    let d0: f64 = bm.m0 * dw.r + bm.m1 * dw.g + bm.m2 * dw.b;
    let d1: f64 = bm.m3 * dw.r + bm.m4 * dw.g + bm.m5 * dw.b;
    let d2: f64 = bm.m6 * dw.r + bm.m7 * dw.g + bm.m8 * dw.b;
    let sc: Mat3 = Mat3 {
        m0: d0 / s0, m1: 0.0, m2: 0.0,
        m3: 0.0, m4: d1 / s1, m5: 0.0,
        m6: 0.0, m7: 0.0, m8: d2 / s2,
    };
    mat_mul(mat_inv(bm), mat_mul(sc, bm))
}

fn conversion(src: Prim, dst: Prim, adapt: bool) -> Mat3 {
    let s2x: Mat3 = rgb_to_xyz(src);
    let d2x: Mat3 = rgb_to_xyz(dst);
    let x2d: Mat3 = mat_inv(d2x);
    if !adapt || (src.wx == dst.wx && src.wy == dst.wy) {
        return mat_mul(x2d, s2x);
    }
    let sw: C3 = C3 {
        r: s2x.m0 + s2x.m1 + s2x.m2,
        g: s2x.m3 + s2x.m4 + s2x.m5,
        b: s2x.m6 + s2x.m7 + s2x.m8,
    };
    let dw: C3 = C3 {
        r: d2x.m0 + d2x.m1 + d2x.m2,
        g: d2x.m3 + d2x.m4 + d2x.m5,
        b: d2x.m6 + d2x.m7 + d2x.m8,
    };
    mat_mul(x2d, mat_mul(bradford(sw, dw), s2x))
}

fn prim_rec709() -> Prim {
    Prim { rx: 0.64, ry: 0.33, gx: 0.30, gy: 0.60, bx: 0.15, by: 0.06, wx: 0.3127, wy: 0.3290 }
}

fn prim_p3d65() -> Prim {
    Prim { rx: 0.680, ry: 0.320, gx: 0.265, gy: 0.690, bx: 0.150, by: 0.060, wx: 0.3127, wy: 0.3290 }
}

fn prim_rec2020() -> Prim {
    Prim { rx: 0.708, ry: 0.292, gx: 0.170, gy: 0.797, bx: 0.131, by: 0.046, wx: 0.3127, wy: 0.3290 }
}

fn prim_ap0() -> Prim {
    Prim {
        rx: 0.7347, ry: 0.2653, gx: 0.0, gy: 1.0,
        bx: 0.0001, by: -0.0770, wx: 0.32168, wy: 0.33767,
    }
}

fn prim_ap1() -> Prim {
    Prim {
        rx: 0.713, ry: 0.293, gx: 0.165, gy: 0.830,
        bx: 0.128, by: 0.044, wx: 0.32168, wy: 0.33767,
    }
}

pub fn srgb_encode(x0: f64) -> f64 {
    let x: f64 = m15_max_f(0.0, x0);
    if x <= 0.0031308 { return 12.92 * x; }
    1.055 * pow(x, 1.0 / 2.4) - 0.055
}

pub fn srgb_decode(v: f64) -> f64 {
    if v <= 0.04045 { return v / 12.92; }
    pow((v + 0.055) / 1.055, 2.4)
}

fn bt1886_encode(x: f64) -> f64 { pow(m15_max_f(0.0, x), 1.0 / 2.4) }
fn bt1886_decode(v: f64) -> f64 { pow(m15_max_f(0.0, v), 2.4) }

pub fn pq_encode(linear100: f64) -> f64 {
    let m1: f64 = 2610.0 / 16384.0;
    let m2: f64 = 2523.0 / 4096.0 * 128.0;
    let c1: f64 = 3424.0 / 4096.0;
    let c2: f64 = 2413.0 / 4096.0 * 32.0;
    let c3: f64 = 2392.0 / 4096.0 * 32.0;
    let y: f64 = m15_max_f(0.0, linear100) / 100.0;
    let p: f64 = pow(y, m1);
    pow((c1 + c2 * p) / (1.0 + c3 * p), m2)
}

fn pq_decode(v: f64) -> f64 {
    let m1: f64 = 2610.0 / 16384.0;
    let m2: f64 = 2523.0 / 4096.0 * 128.0;
    let c1: f64 = 3424.0 / 4096.0;
    let c2: f64 = 2413.0 / 4096.0 * 32.0;
    let c3: f64 = 2392.0 / 4096.0 * 32.0;
    let p: f64 = pow(m15_max_f(0.0, v), 1.0 / m2);
    100.0 * pow(m15_max_f(0.0, p - c1) / (c2 - c3 * p), 1.0 / m1)
}

fn pbr_neutral(r0: f64, g0: f64, b0: f64) -> C3 {
    let start: f64 = 0.8 - 0.04;
    let desat: f64 = 0.15;
    let x: f64 = m15_min_f(r0, m15_min_f(g0, b0));
    let off: f64 = if x < 0.08 { x - 6.25 * x * x } else { 0.04 };
    let r: f64 = r0 - off;
    let g: f64 = g0 - off;
    let b: f64 = b0 - off;
    let peak: f64 = m15_max_f(r, m15_max_f(g, b));
    if peak < start { return C3 { r: r, g: g, b: b }; }
    let d: f64 = 1.0 - start;
    let new_peak: f64 = 1.0 - d * d / (peak + d - start);
    let gg: f64 = 1.0 - 1.0 / (desat * (peak - new_peak) + 1.0);
    C3 {
        r: (r * new_peak / peak) * (1.0 - gg) + new_peak * gg,
        g: (g * new_peak / peak) * (1.0 - gg) + new_peak * gg,
        b: (b * new_peak / peak) * (1.0 - gg) + new_peak * gg,
    }
}

fn agx_poly(x0: f64) -> f64 {
    let min_ev: f64 = -12.47393;
    let max_ev: f64 = 4.026069;
    let lg2: f64 = log(m15_max_f(x0, 1e-10)) / log(2.0);
    let x: f64 = m15_clamp_f((lg2 - min_ev) / (max_ev - min_ev), 0.0, 1.0);
    let x2: f64 = x * x;
    let x4: f64 = x2 * x2;
    15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4
        - 6.868 * x2 * x + 0.4298 * x2 + 0.1191 * x - 0.00232
}

fn agx_one(r0: f64, g0: f64, b0: f64, pre: Mat3, outset: Mat3, from2020: Mat3) -> C3 {
    let v0: f64 = agx_poly(pre.m0 * r0 + pre.m1 * g0 + pre.m2 * b0);
    let v1: f64 = agx_poly(pre.m3 * r0 + pre.m4 * g0 + pre.m5 * b0);
    let v2: f64 = agx_poly(pre.m6 * r0 + pre.m7 * g0 + pre.m8 * b0);
    let o0: f64 = pow(m15_max_f(0.0, outset.m0 * v0 + outset.m1 * v1 + outset.m2 * v2), 2.2);
    let o1: f64 = pow(m15_max_f(0.0, outset.m3 * v0 + outset.m4 * v1 + outset.m5 * v2), 2.2);
    let o2: f64 = pow(m15_max_f(0.0, outset.m6 * v0 + outset.m7 * v1 + outset.m8 * v2), 2.2);
    C3 {
        r: m15_clamp_f(from2020.m0 * o0 + from2020.m1 * o1 + from2020.m2 * o2, 0.0, 1.0),
        g: m15_clamp_f(from2020.m3 * o0 + from2020.m4 * o1 + from2020.m5 * o2, 0.0, 1.0),
        b: m15_clamp_f(from2020.m6 * o0 + from2020.m7 * o1 + from2020.m8 * o2, 0.0, 1.0),
    }
}

fn m15_fnv_f32(h0: u64, v: f64) -> u64 {
    let b: u32 = (v as f32).to_bits();
    let mut h: u64 = h0;
    let mut k: u32 = 0;
    while k < 4 {
        h = h ^ (((b >> (8 * k)) & 255u32) as u64);
        h = h.wrapping_mul(1099511628211u64);
        k = k + 1;
    }
    h
}

fn fnv_mat(h0: u64, m: Mat3) -> u64 {
    let mut h: u64 = h0;
    let mut k: i32 = 0;
    while k < 9 {
        h = m15_fnv_f32(h, mat_at(m, k));
        k = k + 1;
    }
    h
}

pub fn colour_suite_hashes(eps: f64) -> (u64, u64, u64, u64, u64) {
    let mut h_mat: u64 = 1469598103934665603u64;
    h_mat = fnv_mat(h_mat, rgb_to_xyz(prim_rec709()));
    h_mat = fnv_mat(h_mat, rgb_to_xyz(prim_p3d65()));
    h_mat = fnv_mat(h_mat, rgb_to_xyz(prim_rec2020()));
    h_mat = fnv_mat(h_mat, rgb_to_xyz(prim_ap0()));
    h_mat = fnv_mat(h_mat, rgb_to_xyz(prim_ap1()));
    h_mat = fnv_mat(h_mat, conversion(prim_rec709(), prim_ap0(), true));
    h_mat = fnv_mat(h_mat, conversion(prim_rec709(), prim_p3d65(), false));

    let mut h_xfer: u64 = 1469598103934665603u64;
    let mut i: i32 = 0;
    while i <= 64 {
        let v: f64 = ((i as f64) / 64.0) + eps;
        h_xfer = m15_fnv_f32(h_xfer, srgb_encode(v));
        h_xfer = m15_fnv_f32(h_xfer, srgb_decode(v));
        h_xfer = m15_fnv_f32(h_xfer, bt1886_encode(v));
        h_xfer = m15_fnv_f32(h_xfer, bt1886_decode(v));
        h_xfer = m15_fnv_f32(h_xfer, pq_encode(v * 100.0));
        h_xfer = m15_fnv_f32(h_xfer, pq_decode(v));
        i = i + 1;
    }

    let axis: [f32; 33] = [
        0.0f32, 0.0009765625f32, 0.0014281736221164465f32, 0.0020886322017759085f32,
        0.003054519649595022f32, 0.004467081744223833f32, 0.006532882805913687f32,
        0.00955401360988617f32, 0.013972264714539051f32, 0.020433735102415085f32,
        0.029883312061429024f32, 0.04370284453034401f32, 0.06391321122646332f32,
        0.09346986562013626f32, 0.1366949826478958f32, 0.19990955293178558f32,
        0.2923576831817627f32, 0.42755845189094543f32, 0.6252827644348145f32,
        0.914444625377655f32, 1.337329387664795f32, 1.9557770490646362f32,
        2.8602256774902344f32, 4.182936668395996f32, 6.117334842681885f32,
        8.946294784545898f32, 13.083507537841797f32, 19.13397216796875f32,
        27.982473373413086f32, 40.9229621887207f32, 59.8477783203125f32,
        87.52437591552734f32, 128.0f32,
    ];
    let inset: Mat3 = Mat3 {
        m0: 0.856627153315983, m1: 0.0951212405381588, m2: 0.0482516061458583,
        m3: 0.137318972929847, m4: 0.761241990602591, m5: 0.101439036467562,
        m6: 0.11189821299995, m7: 0.0767994186031903, m8: 0.811302368396859,
    };
    let outset: Mat3 = Mat3 {
        m0: 1.1271005818144368, m1: -0.11060664309660323, m2: -0.016493938717834573,
        m3: -0.1413297634984383, m4: 1.157823702216272, m5: -0.016493938717834257,
        m6: -0.14132976349843826, m7: -0.11060664309660294, m8: 1.2519364065950405,
    };
    let to2020: Mat3 = conversion(prim_rec709(), prim_rec2020(), true);
    let from2020: Mat3 = conversion(prim_rec2020(), prim_rec709(), true);
    let pre: Mat3 = mat_mul(inset, to2020);

    let mut h_pbr: u64 = 1469598103934665603u64;
    let mut h_agx: u64 = 1469598103934665603u64;
    let mut bi: i32 = 0;
    while bi < 33 {
        let bv: f64 = (axis[bi as usize] as f64) + eps;
        let mut gi: i32 = 0;
        while gi < 33 {
            let gv: f64 = (axis[gi as usize] as f64) + eps;
            let mut ri: i32 = 0;
            while ri < 33 {
                let rv: f64 = (axis[ri as usize] as f64) + eps;
                let p: C3 = pbr_neutral(rv, gv, bv);
                let a: C3 = agx_one(rv, gv, bv, pre, outset, from2020);
                h_pbr = m15_fnv_f32(m15_fnv_f32(m15_fnv_f32(h_pbr, p.r), p.g), p.b);
                h_agx = m15_fnv_f32(m15_fnv_f32(m15_fnv_f32(h_agx, a.r), a.g), a.b);
                ri = ri + 1;
            }
            gi = gi + 1;
        }
        bi = bi + 1;
    }

    let mut h_all: u64 = 1469598103934665603u64;
    h_all = (h_all ^ h_mat).wrapping_mul(1099511628211u64);
    h_all = (h_all ^ h_xfer).wrapping_mul(1099511628211u64);
    h_all = (h_all ^ h_pbr).wrapping_mul(1099511628211u64);
    h_all = (h_all ^ h_agx).wrapping_mul(1099511628211u64);
    (h_mat, h_xfer, h_pbr, h_agx, h_all)
}
