//
// Superframe Renderer Module #35: Curvature-Directed Pen-and-Ink Engraving and Cross-Hatching
// Bit-exact 0-ULP port of native/src/renderer/style_hatch.cpp:
// 5-primitive still-life SDF sphere tracer, finite-difference 3x3 Hessian and tangent-plane
// Weingarten shape operator, principal curvature eigenvectors with umbilic fallback, octave
// crossfaded anti-aliased hatching lines, two-layer crosshatching, and grazing ink contours.


pub struct M35V3 {
    x: f64,
    y: f64,
    z: f64,
}

pub struct M35HatchPlan {
    freq: f64,
    width: f64,
    layers: i32,
    umb: f64,
    contour: f64,
    tone_floor: f64,
    ink0: f64,
    ink1: f64,
    ink2: f64,
    pap0: f64,
    pap1: f64,
    pap2: f64,
}

pub struct M35Curv {
    n: M35V3,
    dir: M35V3,
    other: M35V3,
    umbilic: bool,
}

fn m35_v(x: f64, y: f64, z: f64) -> M35V3 { M35V3 { x: x, y: y, z: z } }

fn m35_add(a: M35V3, b: M35V3) -> M35V3 { m35_v(a.x + b.x, a.y + b.y, a.z + b.z) }

fn m35_sub(a: M35V3, b: M35V3) -> M35V3 { m35_v(a.x - b.x, a.y - b.y, a.z - b.z) }

fn m35_mul(a: M35V3, s: f64) -> M35V3 { m35_v(a.x * s, a.y * s, a.z * s) }

fn m35_dot(a: M35V3, b: M35V3) -> f64 { a.x * b.x + a.y * b.y + a.z * b.z }

fn m35_len(a: M35V3) -> f64 { sqrt(m35_dot(a, a)) }

fn m35_norm(a: M35V3) -> M35V3 { m35_mul(a, 1.0 / m35_len(a)) }

fn m35_cross(a: M35V3, b: M35V3) -> M35V3 {
    m35_v(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x)
}

fn m35_len3(x: f64, y: f64, z: f64) -> f64 { sqrt(x * x + y * y + z * z) }

fn m35_min_d(a: f64, b: f64) -> f64 {
    if b < a { return b; }
    a
}

fn m35_max_d(a: f64, b: f64) -> f64 {
    if a < b { return b; }
    a
}

fn m35_hypot2(a0: f64, b0: f64) -> f64 {
    let a: f64 = kit::absd(a0);
    let b: f64 = kit::absd(b0);
    if a == 0.0 && b == 0.0 { return 0.0; }
    if a >= b {
        let r: f64 = b / a;
        return a * sqrt(1.0 + r * r);
    }
    let r: f64 = a / b;
    b * sqrt(1.0 + r * r)
}

fn m35_still_sdf(p: M35V3) -> f64 {
    let d_sph: f64 = m35_len3(p.x - -0.9, p.y - 0.55, p.z - 0.2) - 0.55;
    let tdx: f64 = p.x - 0.75;
    let tdz: f64 = p.z - 0.45;
    let tqx: f64 = sqrt(tdx * tdx + tdz * tdz) - 0.5;
    let tqy: f64 = p.y - 0.18;
    let d_tor: f64 = sqrt(tqx * tqx + tqy * tqy) - 0.18;
    let pa: M35V3 = m35_sub(p, m35_v(0.05, 0.25, -0.95));
    let ba: M35V3 = m35_sub(m35_v(0.05, 1.55, -0.95), m35_v(0.05, 0.25, -0.95));
    let h_c: f64 = m35_min_d(1.0, m35_max_d(0.0, m35_dot(pa, ba) / m35_dot(ba, ba)));
    let d_cap: f64 = m35_len3(pa.x - ba.x * h_c, pa.y - ba.y * h_c, pa.z - ba.z * h_c) - 0.25;
    let qx: f64 = kit::absd(p.x - 1.65) - 0.22;
    let qy: f64 = kit::absd(p.y - 0.3) - 0.22;
    let qz: f64 = kit::absd(p.z - -0.6) - 0.22;
    let d_box: f64 = m35_len3(m35_max_d(qx, 0.0), m35_max_d(qy, 0.0), m35_max_d(qz, 0.0))
        + m35_min_d(m35_max_d(qx, m35_max_d(qy, qz)), 0.0) - 0.08;
    m35_min_d(p.y, m35_min_d(d_sph, m35_min_d(d_tor, m35_min_d(d_cap, d_box))))
}

fn m35_march(ro: M35V3, rd: M35V3) -> f64 {
    let mut t: f64 = 0.0;
    let mut i: i32 = 0;
    while i < 160 {
        let d: f64 = m35_still_sdf(m35_add(ro, m35_mul(rd, t)));
        if d < 1.0e-4 * (1.0 + t) { return t; }
        t = t + d;
        if t > 30.0 { return -1.0; }
        i = i + 1;
    }
    -1.0
}

fn m35_curv(p: M35V3, umb: f64) -> M35Curv {
    let ke: f64 = 0.01;
    let ke2: f64 = ke * ke;
    let f0: f64 = m35_still_sdf(p);
    let ex: M35V3 = m35_v(ke, 0.0, 0.0);
    let ey: M35V3 = m35_v(0.0, ke, 0.0);
    let ez: M35V3 = m35_v(0.0, 0.0, ke);
    let fpx: f64 = m35_still_sdf(m35_add(p, ex));
    let fmx: f64 = m35_still_sdf(m35_sub(p, ex));
    let fpy: f64 = m35_still_sdf(m35_add(p, ey));
    let fmy: f64 = m35_still_sdf(m35_sub(p, ey));
    let fpz: f64 = m35_still_sdf(m35_add(p, ez));
    let fmz: f64 = m35_still_sdf(m35_sub(p, ez));

    let g: M35V3 = m35_v((fpx - fmx) / (2.0 * ke), (fpy - fmy) / (2.0 * ke), (fpz - fmz) / (2.0 * ke));
    let gl: f64 = m35_len(g);
    let n: M35V3 = m35_mul(g, 1.0 / gl);

    let h00: f64 = (fpx - 2.0 * f0 + fmx) / ke2;
    let h11: f64 = (fpy - 2.0 * f0 + fmy) / ke2;
    let h22: f64 = (fpz - 2.0 * f0 + fmz) / ke2;
    let h01: f64 = (
        m35_still_sdf(m35_add(m35_add(p, ex), ey))
        - m35_still_sdf(m35_sub(m35_add(p, ex), ey))
        - m35_still_sdf(m35_add(m35_sub(p, ex), ey))
        + m35_still_sdf(m35_sub(m35_sub(p, ex), ey))
    ) / (4.0 * ke2);
    let h02: f64 = (
        m35_still_sdf(m35_add(m35_add(p, ex), ez))
        - m35_still_sdf(m35_sub(m35_add(p, ex), ez))
        - m35_still_sdf(m35_add(m35_sub(p, ex), ez))
        + m35_still_sdf(m35_sub(m35_sub(p, ex), ez))
    ) / (4.0 * ke2);
    let h12: f64 = (
        m35_still_sdf(m35_add(m35_add(p, ey), ez))
        - m35_still_sdf(m35_sub(m35_add(p, ey), ez))
        - m35_still_sdf(m35_add(m35_sub(p, ey), ez))
        + m35_still_sdf(m35_sub(m35_sub(p, ey), ez))
    ) / (4.0 * ke2);

    let ref_v: M35V3 = if kit::absd(n.y) < 0.9 { m35_v(0.0, 1.0, 0.0) } else { m35_v(1.0, 0.0, 0.0) };
    let t1: M35V3 = m35_norm(m35_cross(n, ref_v));
    let t2: M35V3 = m35_cross(n, t1);

    let ht1: M35V3 = m35_v(
        h00 * t1.x + h01 * t1.y + h02 * t1.z,
        h01 * t1.x + h11 * t1.y + h12 * t1.z,
        h02 * t1.x + h12 * t1.y + h22 * t1.z,
    );
    let ht2: M35V3 = m35_v(
        h00 * t2.x + h01 * t2.y + h02 * t2.z,
        h01 * t2.x + h11 * t2.y + h12 * t2.z,
        h02 * t2.x + h12 * t2.y + h22 * t2.z,
    );
    let a: f64 = m35_dot(t1, ht1) / gl;
    let b: f64 = m35_dot(t1, ht2) / gl;
    let d: f64 = m35_dot(t2, ht2) / gl;
    let m: f64 = 0.5 * (a + d);
    let r: f64 = sqrt(0.25 * ((a - d) * (a - d)) + b * b);
    let k1: f64 = m + r;
    let k2: f64 = m - r;
    let kmax: f64 = if kit::absd(k1) >= kit::absd(k2) { k1 } else { k2 };
    let mut e_x: f64 = b;
    let mut e_y: f64 = kmax - a;
    if kit::absd(kmax - d) > kit::absd(kmax - a) {
        e_x = kmax - d;
        e_y = b;
    }
    let el: f64 = m35_hypot2(e_x, e_y);
    let max_k: f64 = m35_max_d(kit::absd(k1), m35_max_d(kit::absd(k2), 0.05));
    let umbilic: bool = r < umb * max_k || el < 1.0e-12;
    let mut dir: M35V3 = if el > 0.0 {
        m35_norm(m35_add(m35_mul(t1, e_x / el), m35_mul(t2, e_y / el)))
    } else {
        t1
    };
    if umbilic {
        let up: M35V3 = m35_sub(m35_v(0.0, 1.0, 0.0), m35_mul(n, n.y));
        dir = if m35_len(up) > 1.0e-6 { m35_norm(up) } else { t1 };
    }
    let other: M35V3 = m35_cross(n, dir);
    M35Curv { n: n, dir: dir, other: other, umbilic: umbilic }
}

fn m35_line_cov(s: f64, freq: f64, half_w: f64, px: f64) -> f64 {
    let u: f64 = s * freq;
    let fr: f64 = u - floor(u);
    let dist: f64 = m35_min_d(fr, 1.0 - fr) / freq;
    m35_max_d(0.0, m35_min_d(1.0, (half_w - dist) / px + 0.5)) * m35_min_d(1.0, (2.0 * half_w) / px)
}

fn m35_hatch_lines(s: f64, freq: f64, px: f64, half_w: f64) -> f64 {
    let lev: f64 = m35_max_d(0.0, log2((px * freq) / 0.25));
    let l0: f64 = floor(lev);
    let t: f64 = lev - l0;
    let f0: f64 = freq / pow(2.0, l0);
    m35_line_cov(s, f0, half_w, px) * (1.0 - t) + m35_line_cov(s, f0 / 2.0, half_w, px) * t
}

fn m35_preset(kind: i32) -> M35HatchPlan {
    // 0 = engraving, 1 = crosshatch, 2 = ink, 3 = engraving umbilic ablation control (umb=100)
    if kind == 1 {
        return M35HatchPlan {
            freq: 26.0, width: 0.6, layers: 2, umb: 0.12, contour: 0.0, tone_floor: 0.12,
            ink0: 0.1, ink1: 0.09, ink2: 0.12, pap0: 0.96, pap1: 0.94, pap2: 0.9,
        };
    }
    if kind == 2 {
        return M35HatchPlan {
            freq: 22.0, width: 0.8, layers: 2, umb: 0.12, contour: 0.25, tone_floor: 0.12,
            ink0: 0.05, ink1: 0.05, ink2: 0.07, pap0: 0.93, pap1: 0.9, pap2: 0.84,
        };
    }
    let umb_v: f64 = if kind == 3 { 100.0 } else { 0.12 };
    M35HatchPlan {
        freq: 34.0, width: 0.55, layers: 1, umb: umb_v, contour: 0.0, tone_floor: 0.12,
        ink0: 0.12, ink1: 0.1, ink2: 0.11, pap0: 0.95, pap1: 0.93, pap2: 0.88,
    }
}

fn m35_run_hatch_hash(p: &M35HatchPlan, w: i32, h: i32, h0: u64) -> u64 {
    let eye: M35V3 = m35_v(3.2, 2.3, 3.7);
    let target: M35V3 = m35_v(0.25, 0.5, -0.15);
    let light: M35V3 = m35_norm(m35_v(-0.5, 0.8, 0.45));
    let tan_h: f64 = 0.42;
    let fwd: M35V3 = m35_norm(m35_sub(target, eye));
    let right: M35V3 = m35_norm(m35_v(-fwd.z, 0.0, fwd.x));
    let up: M35V3 = m35_cross(right, fwd);
    let slant: M35V3 = m35_v(0.9578262852211514, 0.0, 0.28734788556634544);
    let slant2: M35V3 = m35_v(-0.28734788556634544, 0.0, 0.9578262852211514);
    let kcross: M35V3 = m35_v(0.6246950475544243, 0.4685212856658182, -0.6246950475544243);

    let mut rgba: Vec<f64> = Vec::new();
    let mut hit: Vec<u64> = Vec::new();
    let mut fb: Vec<u64> = Vec::new();
    let mut y: i32 = 0;
    while y < h {
        let mut x: i32 = 0;
        while x < w {
            let sx: f64 = (((x as f64) + 0.5) / (w as f64) - 0.5) * 2.0 * ((w as f64) / (h as f64)) * tan_h;
            let sy: f64 = (0.5 - ((y as f64) + 0.5) / (h as f64)) * 2.0 * tan_h;
            let rd: M35V3 = m35_norm(m35_add(m35_add(fwd, m35_mul(right, sx)), m35_mul(up, sy)));
            let t: f64 = m35_march(eye, rd);
            let mut c0: f64 = p.pap0;
            let mut c1: f64 = p.pap1;
            let mut c2: f64 = p.pap2;
            let mut hv: u64 = 0;
            let mut fv: u64 = 0;
            if t > 0.0 {
                let q: M35V3 = m35_add(eye, m35_mul(rd, t));
                let cv: M35Curv = m35_curv(q, p.umb);
                let tone: f64 = p.tone_floor + 0.88 * m35_max_d(0.0, m35_dot(cv.n, light));
                hv = 1;
                fv = if cv.umbilic { 1 } else { 0 };
                let px: f64 = (t * 2.0 * tan_h) / (h as f64);
                let half_w: f64 = 0.5 * p.width * px;
                let dark: f64 = 1.0 - tone;
                let mut s1: f64 = m35_dot(q, cv.other);
                let mut s2: f64 = m35_dot(q, kcross);
                if cv.umbilic && kit::absd(cv.n.y) > 0.95 {
                    s1 = m35_dot(q, slant);
                    s2 = m35_dot(q, slant2);
                } else if cv.umbilic {
                    s1 = q.y;
                }
                let mut ink: f64 = m35_hatch_lines(s1, p.freq, px, half_w * (0.4 + 1.6 * dark));
                if p.layers > 1 && tone < 0.5 {
                    let i2: f64 = m35_hatch_lines(s2, p.freq, px, half_w * (0.4 + 2.0 * (0.5 - tone)));
                    ink = 1.0 - (1.0 - ink) * (1.0 - i2);
                }
                if p.contour > 0.0 {
                    let nv: f64 = kit::absd(m35_dot(cv.n, rd));
                    if nv < p.contour {
                        ink = m35_max_d(ink, m35_min_d(1.0, (p.contour - nv) / (0.5 * p.contour)));
                    }
                }
                c0 = p.pap0 * (1.0 - ink) + p.ink0 * ink;
                c1 = p.pap1 * (1.0 - ink) + p.ink1 * ink;
                c2 = p.pap2 * (1.0 - ink) + p.ink2 * ink;
            }
            rgba.push(c0); rgba.push(c1); rgba.push(c2); rgba.push(1.0);
            hit.push(hv);
            fb.push(fv);
            x = x + 1;
        }
        y = y + 1;
    }
    let mut hash: u64 = h0;
    let nr: i32 = rgba.len() as i32;
    let mut ri: i32 = 0;
    while ri < nr { hash = kit::fnv_f32(hash, rgba[ri]); ri = ri + 1; }
    let nh: i32 = hit.len() as i32;
    let mut hi: i32 = 0;
    while hi < nh { hash = kit::fnv_u8(hash, hit[hi]); hi = hi + 1; }
    let mut fi: i32 = 0;
    while fi < nh { hash = kit::fnv_u8(hash, fb[fi]); fi = fi + 1; }
    hash
}

fn m35_hash_one_probe(p: M35V3, h0: u64) -> u64 {
    let c: M35Curv = m35_curv(p, 0.12);
    let mut h: u64 = kit::fnv_f32(h0, c.n.x + 2.0);
    h = kit::fnv_f32(h, c.n.y + 2.0);
    h = kit::fnv_f32(h, c.n.z + 2.0);
    h = kit::fnv_f32(h, c.dir.x + 2.0);
    h = kit::fnv_f32(h, c.dir.y + 2.0);
    h = kit::fnv_f32(h, c.dir.z + 2.0);
    h = kit::fnv_f32(h, c.other.x + 2.0);
    h = kit::fnv_f32(h, c.other.y + 2.0);
    h = kit::fnv_f32(h, c.other.z + 2.0);
    kit::fnv_u8(h, if c.umbilic { 1 } else { 0 })
}

fn m35_hash_probes(h0: u64) -> u64 {
    let mut h: u64 = h0;
    h = m35_hash_one_probe(m35_v(0.75, 0.36, 0.95), h);
    h = m35_hash_one_probe(m35_v(1.25, 0.18, 0.45), h);
    h = m35_hash_one_probe(m35_v(0.35, 0.28, 0.65), h);
    h = m35_hash_one_probe(m35_v(0.30, 0.90, -0.95), h);
    h = m35_hash_one_probe(m35_v(0.05, 1.80, -0.95), h);
    h = m35_hash_one_probe(m35_v(-0.90, 1.10, 0.20), h);
    h = m35_hash_one_probe(m35_v(-0.45, 0.70, 0.50), h);
    h = m35_hash_one_probe(m35_v(1.65, 0.60, -0.60), h);
    h = m35_hash_one_probe(m35_v(1.92, 0.42, -0.36), h);
    h = m35_hash_one_probe(m35_v(0.00, 0.00, 1.20), h);
    h = m35_hash_one_probe(m35_v(1.05, 0.33, 0.85), h);
    m35_hash_one_probe(m35_v(0.22, 0.60, -0.78), h)
}

pub fn run_hatch_parity() -> (u64, u64, u64, u64, u64, u64) {
    let w: i32 = 48;
    let h: i32 = 32;
    let p_eng: M35HatchPlan = m35_preset(0);
    let p_cross: M35HatchPlan = m35_preset(1);
    let p_ink: M35HatchPlan = m35_preset(2);
    let p_ctrl: M35HatchPlan = m35_preset(3);

    let h_eng: u64 = m35_run_hatch_hash(&p_eng, w, h, kit::fnv_start());
    let h_cross: u64 = m35_run_hatch_hash(&p_cross, w, h, kit::fnv_start());
    let h_ink: u64 = m35_run_hatch_hash(&p_ink, w, h, kit::fnv_start());
    let h_probe: u64 = m35_hash_probes(kit::fnv_start());
    let h_ctrl: u64 = m35_run_hatch_hash(&p_ctrl, w, h, kit::fnv_start());

    let mut h_all: u64 = kit::fnv_start();
    h_all = m35_run_hatch_hash(&p_eng, w, h, h_all);
    h_all = m35_run_hatch_hash(&p_cross, w, h, h_all);
    h_all = m35_run_hatch_hash(&p_ink, w, h, h_all);
    h_all = m35_hash_probes(h_all);

    (h_eng, h_cross, h_ink, h_probe, h_all, h_ctrl)
}
