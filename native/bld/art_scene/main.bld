//
// The art scene's ray caster and shading, in BuildLang.
//
// This is a port of three C++ files of the renderer (src/renderer/art_scene.cpp,
// art_scene_trace.cpp, art_scene_prims.hpp): a still life of a ground plane, a wall, a plinth, two
// spheres and a column, ray cast in 64-bit floats with a shadowed sun, a sky gradient and a
// hemispherical ambient term, four samples a pixel.
//
// The proof is a number the C++ already pins. tests/test_art_strokes.cpp renders frame 0 of the
// orbit at 256 x 144 in daylight and requires the FNV-1a hash of the lit buffer's 32-bit floats to
// be 0x8e70a9159d2007bf, on GCC and on MSVC. This program renders the same frame and prints the
// same hash. Every expression below keeps the C++'s order of operations, because the hash moves
// if one addition is regrouped.
//
//   buildc build --release native/bld/art_scene && native/bld/art_scene/target/release/main

extern "C" header "<math.h>" {
    fn tan(x: f64) -> f64;
}

// ---------------------------------------------------------------- three numbers at a time

fn v3(x: f64, y: f64, z: f64) -> Vec<f64> {
    let v: Vec<f64> = Vec::new();
    v.push(x); v.push(y); v.push(z);
    v
}

fn dot(a: Vec<f64>, b: Vec<f64>) -> f64 {
    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
}

fn sub(a: Vec<f64>, b: Vec<f64>) -> Vec<f64> {
    v3(a[0] - b[0], a[1] - b[1], a[2] - b[2])
}

fn cross(a: Vec<f64>, b: Vec<f64>) -> Vec<f64> {
    v3(a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0])
}

fn norm(a: Vec<f64>) -> Vec<f64> {
    let l: f64 = sqrt(dot(a, a));
    v3(a[0] / l, a[1] / l, a[2] / l)
}

fn absd(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x; }
    x
}

fn clampd(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo { return lo; }
    if x > hi { return hi; }
    x
}

// ---------------------------------------------------------------- the nearest hit

// A hit is twelve numbers: t, normal (3), object, material, albedo (3), emission (3). t < 0: none.
fn no_hit() -> Vec<f64> {
    let h: Vec<f64> = Vec::new();
    h.push(0.0 - 1.0);
    let mut i: i32 = 0;
    while i < 11 {
        h.push(0.0);
        i = i + 1;
    }
    h
}

fn consider(best: Vec<f64>, t: f64, nx: f64, ny: f64, nz: f64, obj: f64, mat: f64, ar: f64, ag: f64, ab: f64) {
    if t > 0.000000001 && (best[0] < 0.0 || t < best[0]) {
        best[0] = t; best[1] = nx; best[2] = ny; best[3] = nz; best[4] = obj; best[5] = mat;
        best[6] = ar; best[7] = ag; best[8] = ab; best[9] = 0.0; best[10] = 0.0; best[11] = 0.0;
    }
}

fn hit_ground(o: Vec<f64>, d: Vec<f64>, best: Vec<f64>) {
    if absd(d[1]) < 0.000000000000001 { return; }
    let t: f64 = (0.0 - o[1]) / d[1];
    let x: f64 = o[0] + t * d[0];
    let z: f64 = o[2] + t * d[2];
    if absd(x) <= 30.0 && absd(z) <= 30.0 { consider(best, t, 0.0, 1.0, 0.0, 1.0, 1.0, 0.34, 0.32, 0.26); }
}

fn hit_box(lo: Vec<f64>, hi: Vec<f64>, obj: f64, mat: f64, ar: f64, ag: f64, ab: f64, o: Vec<f64>, d: Vec<f64>, best: Vec<f64>) {
    let mut t0: f64 = 0.0 - 1.0e300;
    let mut t1: f64 = 1.0e300;
    let mut axis: i32 = 0 - 1;
    let mut sign: f64 = 0.0;
    let mut k: i32 = 0;
    while k < 3 {
        if absd(d[k as usize]) < 0.000000000000001 {
            if o[k as usize] < lo[k as usize] || o[k as usize] > hi[k as usize] { return; }
        } else {
            let inv: f64 = 1.0 / d[k as usize];
            let mut ta: f64 = (lo[k as usize] - o[k as usize]) * inv;
            let mut tb: f64 = (hi[k as usize] - o[k as usize]) * inv;
            let mut s: f64 = 0.0 - 1.0;
            if ta > tb {
                let swap: f64 = ta;
                ta = tb;
                tb = swap;
                s = 1.0;
            }
            if ta > t0 { t0 = ta; axis = k; sign = s; }
            if tb < t1 { t1 = tb; }
            if t0 > t1 { return; }
        }
        k = k + 1;
    }
    if axis < 0 || t0 <= 0.000000001 { return; }
    let mut nx: f64 = 0.0; let mut ny: f64 = 0.0; let mut nz: f64 = 0.0;
    if axis == 0 { nx = sign; }
    if axis == 1 { ny = sign; }
    if axis == 2 { nz = sign; }
    consider(best, t0, nx, ny, nz, obj, mat, ar, ag, ab);
}

fn hit_sphere(cx: f64, cy: f64, cz: f64, r: f64, obj: f64, mat: f64, ar: f64, ag: f64, ab: f64, o: Vec<f64>, d: Vec<f64>, best: Vec<f64>) {
    let q: Vec<f64> = v3(o[0] - cx, o[1] - cy, o[2] - cz);
    let b: f64 = dot(q, d);
    let c: f64 = dot(q, q) - r * r;
    let disc: f64 = b * b - c;
    if disc < 0.0 { return; }
    let sq: f64 = sqrt(disc);
    let mut t: f64 = (0.0 - b) - sq;
    if t <= 0.000000001 { t = (0.0 - b) + sq; }
    if t <= 0.000000001 { return; }
    consider(best, t, (q[0] + t * d[0]) / r, (q[1] + t * d[1]) / r, (q[2] + t * d[2]) / r, obj, mat, ar, ag, ab);
}

fn hit_cylinder(x: f64, z: f64, r: f64, y0: f64, y1: f64, obj: f64, mat: f64, ar: f64, ag: f64, ab: f64, o: Vec<f64>, d: Vec<f64>, best: Vec<f64>) {
    let qx: f64 = o[0] - x;
    let qz: f64 = o[2] - z;
    let a: f64 = d[0] * d[0] + d[2] * d[2];
    let b: f64 = qx * d[0] + qz * d[2];
    let cc: f64 = qx * qx + qz * qz - r * r;
    if a > 0.000000000000001 {
        let disc: f64 = b * b - a * cc;
        if disc >= 0.0 {
            let sq: f64 = sqrt(disc);
            // the nearer root first; the first one on the side wall is taken
            let ta: f64 = ((0.0 - b) - sq) / a;
            let ya: f64 = o[1] + ta * d[1];
            if ta > 0.000000001 && ya >= y0 && ya <= y1 {
                consider(best, ta, (qx + ta * d[0]) / r, 0.0, (qz + ta * d[2]) / r, obj, mat, ar, ag, ab);
            } else {
                let tb: f64 = ((0.0 - b) + sq) / a;
                let yb: f64 = o[1] + tb * d[1];
                if tb > 0.000000001 && yb >= y0 && yb <= y1 {
                    consider(best, tb, (qx + tb * d[0]) / r, 0.0, (qz + tb * d[2]) / r, obj, mat, ar, ag, ab);
                }
            }
        }
    }
    if absd(d[1]) > 0.000000000000001 {
        let t: f64 = (y1 - o[1]) / d[1];
        let px: f64 = qx + t * d[0];
        let pz: f64 = qz + t * d[2];
        if px * px + pz * pz <= r * r { consider(best, t, 0.0, 1.0, 0.0, obj, mat, ar, ag, ab); }
    }
}

// the still life: ground, wall, plinth, two spheres, a column, in that order
fn trace(o: Vec<f64>, d: Vec<f64>) -> Vec<f64> {
    let best: Vec<f64> = no_hit();
    hit_ground(o, d, best);
    hit_box(v3(0.0 - 6.0, 0.0, 0.0 - 4.6), v3(6.0, 4.0, 0.0 - 4.0), 2.0, 4.0, 0.58, 0.36, 0.27, o, d, best);
    hit_box(v3(0.0 - 1.6, 0.0, 0.0 - 1.2), v3(1.6, 0.9, 1.2), 3.0, 2.0, 0.72, 0.70, 0.65, o, d, best);
    hit_sphere(0.0, 1.75, 0.0, 0.85, 4.0, 3.0, 0.86, 0.83, 0.77, o, d, best);
    hit_sphere(2.6, 0.6, 1.0, 0.6, 5.0, 5.0, 0.28, 0.40, 0.62, o, d, best);
    hit_cylinder(0.0 - 2.8, 0.0 - 1.4, 0.45, 0.0, 3.2, 6.0, 2.0, 0.66, 0.64, 0.60, o, d, best);
    best
}

fn occluded(o: Vec<f64>, d: Vec<f64>, t_max: f64) -> bool {
    let h: Vec<f64> = trace(o, d);
    h[0] > 0.0 && h[0] < t_max
}

// ---------------------------------------------------------------- the view

// frame 0 of the orbit: radius 8.5, eye height 4.2, azimuth 20 degrees, looking at (0, 1, 0)
fn orbit_eye() -> Vec<f64> {
    let a: f64 = (20.0 + 1.0 * 0.0) * 3.141592653589793 / 180.0;
    v3(8.5 * sin(a), 4.2, 8.5 * cos(a))
}

fn ray_dir(eye: Vec<f64>, target: Vec<f64>, fovy: f64, w: i32, h: i32, px: f64, py: f64) -> Vec<f64> ~ Foreign {
    let f: Vec<f64> = norm(sub(target, eye));
    let r: Vec<f64> = norm(cross(f, v3(0.0, 1.0, 0.0)));
    let u: Vec<f64> = cross(r, f);
    let focal: f64 = 0.5 * (h as f64) / tan(0.5 * fovy);
    let x: f64 = (px - 0.5 * (w as f64)) / focal;
    let y: f64 = (0.0 - (py - 0.5 * (h as f64))) / focal;
    norm(v3(f[0] + x * r[0] + y * u[0], f[1] + x * r[1] + y * u[1], f[2] + x * r[2] + y * u[2]))
}

// ---------------------------------------------------------------- daylight

// the colour seen along a ray from the eye: sky if nothing is hit, otherwise sun, ambient and albedo
fn shade(sun_dir: Vec<f64>, o: Vec<f64>, d: Vec<f64>, h: Vec<f64>) -> Vec<f64> {
    // daylight: sky top, sky horizon, ground bounce, sun colour
    let top: Vec<f64> = v3(0.42, 0.55, 0.80);
    let horizon: Vec<f64> = v3(0.80, 0.82, 0.85);
    let ground: Vec<f64> = v3(0.24, 0.21, 0.17);
    let sun_c: Vec<f64> = v3(2.6, 2.45, 2.2);
    if h[0] < 0.0 {
        let t: f64 = clampd(d[1] * 1.6 + 0.1, 0.0, 1.0);
        return v3(horizon[0] + (top[0] - horizon[0]) * t, horizon[1] + (top[1] - horizon[1]) * t, horizon[2] + (top[2] - horizon[2]) * t);
    }
    let p: Vec<f64> = v3(o[0] + h[0] * d[0], o[1] + h[0] * d[1], o[2] + h[0] * d[2]);
    let n: Vec<f64> = v3(h[1], h[2], h[3]);
    let lifted: Vec<f64> = v3(p[0] + n[0] * 0.000001, p[1] + n[1] * 0.000001, p[2] + n[2] * 0.000001);
    let nl: f64 = dot(n, sun_dir);
    let mut sun: f64 = 0.0;
    if nl > 0.0 && !occluded(lifted, sun_dir, 1.0e30) { sun = nl; }
    // no lamp in daylight: its colour is zero and so is its term
    let lamp: f64 = 0.0;
    let amb_t: f64 = 0.5 + 0.5 * n[1];
    let c: Vec<f64> = v3(0.0, 0.0, 0.0);
    let mut k: i32 = 0;
    while k < 3 {
        let amb: f64 = ground[k as usize] + (top[k as usize] - ground[k as usize]) * amb_t;
        c[k as usize] = h[(6 + k) as usize] * (sun_c[k as usize] * sun + 0.0 * lamp + amb) + h[(9 + k) as usize] * 1.0;
        k = k + 1;
    }
    c
}

// ---------------------------------------------------------------- the hash the C++ pins

// The bit pattern of the 32-bit float nearest to v, ties to even, as a number 0 .. 2^32 - 1.
// For positive normal values and zero, which is all the lit buffer holds.
fn f32_bits(v: f64) -> i64 {
    if v == 0.0 { return 0; }
    let mut a: f64 = v;
    let mut e: i64 = 0;
    while a >= 2.0 { a = a / 2.0; e = e + 1; }
    while a < 1.0 { a = a * 2.0; e = e - 1; }
    let scaled: f64 = a * 8388608.0;
    let mut r: f64 = floor(scaled);
    let frac: f64 = scaled - r;
    let half_r: f64 = floor(r / 2.0);
    let odd: bool = r - half_r * 2.0 > 0.5;
    if frac > 0.5 || (frac == 0.5 && odd) { r = r + 1.0; }
    if r >= 16777216.0 { r = 8388608.0; e = e + 1; }
    (e + 127) * 8388608 + ((r - 8388608.0) as i64)
}

// FNV-1a over bytes, 64 bits, kept as four 16-bit limbs so no product can overflow.
// The prime is 2^40 + 435.
fn fnv_byte(h: Vec<i64>, byte: i64) {
    h[0] = h[0] ^ byte;
    // h times 435
    let t0: i64 = h[0] * 435;
    let t1: i64 = h[1] * 435 + t0 / 65536;
    let t2: i64 = h[2] * 435 + t1 / 65536;
    let t3: i64 = h[3] * 435 + t2 / 65536;
    let a0: i64 = t0 % 65536;
    let a1: i64 = t1 % 65536;
    let a2: i64 = t2 % 65536;
    let a3: i64 = t3 % 65536;
    // h shifted left by 40 bits: two limbs and eight bits
    let b2: i64 = (h[0] * 256) % 65536;
    let b3: i64 = (h[1] * 256 + h[0] / 256) % 65536;
    let s2: i64 = a2 + b2;
    let s3: i64 = a3 + b3 + s2 / 65536;
    h[0] = a0;
    h[1] = a1;
    h[2] = s2 % 65536;
    h[3] = s3 % 65536;
}

fn fnv_f32(h: Vec<i64>, v: f64) {
    let b: i64 = f32_bits(v);
    fnv_byte(h, b % 256);
    fnv_byte(h, (b / 256) % 256);
    fnv_byte(h, (b / 65536) % 256);
    fnv_byte(h, (b / 16777216) % 256);
}

fn main() ~ Console + Foreign {
    let w: i32 = 256;
    let h: i32 = 144;
    let eye: Vec<f64> = orbit_eye();
    let target: Vec<f64> = v3(0.0, 1.0, 0.0);
    let sun_dir: Vec<f64> = norm(v3(0.0 - 0.45, 0.78, 0.42));
    // The engine starts its hash at 1469598103934665603 (0x14650fb0739d0383), one digit short of
    // the usual FNV offset. The pinned hashes depend on it, so the port keeps it. Lowest limb first.
    let hash: Vec<i64> = Vec::new();
    hash.push(899); hash.push(29597); hash.push(4016); hash.push(5221);
    let mut covered: i32 = 0;
    let mut y: i32 = 0;
    while y < h {
        let mut x: i32 = 0;
        while x < w {
            let acc: Vec<f64> = v3(0.0, 0.0, 0.0);
            let mut s: i32 = 0;
            while s < 4 {
                let d: Vec<f64> = ray_dir(eye, target, 0.75, w, h, (x as f64) + 0.25 + 0.5 * ((s % 2) as f64), (y as f64) + 0.25 + 0.5 * ((s / 2) as f64));
                let hit: Vec<f64> = trace(eye, d);
                let c: Vec<f64> = shade(sun_dir, eye, d, hit);
                acc[0] = acc[0] + c[0] / 4.0;
                acc[1] = acc[1] + c[1] / 4.0;
                acc[2] = acc[2] + c[2] / 4.0;
                if s == 0 && hit[0] > 0.0 { covered = covered + 1; }
                s = s + 1;
            }
            fnv_f32(hash, acc[0]);
            fnv_f32(hash, acc[1]);
            fnv_f32(hash, acc[2]);
            fnv_f32(hash, 1.0);
            if (x == 0 && y == 0) || (x == 128 && y == 72) || (x == 128 && y == 100) || (x == 60 && y == 90) {
            }
            x = x + 1;
        }
        y = y + 1;
    }
    println!("lit hash limbs, high to low: {} {} {} {}", hash[3], hash[2], hash[1], hash[0]);
    println!("the C++ pins 0x8e70a9159d2007bf, which is: 36464 43285 40224 1983");
    let mut same: i32 = 0;
    if hash[3] == 36464 && hash[2] == 43285 && hash[1] == 40224 && hash[0] == 1983 { same = 1; }
    println!("byte-identical to the C++ lit buffer: {} of 1", same);
    println!("pixels whose first sample hits the scene: {} of {}", covered, w * h);
}
