// Renderer module #13: src/renderer/noise.cpp + raw/renderer/noise.hpp
// Reproduces tests/test_noise.cpp golden set pin 0xbb69adfcaefa21bc (GCC 13.3 and MSVC VS 18)
// across all 20 procedural noise images (128 x 128, 327,680 f32 pixels).

struct Cell { f1: f32, f2: f32 }
struct Warped { x: f32, y: f32, z: f32 }

fn lowbias32(x0: u32) -> u32 {
    let mut x: u32 = x0;
    x = x ^ (x >> 16);
    x = x.wrapping_mul(0x7feb352du32);
    x = x ^ (x >> 15);
    x = x.wrapping_mul(0x846ca68bu32);
    x = x ^ (x >> 16);
    x
}

pub fn hash(x: u32, y: u32, z: u32, seed: u32) -> u32 {
    lowbias32(x ^ lowbias32(y ^ lowbias32(z ^ lowbias32(seed))))
}

fn unit(h: u32) -> f32 {
    ((h >> 8) as f32) * (1.0f32 / 16777216.0f32)
}

fn fade(t: f32) -> f32 {
    t * t * t * (t * (t * 6.0f32 - 15.0f32) + 10.0f32)
}

fn lerp(a: f32, b: f32, t: f32) -> f32 {
    a + (b - a) * t
}

fn fl(v: f32) -> i32 {
    floor(v as f64) as i32
}

fn abs_f32(v: f32) -> f32 {
    if v < 0.0f32 { -v } else { v }
}

fn max_f32(a: f32, b: f32) -> f32 {
    if a > b { a } else { b }
}

fn sqrt_f32(v: f32) -> f32 {
    sqrt(v as f64) as f32
}

pub fn white(x: i32, y: i32, z: i32, seed: u32) -> f32 {
    unit(hash(x as u32, y as u32, z as u32, seed))
}

fn grad2(h: u32, x: f32, y: f32) -> f32 {
    let g: u32 = h & 7u32;
    if g == 0u32 { return x + y; }
    if g == 1u32 { return -x + y; }
    if g == 2u32 { return x - y; }
    if g == 3u32 { return -x - y; }
    if g == 4u32 { return x; }
    if g == 5u32 { return -x; }
    if g == 6u32 { return y; }
    -y
}

fn grad3(h: u32, x: f32, y: f32, z: f32) -> f32 {
    let g: u32 = (h >> 4) % 12u32;
    if g == 0u32 { return x + y; }
    if g == 1u32 { return -x + y; }
    if g == 2u32 { return x - y; }
    if g == 3u32 { return -x - y; }
    if g == 4u32 { return x + z; }
    if g == 5u32 { return -x + z; }
    if g == 6u32 { return x - z; }
    if g == 7u32 { return -x - z; }
    if g == 8u32 { return y + z; }
    if g == 9u32 { return -y + z; }
    if g == 10u32 { return y - z; }
    -y - z
}

fn value2(x: f32, y: f32, seed: u32) -> f32 {
    let i: i32 = fl(x);
    let j: i32 = fl(y);
    let fx: f32 = fade(x - (i as f32));
    let fy: f32 = fade(y - (j as f32));
    let a: f32 = white(i, j, 0, seed);
    let b: f32 = white(i + 1, j, 0, seed);
    let c: f32 = white(i, j + 1, 0, seed);
    let d: f32 = white(i + 1, j + 1, 0, seed);
    lerp(lerp(a, b, fx), lerp(c, d, fx), fy)
}

fn value3(x: f32, y: f32, z: f32, seed: u32) -> f32 {
    let i: i32 = fl(x);
    let j: i32 = fl(y);
    let k: i32 = fl(z);
    let fx: f32 = fade(x - (i as f32));
    let fy: f32 = fade(y - (j as f32));
    let fz: f32 = fade(z - (k as f32));
    let w000: f32 = white(i, j, k, seed);
    let w100: f32 = white(i + 1, j, k, seed);
    let w010: f32 = white(i, j + 1, k, seed);
    let w110: f32 = white(i + 1, j + 1, k, seed);
    let w001: f32 = white(i, j, k + 1, seed);
    let w101: f32 = white(i + 1, j, k + 1, seed);
    let w011: f32 = white(i, j + 1, k + 1, seed);
    let w111: f32 = white(i + 1, j + 1, k + 1, seed);
    let z0: f32 = lerp(lerp(w000, w100, fx), lerp(w010, w110, fx), fy);
    let z1: f32 = lerp(lerp(w001, w101, fx), lerp(w011, w111, fx), fy);
    lerp(z0, z1, fz)
}

fn perlin2(x: f32, y: f32, seed: u32) -> f32 {
    let i: i32 = fl(x);
    let j: i32 = fl(y);
    let rx: f32 = x - (i as f32);
    let ry: f32 = y - (j as f32);
    let fx: f32 = fade(rx);
    let fy: f32 = fade(ry);
    let g00: f32 = grad2(hash(i as u32, j as u32, 0u32, seed), rx, ry);
    let g10: f32 = grad2(hash((i + 1) as u32, j as u32, 0u32, seed), rx - 1.0f32, ry);
    let g01: f32 = grad2(hash(i as u32, (j + 1) as u32, 0u32, seed), rx, ry - 1.0f32);
    let g11: f32 = grad2(
        hash((i + 1) as u32, (j + 1) as u32, 0u32, seed),
        rx - 1.0f32,
        ry - 1.0f32,
    );
    lerp(lerp(g00, g10, fx), lerp(g01, g11, fx), fy) * 0.70710678f32
}

fn perlin3(x: f32, y: f32, z: f32, seed: u32) -> f32 {
    let i: i32 = fl(x);
    let j: i32 = fl(y);
    let k: i32 = fl(z);
    let rx: f32 = x - (i as f32);
    let ry: f32 = y - (j as f32);
    let rz: f32 = z - (k as f32);
    let fx: f32 = fade(rx);
    let fy: f32 = fade(ry);
    let fz: f32 = fade(rz);
    let g000: f32 = grad3(hash(i as u32, j as u32, k as u32, seed), rx, ry, rz);
    let g100: f32 = grad3(
        hash((i + 1) as u32, j as u32, k as u32, seed),
        rx - 1.0f32, ry, rz,
    );
    let g010: f32 = grad3(
        hash(i as u32, (j + 1) as u32, k as u32, seed),
        rx, ry - 1.0f32, rz,
    );
    let g110: f32 = grad3(
        hash((i + 1) as u32, (j + 1) as u32, k as u32, seed),
        rx - 1.0f32, ry - 1.0f32, rz,
    );
    let g001: f32 = grad3(
        hash(i as u32, j as u32, (k + 1) as u32, seed),
        rx, ry, rz - 1.0f32,
    );
    let g101: f32 = grad3(
        hash((i + 1) as u32, j as u32, (k + 1) as u32, seed),
        rx - 1.0f32, ry, rz - 1.0f32,
    );
    let g011: f32 = grad3(
        hash(i as u32, (j + 1) as u32, (k + 1) as u32, seed),
        rx, ry - 1.0f32, rz - 1.0f32,
    );
    let g111: f32 = grad3(
        hash((i + 1) as u32, (j + 1) as u32, (k + 1) as u32, seed),
        rx - 1.0f32, ry - 1.0f32, rz - 1.0f32,
    );
    let z0: f32 = lerp(lerp(g000, g100, fx), lerp(g010, g110, fx), fy);
    let z1: f32 = lerp(lerp(g001, g101, fx), lerp(g011, g111, fx), fy);
    lerp(z0, z1, fz)
}

fn simplex2(x: f32, y: f32, seed: u32) -> f32 {
    let f2: f32 = 0.36602540378f32;
    let g2: f32 = 0.21132486541f32;
    let s: f32 = (x + y) * f2;
    let i: i32 = fl(x + s);
    let j: i32 = fl(y + s);
    let t: f32 = ((i + j) as f32) * g2;
    let x0: f32 = x - ((i as f32) - t);
    let y0: f32 = y - ((j as f32) - t);
    let i1: i32 = if x0 > y0 { 1 } else { 0 };
    let j1: i32 = 1 - i1;
    let xs: [f32; 3] = [x0, x0 - (i1 as f32) + g2, x0 - 1.0f32 + 2.0f32 * g2];
    let ys: [f32; 3] = [y0, y0 - (j1 as f32) + g2, y0 - 1.0f32 + 2.0f32 * g2];
    let di: [i32; 3] = [0, i1, 1];
    let dj: [i32; 3] = [0, j1, 1];
    let mut n: f32 = 0.0f32;
    let mut c: i32 = 0;
    while c < 3 {
        let cu: usize = c as usize;
        let mut r: f32 = 0.5f32 - xs[cu] * xs[cu] - ys[cu] * ys[cu];
        if r > 0.0f32 {
            r = r * r;
            let h: u32 = hash((i + di[cu]) as u32, (j + dj[cu]) as u32, 0u32, seed);
            n = n + r * r * grad2(h, xs[cu], ys[cu]);
        }
        c = c + 1;
    }
    70.0f32 * n * 0.70710678f32
}

fn simplex3(x: f32, y: f32, z: f32, seed: u32) -> f32 {
    let f3: f32 = 1.0f32 / 3.0f32;
    let g3: f32 = 1.0f32 / 6.0f32;
    let s: f32 = (x + y + z) * f3;
    let i: i32 = fl(x + s);
    let j: i32 = fl(y + s);
    let k: i32 = fl(z + s);
    let t: f32 = ((i + j + k) as f32) * g3;
    let x0: f32 = x - ((i as f32) - t);
    let y0: f32 = y - ((j as f32) - t);
    let z0: f32 = z - ((k as f32) - t);
    let mut a0: i32 = 0;
    let mut a1: i32 = 0;
    let mut a2: i32 = 0;
    let mut b0: i32 = 0;
    let mut b1: i32 = 0;
    let mut b2: i32 = 0;
    if x0 >= y0 {
        if y0 >= z0 { a0 = 1; b0 = 1; b1 = 1; }
        else if x0 >= z0 { a0 = 1; b0 = 1; b2 = 1; }
        else { a2 = 1; b0 = 1; b2 = 1; }
    } else {
        if y0 < z0 { a2 = 1; b1 = 1; b2 = 1; }
        else if x0 < z0 { a1 = 1; b1 = 1; b2 = 1; }
        else { a1 = 1; b0 = 1; b1 = 1; }
    }
    let ox: [i32; 4] = [0, a0, b0, 1];
    let oy: [i32; 4] = [0, a1, b1, 1];
    let oz: [i32; 4] = [0, a2, b2, 1];
    let mut n: f32 = 0.0f32;
    let mut c: i32 = 0;
    while c < 4 {
        let cu: usize = c as usize;
        let g: f32 = g3 * (c as f32);
        let px: f32 = x0 - (ox[cu] as f32) + g;
        let py: f32 = y0 - (oy[cu] as f32) + g;
        let pz: f32 = z0 - (oz[cu] as f32) + g;
        let mut r: f32 = 0.6f32 - px * px - py * py - pz * pz;
        if r > 0.0f32 {
            r = r * r;
            let h: u32 = hash(
                (i + ox[cu]) as u32,
                (j + oy[cu]) as u32,
                (k + oz[cu]) as u32,
                seed,
            );
            n = n + r * r * grad3(h, px, py, pz);
        }
        c = c + 1;
    }
    32.0f32 * n
}

fn worley2(x: f32, y: f32, seed: u32) -> Cell {
    let i: i32 = fl(x);
    let j: i32 = fl(y);
    let mut d1: f32 = 1e30f32;
    let mut d2: f32 = 1e30f32;
    let mut b: i32 = -1;
    while b <= 1 {
        let mut a: i32 = -1;
        while a <= 1 {
            let h: u32 = hash((i + a) as u32, (j + b) as u32, 0x5eedu32, seed);
            let px: f32 = ((i + a) as f32) + unit(h);
            let py: f32 = ((j + b) as f32) + unit(lowbias32(h));
            let dx: f32 = px - x;
            let dy: f32 = py - y;
            let d: f32 = dx * dx + dy * dy;
            if d < d1 { d2 = d1; d1 = d; } else if d < d2 { d2 = d; }
            a = a + 1;
        }
        b = b + 1;
    }
    Cell { f1: sqrt_f32(d1), f2: sqrt_f32(d2) }
}

fn worley3(x: f32, y: f32, z: f32, seed: u32) -> Cell {
    let i: i32 = fl(x);
    let j: i32 = fl(y);
    let k: i32 = fl(z);
    let mut d1: f32 = 1e30f32;
    let mut d2: f32 = 1e30f32;
    let mut c: i32 = -1;
    while c <= 1 {
        let mut b: i32 = -1;
        while b <= 1 {
            let mut a: i32 = -1;
            while a <= 1 {
                let h: u32 = hash(
                    (i + a) as u32,
                    (j + b) as u32,
                    (k + c) as u32,
                    seed ^ 0x5eedu32,
                );
                let h2: u32 = lowbias32(h);
                let px: f32 = ((i + a) as f32) + unit(h);
                let py: f32 = ((j + b) as f32) + unit(h2);
                let pz: f32 = ((k + c) as f32) + unit(lowbias32(h2));
                let dx: f32 = px - x;
                let dy: f32 = py - y;
                let dz: f32 = pz - z;
                let d: f32 = dx * dx + dy * dy + dz * dz;
                if d < d1 { d2 = d1; d1 = d; } else if d < d2 { d2 = d; }
                a = a + 1;
            }
            b = b + 1;
        }
        c = c + 1;
    }
    Cell { f1: sqrt_f32(d1), f2: sqrt_f32(d2) }
}

fn base3(b: i32, x: f32, y: f32, z: f32, seed: u32) -> f32 {
    if b == 0 { return perlin3(x, y, z, seed); }
    if b == 1 { return simplex3(x, y, z, seed); }
    value3(x, y, z, seed) * 2.0f32 - 1.0f32
}

fn fbm(b: i32, x: f32, y: f32, z: f32, seed: u32) -> f32 {
    let mut sum: f32 = 0.0f32;
    let mut amp: f32 = 1.0f32;
    let mut norm: f32 = 0.0f32;
    let mut f: f32 = 1.0f32;
    let mut k: i32 = 0;
    while k < 5 {
        sum = sum + amp * base3(b, x * f, y * f, z * f, seed + (k as u32));
        norm = norm + amp;
        amp = amp * 0.5f32;
        f = f * 2.0f32;
        k = k + 1;
    }
    sum / norm
}

fn ridged(b: i32, x: f32, y: f32, z: f32, seed: u32) -> f32 {
    let mut sum: f32 = 0.0f32;
    let mut amp: f32 = 1.0f32;
    let mut norm: f32 = 0.0f32;
    let mut f: f32 = 1.0f32;
    let mut weight: f32 = 1.0f32;
    let mut k: i32 = 0;
    while k < 5 {
        let mut s: f32 = 1.0f32 - abs_f32(base3(b, x * f, y * f, z * f, seed + (k as u32)));
        s = s * s * weight;
        let w2: f32 = s * 2.0f32;
        weight = if w2 > 1.0f32 { 1.0f32 } else if w2 < 0.0f32 { 0.0f32 } else { w2 };
        sum = sum + amp * s;
        norm = norm + amp;
        amp = amp * 0.5f32;
        f = f * 2.0f32;
        k = k + 1;
    }
    sum / norm
}

fn billow(b: i32, x: f32, y: f32, z: f32, seed: u32) -> f32 {
    let mut sum: f32 = 0.0f32;
    let mut amp: f32 = 1.0f32;
    let mut norm: f32 = 0.0f32;
    let mut f: f32 = 1.0f32;
    let mut k: i32 = 0;
    while k < 5 {
        let v: f32 = 2.0f32 * abs_f32(base3(b, x * f, y * f, z * f, seed + (k as u32))) - 1.0f32;
        sum = sum + amp * v;
        norm = norm + amp;
        amp = amp * 0.5f32;
        f = f * 2.0f32;
        k = k + 1;
    }
    sum / norm
}

fn hybrid(b: i32, x: f32, y: f32, z: f32, seed: u32) -> f32 {
    let offset: f32 = 0.7f32;
    let mut amp: f32 = 1.0f32;
    let mut f: f32 = 1.0f32;
    let mut result: f32 = base3(b, x, y, z, seed) + offset;
    let mut weight: f32 = result;
    let mut k: i32 = 1;
    while k < 5 {
        amp = amp * 0.5f32;
        f = f * 2.0f32;
        if weight > 1.0f32 { weight = 1.0f32; }
        let signal: f32 = (base3(b, x * f, y * f, z * f, seed + (k as u32)) + offset) * amp;
        result = result + weight * signal;
        weight = weight * signal;
        k = k + 1;
    }
    if result < 0.0f32 { 0.0f32 } else { result }
}

fn warp(x: f32, y: f32, z: f32, seed: u32, strength: f32) -> Warped {
    let wx: f32 = fbm(1, x + 1.7f32, y + 9.2f32, z + 3.1f32, seed + 101u32);
    let wy: f32 = fbm(1, x + 8.3f32, y + 2.8f32, z + 6.5f32, seed + 202u32);
    let wz: f32 = fbm(1, x + 4.6f32, y + 7.4f32, z + 0.9f32, seed + 303u32);
    Warped { x: x + strength * wx, y: y + strength * wy, z: z + strength * wz }
}

