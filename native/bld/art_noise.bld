        165320729110345u64, 153863285597179u64, 267954232795620u64, 211011892162624u64,
        138096332113423u64, 163192381217376u64, 90397970803409u64, 94556312153197u64,
        5741166529973u64, 107187186788842u64, 205095781567261u64, 64300327054735u64,
        61088947943793u64, 7599382421122u64, 89481610892391u64, 73557415743458u64,
        47818052315863u64, 59022844241315u64, 164132667198270u64, 280243083070380u64,
        16833162625519u64, 2907980068408u64, 236919894056223u64, 18640705908841u64,
        128848543508002u64, 9040139115831u64, 11298915237664u64, 231543743251553u64,
        115210110399910u64, 273278473027818u64, 155297860601710u64, 164507171127339u64,
        270307511656191u64, 170795948204402u64, 53262992924636u64, 134796999654792u64,
        222456695866294u64, 141353257858101u64, 115347994359285u64, 209908707160935u64,
    ];
    let mut v: Vec<u64> = Vec::new();
    let mut i: i32 = 0;
    while i < 1024 {
        v.push(arr[i as usize]);
        i = i + 1;
    }
    v
}

fn blue_at(tbl: &Vec<u64>, x: i32, y: i32) -> f32 {
    let xi: i32 = x & 63;
    let yi: i32 = y & 63;
    let idx: i32 = yi * 64 + xi;
    let word: u64 = tbl[(idx >> 2) as usize];
    let shift: u64 = ((idx & 3) * 12) as u64;
    let rank: i32 = ((word >> shift) & 4095u64) as i32;
    ((rank as f32) + 0.5f32) * (1.0f32 / 4096.0f32)
}

fn fnv_push_f32(h0: u64, v: f32) -> u64 {
    let b: u32 = v.to_bits();
    let mut h: u64 = h0;
    let mut k: u32 = 0;
    while k < 4 {
        h = h ^ (((b >> (8 * k)) & 255u32) as u64);
        h = h.wrapping_mul(1099511628211u64);
        k = k + 1;
    }
    h
}

fn eval_golden(idx: i32, x: i32, y: i32, bn: &Vec<u64>, eps: f32) -> f32 {
    let k: f32 = 1.0f32 / 16.0f32;
    let k2: f32 = 1.0f32 / 32.0f32;
    let xf: f32 = (x as f32) + eps;
    let yf: f32 = y as f32;
    if idx == 0 { return white(x, y, 0, 7u32) + eps; }
    if idx == 1 { return value2(xf * k, yf * k, 7u32); }
    if idx == 2 { return value3(xf * k, yf * k, 0.37f32, 7u32); }
    if idx == 3 { return perlin2(xf * k, yf * k, 7u32); }
    if idx == 4 { return perlin3(xf * k, yf * k, 0.37f32, 7u32); }
    if idx == 5 { return simplex2(xf * k, yf * k, 7u32); }
    if idx == 6 { return simplex3(xf * k, yf * k, 0.37f32, 7u32); }
    if idx == 7 { return worley2(xf * k, yf * k, 7u32).f1; }
    if idx == 8 {
        let c: Cell = worley2(xf * k, yf * k, 7u32);
        return c.f2 - c.f1;
    }
    if idx == 9 { return worley3(xf * k, yf * k, 0.37f32, 7u32).f1; }
    if idx == 10 { return fbm(0, xf * k2, yf * k2, 0.5f32, 7u32); }
    if idx == 11 { return ridged(1, xf * k2, yf * k2, 0.5f32, 7u32); }
    if idx == 12 { return billow(0, xf * k2, yf * k2, 0.5f32, 7u32); }
    if idx == 13 { return hybrid(1, xf * k2, yf * k2, 0.5f32, 7u32); }
    if idx == 14 {
        let w: Warped = warp(xf * k2, yf * k2, 0.5f32, 7u32, 1.2f32);
        return fbm(1, w.x, w.y, w.z, 9u32);
    }
    if idx == 15 { return blue_at(bn, x, y); }
    if idx == 16 {
        let h: f32 = 0.6f32 * fbm(1, xf * k2, yf * k2, 0.2f32, 11u32)
            + 0.4f32 * ridged(1, xf * k2, yf * k2, 0.2f32, 12u32);
        let coast: f32 = 0.18f32 + 0.06f32 * (blue_at(bn, x, y) - 0.5f32);
        if h > coast { return 0.45f32 + 0.55f32 * (h - coast) / (1.0f32 - coast); }
        return 0.15f32 + 0.25f32 * max_f32(0.0f32, h + 0.5f32);
    }
    if idx == 17 {
        let s: f32 = 128.0f32;
        let px: f32 = (xf + 0.5f32) / s * 2.0f32 - 1.0f32;
        let py: f32 = 1.0f32 - (yf + 0.5f32) / s * 2.0f32;
        let r2: f32 = px * px + py * py;
        if r2 >= 0.92f32 { return 0.0f32; }
        let pz: f32 = sqrt_f32(0.92f32 - r2);
        let sc: f32 = 2.5f32;
        let w: Warped = warp(px * sc, py * sc, pz * sc, 21u32, 0.6f32);
        let dotl: f32 = (-0.4f32 * px + 0.5f32 * py + 0.77f32 * pz) / 0.96f32;
        let shade: f32 = 0.35f32 + 0.65f32 * max_f32(0.0f32, dotl);
        return shade * (0.25f32 + 0.75f32 * ridged(1, w.x, w.y, w.z, 22u32));
    }
    if idx == 18 {
        let w: Warped = warp(xf * k2, yf * k2, 0.7f32, 31u32, 1.5f32);
        return 0.9f32 * ridged(0, w.x, w.y, w.z, 32u32) + 0.1f32 * white(x, y, 0, 33u32);
    }
    0.5f32 * ridged(1, xf * k2, yf * k2, 0.9f32, 41u32)
        + 0.3f32 * fbm(0, xf * k2, yf * k2, 0.9f32, 42u32)
        + 0.2f32 * billow(0, xf * k2, yf * k2, 0.9f32, 43u32)
}

pub fn noise_goldens_hash(eps: f64) -> u64 {
    let eps32: f32 = eps as f32;
    let bn: Vec<u64> = blue_noise_packed();
    let mut all: u64 = 1469598103934665603u64;
    let mut idx: i32 = 0;
    while idx < 20 {
        let mut h: u64 = 1469598103934665603u64;
        let mut y: i32 = 0;
        while y < 128 {
            let mut x: i32 = 0;
            while x < 128 {
                h = fnv_push_f32(h, eval_golden(idx, x, y, &bn, eps32));
                x = x + 1;
            }
            y = y + 1;
        }
        all = all ^ h;
        all = all.wrapping_mul(1099511628211u64);
        idx = idx + 1;
    }
    all
}
