//
// Physically based GGX specular BRDF, height-correlated Smith masking-shadowing, Schlick Fresnel,
// Hammersley-VNDF directional albedo (Heitz 2018), and 64-point Gauss-Legendre quadrature,
// ported from src/renderer/brdf.cpp and raw/renderer/brdf.hpp.
// Matches GCC 13.3 and MSVC VS 18 bit for bit.

use kit::V3;
use kit::v3;
use kit::dot;
use kit::cross;
use kit::absd;
use art_prims::maxd;

fn radical_inverse(b0: u32) -> f64 {
    let mut b: u32 = (b0 << 16) | (b0 >> 16);
    b = ((b & 0x55555555) << 1) | ((b & 0xAAAAAAAA) >> 1);
    b = ((b & 0x33333333) << 2) | ((b & 0xCCCCCCCC) >> 2);
    b = ((b & 0x0F0F0F0F) << 4) | ((b & 0xF0F0F0F0) >> 4);
    b = ((b & 0x00FF00FF) << 8) | ((b & 0xFF00FF00) >> 8);
    (b as f64) * 2.3283064365386963e-10
}

fn scale_v3(a: V3, s: f64) -> V3 {
    v3(a.x * s, a.y * s, a.z * s)
}

fn norm_mul(a: V3) -> V3 {
    let l: f64 = sqrt(dot(a, a));
    scale_v3(a, 1.0 / l)
}

fn lambda_ggx(mu: f64, a: f64) -> f64 {
    let m2: f64 = mu * mu;
    let t2: f64 = (1.0 - m2) / m2;
    0.5 * (-1.0 + sqrt(1.0 + a * a * t2))
}

fn ggx_d(mu_h: f64, a: f64) -> f64 {
    let pi: f64 = 3.14159265358979323846;
    let a2: f64 = a * a;
    let d: f64 = mu_h * mu_h * (a2 - 1.0) + 1.0;
    a2 / (pi * d * d)
}

fn smith_g1(mu: f64, a: f64) -> f64 {
    1.0 / (1.0 + lambda_ggx(mu, a))
}

fn smith_g2(mu_o: f64, mu_i: f64, a: f64) -> f64 {
    1.0 / (1.0 + lambda_ggx(mu_o, a) + lambda_ggx(mu_i, a))
}

fn smith_v(mu_o: f64, mu_i: f64, a: f64) -> f64 {
    let a2: f64 = a * a;
    let go: f64 = mu_i * sqrt(mu_o * mu_o * (1.0 - a2) + a2);
    let gi: f64 = mu_o * sqrt(mu_i * mu_i * (1.0 - a2) + a2);
    0.5 / (go + gi)
}

fn schlick_f(f0: f64, voh: f64) -> f64 {
    let m: f64 = 1.0 - voh;
    f0 + (1.0 - f0) * m * m * m * m * m
}

fn albedo_vndf(mu: f64, a: f64, n: i32) -> f64 {
    let pi: f64 = 3.14159265358979323846;
    let v: V3 = v3(sqrt(maxd(0.0, 1.0 - mu * mu)), 0.0, mu);
    let vh: V3 = norm_mul(v3(a * v.x, a * v.y, v.z));
    let lensq: f64 = vh.x * vh.x + vh.y * vh.y;
    let mut t1: V3 = v3(1.0, 0.0, 0.0);
    if lensq > 0.0 {
        t1 = scale_v3(v3(-vh.y, vh.x, 0.0), 1.0 / sqrt(lensq));
    }
    let t2: V3 = cross(vh, t1);
    let g1: f64 = smith_g1(mu, a);
    let mut sum: f64 = 0.0;
    let mut k: i32 = 0;
    while k < n {
        let u1: f64 = ((k as f64) + 0.5) / (n as f64);
        let u2: f64 = radical_inverse(k as u32);
        let r: f64 = sqrt(u1);
        let phi: f64 = 2.0 * pi * u2;
        let s: f64 = 0.5 * (1.0 + vh.z);
        let p1: f64 = r * cos(phi);
        let p2: f64 = (1.0 - s) * sqrt(1.0 - p1 * p1) + s * r * sin(phi);
        let pz: f64 = sqrt(maxd(0.0, 1.0 - p1 * p1 - p2 * p2));
        let nh: V3 = v3(
            t1.x * p1 + t2.x * p2 + vh.x * pz,
            t1.y * p1 + t2.y * p2 + vh.y * pz,
            t1.z * p1 + t2.z * p2 + vh.z * pz,
        );
        let m: V3 = norm_mul(v3(a * nh.x, a * nh.y, maxd(1.0e-12, nh.z)));
        let vom: f64 = dot(v, m);
        let li: f64 = 2.0 * vom * m.z - v.z;
        if li > 0.0 {
            sum = sum + smith_g2(mu, li, a) / g1;
        }
        k = k + 1;
    }
    sum / (n as f64)
}

fn hash_gauss_legendre_64(h0: u64) -> u64 {
    let pi: f64 = 3.14159265358979323846;
    let n: i32 = 64;
    let mut hash: u64 = h0;
    let mut i: i32 = 0;
    while i < n {
        let mut z: f64 = cos(pi * ((i as f64) + 0.75) / ((n as f64) + 0.5));
        let mut pp: f64 = 0.0;
        let mut it: i32 = 0;
        while it < 100 {
            let mut p1: f64 = 1.0;
            let mut p2: f64 = 0.0;
            let mut j: i32 = 1;
            while j <= n {
                let p3: f64 = p2;
                p2 = p1;
                p1 = ((2.0 * (j as f64) - 1.0) * z * p2 - ((j as f64) - 1.0) * p3) / (j as f64);
                j = j + 1;
            }
            pp = (n as f64) * (z * p1 - p2) / (z * z - 1.0);
            let z1: f64 = z;
            z = z1 - p1 / pp;
            if absd(z - z1) < 1.0e-15 {
                it = 100;
            } else {
                it = it + 1;
            }
        }
        let x_i: f64 = 0.5 * (1.0 - z);
        let w_i: f64 = 1.0 / ((1.0 - z * z) * pp * pp);
        hash = kit::fnv_f32(hash, x_i);
        hash = kit::fnv_f32(hash, w_i);
        i = i + 1;
    }
    hash
}

// Evaluates 16 x 16 GGX-VNDF directional albedo (256 samples/cell), 16 x 16 single-scatter
// microfacet lobes (ggxD * smithV * schlickF), and 64-point Gauss-Legendre quadrature, hashed as
// f32 via FNV-1a. rough_eps is 0.0 for the pinned grid and non-zero for the planted control.
pub fn brdf_grid_hash(rough_eps: f64) -> u64 {
    let mut hash: u64 = kit::fnv_start();
    let mut kr: i32 = 1;
    while kr <= 16 {
        let r: f64 = (kr as f64) * 0.0625 + rough_eps;
        let a: f64 = r * r;
        let mut km: i32 = 1;
        while km <= 16 {
            let mu: f64 = (km as f64) * 0.0625;
            hash = kit::fnv_f32(hash, albedo_vndf(mu, a, 256));
            let mu_i: f64 = ((17 - km) as f64) * 0.0625;
            let mu_h: f64 = 0.5 * (mu + mu_i);
            let fss: f64 = ggx_d(mu_h, a) * smith_v(mu, mu_i, a) * schlick_f(0.04, mu_h);
            hash = kit::fnv_f32(hash, fss);
            km = km + 1;
        }
        kr = kr + 1;
    }
    hash_gauss_legendre_64(hash)
}
