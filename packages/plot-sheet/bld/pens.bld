//
// Pen layers. A path the caller gave a pen keeps it. Every other path is clustered by its stroke
// colour into as many groups as there are pens, and the groups are handed to the pens by
// lightness: the darkest group to the darkest pen, and so on up.
//
// The clustering is the site plotter's (upstream/site-3ca6529/system/plotter.js separatePens and
// penSeeds), ported: k-means with fixed seeds (the darkest sample, then the most saturated, then
// the farthest from the seeds so far), at most 16 passes, ties to the lowest index. What is new
// here is the hand-off to named pens and the layer order.

use num::luma;
use num::maxf;
use num::minf;
use sheet::Paths;
use sheet::Spec;
use sheet::path_count;
use sheet::pen_count;
use sheet::O_ORDER;

fn d2(a: Vec<f64>, i: i32, b: Vec<f64>, j: i32) -> f64 {
    let dr: f64 = a[3 * i] - b[3 * j];
    let dg: f64 = a[3 * i + 1] - b[3 * j + 1];
    let db: f64 = a[3 * i + 2] - b[3 * j + 2];
    dr * dr + dg * dg + db * db
}

fn luma_at(c: Vec<f64>, i: i32) -> f64 {
    luma(c[3 * i], c[3 * i + 1], c[3 * i + 2])
}

fn sat_at(c: Vec<f64>, i: i32) -> f64 {
    let hi: f64 = maxf(c[3 * i], maxf(c[3 * i + 1], c[3 * i + 2]));
    let lo: f64 = minf(c[3 * i], minf(c[3 * i + 1], c[3 * i + 2]));
    hi - lo
}

fn has(v: Vec<i32>, x: i32) -> bool {
    let mut i: i32 = 0;
    while i < v.len() as i32 {
        if v[i] == x { return true; }
        i = i + 1;
    }
    false
}

// The sample indices the k-means starts from.
fn seeds(c: Vec<f64>, n: i32, k: i32) -> Vec<i32> {
    let out: Vec<i32> = Vec::new();
    let mut dark: i32 = 0;
    let mut i: i32 = 1;
    while i < n {
        if luma_at(c, i) < luma_at(c, dark) { dark = i; }
        i = i + 1;
    }
    out.push(dark);
    if k > 1 {
        let mut vivid: i32 = 0 - 1;
        let mut best: f64 = 0.0 - 1.0;
        i = 0;
        while i < n {
            if i != dark && sat_at(c, i) > best {
                best = sat_at(c, i);
                vivid = i;
            }
            i = i + 1;
        }
        if vivid >= 0 { out.push(vivid); }
    }
    while (out.len() as i32) < k {
        let mut far_i: i32 = 0 - 1;
        let mut far: f64 = 0.0 - 1.0;
        i = 0;
        while i < n {
            if !has(out, i) {
                let mut near: f64 = 1.0e300;
                let mut s: i32 = 0;
                while s < out.len() as i32 {
                    near = minf(near, d2(c, i, c, out[s]));
                    s = s + 1;
                }
                if near > far {
                    far = near;
                    far_i = i;
                }
            }
            i = i + 1;
        }
        if far_i < 0 { break; }
        out.push(far_i);
    }
    out
}

// One k-means pass: assigns each sample to its nearest centre and moves the centres to the means.
// Returns true when an assignment changed.
fn kmeans_pass(c: Vec<f64>, n: i32, centre: Vec<f64>, k: i32, assign: Vec<i32>) -> bool {
    let mut moved: bool = false;
    let sum: Vec<f64> = Vec::new();
    let mut j: i32 = 0;
    while j < 4 * k {
        sum.push(0.0);
        j = j + 1;
    }
    let mut i: i32 = 0;
    while i < n {
        let mut bi: i32 = 0;
        let mut bd: f64 = 1.0e300;
        j = 0;
        while j < k {
            let d: f64 = d2(c, i, centre, j);
            if d < bd {
                bd = d;
                bi = j;
            }
            j = j + 1;
        }
        if assign[i] != bi {
            assign[i] = bi;
            moved = true;
        }
        sum[4 * bi] = sum[4 * bi] + c[3 * i];
        sum[4 * bi + 1] = sum[4 * bi + 1] + c[3 * i + 1];
        sum[4 * bi + 2] = sum[4 * bi + 2] + c[3 * i + 2];
        sum[4 * bi + 3] = sum[4 * bi + 3] + 1.0;
        i = i + 1;
    }
    j = 0;
    while j < k {
        if sum[4 * j + 3] > 0.0 {
            centre[3 * j] = sum[4 * j] / sum[4 * j + 3];
            centre[3 * j + 1] = sum[4 * j + 1] / sum[4 * j + 3];
            centre[3 * j + 2] = sum[4 * j + 2] / sum[4 * j + 3];
        }
        j = j + 1;
    }
    moved
}

// Indices 0..n ordered by rising luma of colour list c; equal lumas keep their listed order.
fn by_luma(c: Vec<f64>, n: i32) -> Vec<i32> {
    let idx: Vec<i32> = Vec::new();
    let mut i: i32 = 0;
    while i < n {
        idx.push(i);
        let mut j: i32 = i;
        while j > 0 && luma_at(c, idx[j]) < luma_at(c, idx[j - 1]) {
            let t: i32 = idx[j];
            idx[j] = idx[j - 1];
            idx[j - 1] = t;
            j = j - 1;
        }
        i = i + 1;
    }
    idx
}

// Gives a pen to every path that has none.
pub fn assign_pens(p: Paths, s: Spec) {
    let np: i32 = pen_count(s);
    let who: Vec<i32> = Vec::new();
    let c: Vec<f64> = Vec::new();
    let mut i: i32 = 0;
    while i < path_count(p) {
        if p.pen[i] < 0 || p.pen[i] >= np {
            who.push(i);
            c.push(p.rgb[3 * i]);
            c.push(p.rgb[3 * i + 1]);
            c.push(p.rgb[3 * i + 2]);
        }
        i = i + 1;
    }
    let n: i32 = who.len() as i32;
    if n == 0 { return; }
    let k: i32 = if np < n { np } else { n };
    let start: Vec<i32> = seeds(c, n, k);
    let kk: i32 = start.len() as i32;
    let centre: Vec<f64> = Vec::new();
    let assign: Vec<i32> = Vec::new();
    i = 0;
    while i < kk {
        centre.push(c[3 * start[i]]);
        centre.push(c[3 * start[i] + 1]);
        centre.push(c[3 * start[i] + 2]);
        i = i + 1;
    }
    i = 0;
    while i < n {
        assign.push(0);
        i = i + 1;
    }
    let mut pass: i32 = 0;
    while pass < 16 {
        let moved: bool = kmeans_pass(c, n, centre, kk, assign);
        if !moved && pass > 0 { break; }
        pass = pass + 1;
    }
    let group_rank: Vec<i32> = by_luma(centre, kk);
    let pen_rank: Vec<i32> = by_luma(s.pen_rgb, np);
    let pen_of: Vec<i32> = Vec::new();
    i = 0;
    while i < kk {
        pen_of.push(0);
        i = i + 1;
    }
    i = 0;
    while i < kk {
        pen_of[group_rank[i]] = pen_rank[i];
        i = i + 1;
    }
    i = 0;
    while i < n {
        p.pen[who[i]] = pen_of[assign[i]];
        i = i + 1;
    }
}

// The pens in the order their layers are drawn: lightest first, or as listed.
pub fn layer_pens(s: Spec) -> Vec<i32> {
    let np: i32 = pen_count(s);
    let out: Vec<i32> = Vec::new();
    if s.opt[O_ORDER()] == 1.0 {
        let mut i: i32 = 0;
        while i < np {
            out.push(i);
            i = i + 1;
        }
        return out;
    }
    let dark_first: Vec<i32> = by_luma(s.pen_rgb, np);
    let mut j: i32 = np - 1;
    while j >= 0 {
        out.push(dark_first[j]);
        j = j - 1;
    }
    out
}
