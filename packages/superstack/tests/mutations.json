[
 {
  "id": "number-exponent",
  "caught_by": "canonical.json",
  "breaks": "large and tiny floats lose their exponent (C++) or keep exponent form (Python, JS)",
  "py": {
   "find": "return positional(sign, ip, fp, ex)",
   "replace": "return repr(x)"
  },
  "js": {
   "find": "return positional(m[1], m[2], m[3] || '', Number(m[4] || 0));",
   "replace": "return String(x);"
  },
  "cpp": {
   "find": "return positional(sign, ip, fp, exp);",
   "replace": "return positional(sign, ip, fp, exp > 20 || exp < -6 ? 0 : exp);"
  }
 },
