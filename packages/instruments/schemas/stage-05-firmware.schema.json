{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://harperz9.local/hardware-pipeline/schemas/stage-05-firmware.schema.json",
 "title": "Firmware: deterministic, reproducible builds; self-test designed in from the start",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "stage",
  "key",
  "status",
  "inputs",
  "outputs",
  "gate",
  "tools",
  "spec",
  "does_not_prove"
 ],
 "properties": {
  "stage": {
   "const": 5
  },
  "key": {
   "const": "firmware"
  },
  "status": {
   "enum": [
    "paper",
    "built",
    "run",
    "passed",
    "failed",
    "blocked",
    "existing-device"
   ]
  },
  "inputs": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 1
  },
  "outputs": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 1
  },
  "gate": {
   "type": "object",
   "properties": {
    "condition": {
     "type": "string"
    },
    "metric": {
     "type": "string"
    },
    "op": {
     "enum": [
      "<",
      "<=",
      ">",
      ">=",
      "==",
      "in"
     ]
    },
    "threshold": {},
    "measured": {},
    "verdict": {
     "enum": [
      "pass",
      "fail",
      "open",
      "not-applicable"
     ]
    },
    "evidence": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "condition",
    "metric",
    "op",
    "threshold",
    "verdict"
   ],
   "additionalProperties": false
  },
  "tools": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "role": {
      "type": "string"
     },
     "licence": {
      "type": "string"
     },
     "ours": {
      "type": "boolean"
     },
     "lineage": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "role",
     "licence",
     "ours"
    ],
    "additionalProperties": false
   },
   "minItems": 1
  },
  "spec": {
   "type": "object",
   "properties": {
    "platform": {
     "type": "string"
    },
    "toolchain": {
     "type": "object",
     "properties": {
      "name": {
       "type": "string"
      },
      "pinned": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "pinned"
     ],
     "additionalProperties": false
    },
    "reproducible_build": {
     "type": "object",
     "properties": {
      "method": {
       "type": "string"
      },
      "check": {
       "type": "string"
      }
     },
     "required": [
      "method",
      "check"
     ],
     "additionalProperties": false
    },
    "self_tests": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string"
       },
       "check_id": {
        "type": "string"
       },
       "method": {
        "type": "string"
       },
       "pass_condition": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "check_id",
       "method",
       "pass_condition"
      ],
      "additionalProperties": false
     },
     "minItems": 1
    }
   },
   "required": [
    "platform",
    "toolchain",
    "reproducible_build",
    "self_tests"
   ],
   "additionalProperties": false
  },
  "notes": {
   "type": "string"
  },
  "does_not_prove": {
   "type": "string"
  }
 }
}
