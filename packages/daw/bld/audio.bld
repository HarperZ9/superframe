//
// The audio device, through BuildLang's own binding (runtime/audio/bl_audio.c in HarperZ9/buildlang,
// vendored here unchanged and pinned by sha256 in tests/test_native.py). The extern block's `source`
// clause compiles it into this program; no prebuilt library or link flag is involved.
extern "C" source "bl_audio.c" {
    fn bl_audio_open(device: i32, rate: i32, period_frames: i32, silent: i32) -> i32;
    fn bl_audio_pin_performance_cores() -> i32;
    fn bl_audio_rate() -> i32;
    fn bl_audio_period() -> i32;
    fn bl_audio_buffer() -> *mut f64;
    fn bl_audio_alloc(count: usize) -> *mut f64;
    fn bl_audio_wait() -> i32;
    fn bl_audio_write(mono: *mut f64, frames: usize) -> i32;
    fn bl_audio_periods() -> i64;
    fn bl_audio_misses() -> i64;
    fn bl_audio_render_ms_max() -> f64;
    fn bl_audio_render_ms_mean() -> f64;
    fn bl_audio_buffer_ms() -> f64;
    fn bl_audio_stream_latency_ms() -> f64;
    fn bl_audio_loopback_ms(click_level: f64) -> f64;
    fn bl_audio_roundtrip_ms(click_level: f64, threshold: f64) -> f64;
    fn bl_events_start() -> i32;
    fn bl_events_pop(out: *mut f64) -> i32;
    fn bl_audio_now() -> f64;
    fn bl_audio_close();
}
