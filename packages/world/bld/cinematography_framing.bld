//
// Wave 58E (K2 / COL-049): Design-Language Framing, Perspective, Motion-Jerk,
// and Film-Grain Kernel. Verifies rectilinear 36 mm full-frame horizontal FOV
// (24/35/50/85 mm), golden-section compositional balance, bounded cubic-bezier
// motion jerk, luminance-dependent film grain, and catches planted jerk spike
// and reduced_motion violations fail-closed.

fn rectilinear_fov_deg(focal_mm: f64) -> f64 {
    let half: f64 = 18.0 / focal_mm;
    return 2.0 * half.atan() * 57.29577951308232;
}

// 1D cubic Bezier value with P0=0, P1=c1, P2=c2, P3=1
fn bezier_val(t: f64, c1: f64, c2: f64) -> f64 {
    let u: f64 = 1.0 - t;
    return 3.0 * u * u * t * c1 + 3.0 * u * t * t * c2 + t * t * t;
}

// Analytical 3rd derivative (constant jerk) of cubic Bezier over duration dur_s
fn bezier_max_jerk(c1: f64, c2: f64, dur_s: f64) -> f64 {
    let d3_unit: f64 = (6.0 * (1.0 - 3.0 * c2 + 3.0 * c1)).abs();
    return d3_unit / (dur_s * dur_s * dur_s);
}

// Luminance-dependent organic film grain peaking at mid-grey L=0.5
fn film_grain_sigma(luma: f64, iso_scale: f64) -> f64 {
    let bell: f64 = 4.0 * luma * (1.0 - luma);
    return iso_scale * (0.12 + 0.88 * bell);
}

fn audit_motion(c1: f64, c2: f64, dur_s: f64, reduced_motion: i64, motion_amp: f64) -> i64 {
    if reduced_motion == 1 && motion_amp > 0.0 {
        return -302;
    }
    if reduced_motion == 1 {
        return 0;
    }
    let jerk: f64 = bezier_max_jerk(c1, c2, dur_s);
    if jerk > 25.0 {
        return -301;
    }
    return 0;
}

fn main() -> i64 ~ Console {
    let fov24: f64 = rectilinear_fov_deg(24.0);
    let fov35: f64 = rectilinear_fov_deg(35.0);
    let fov50: f64 = rectilinear_fov_deg(50.0);
    let fov85: f64 = rectilinear_fov_deg(85.0);

    // Golden-section balance check: phi = (sqrt(5)-1)/2
    let phi: f64 = (5.0_f64.sqrt() - 1.0) * 0.5;
    let golden_err: f64 = ((1.0 / phi) - (1.0 + phi)).abs();

    // Smooth ease-in-out curve: c1=0.25, c2=0.75 over 0.60 s -> jerk = 13.89 <= 25
    let calm_jerk: f64 = bezier_max_jerk(0.25, 0.75, 0.60);
    let calm_mid: f64 = bezier_val(0.5, 0.25, 0.75);
    let calm_rc: i64 = audit_motion(0.25, 0.75, 0.60, 0, 1.0);
    let red_ok_rc: i64 = audit_motion(0.25, 0.75, 0.60, 1, 0.0);

    // Luminance-dependent grain profile
    let g_dark: f64 = film_grain_sigma(0.05, 0.04);
    let g_mid: f64 = film_grain_sigma(0.50, 0.04);
    let g_hi: f64 = film_grain_sigma(0.95, 0.04);
    let grain_ok: i64 = if g_mid > g_dark && g_mid > g_hi && (g_dark - g_hi).abs() < 1e-12 {
        1
    } else {
        0
    };

    // Planted control 1: motion-sickness jerk spike (snappy 0.15 s overshoot) -> -301
    let spike_jerk: f64 = bezier_max_jerk(0.90, 0.05, 0.15);
    let spike_rc: i64 = audit_motion(0.90, 0.05, 0.15, 0, 1.0);

    // Planted control 2: reduced_motion=1 violated with non-zero motion_amp -> -302
    let red_bad_rc: i64 = audit_motion(0.25, 0.75, 0.60, 1, 0.50);

    println!(
        "FOV_DEG f24={:.4} f35={:.4} f50={:.4} f85={:.4} golden_err={:.16}",
        fov24, fov35, fov50, fov85, golden_err
    );
    println!(
        "MOTION_GRAIN calm_jerk={:.4} mid={:.4} g_mid={:.5} g_dark={:.5}",
        calm_jerk, calm_mid, g_mid, g_dark
    );
    println!(
        "PLANTED_CONTROLS spike_jerk={:.2} spike_rc={} red_bad_rc={}",
        spike_jerk, spike_rc, red_bad_rc
    );

    let fov_ok: i64 = if fov24 > 73.0 && fov24 < 74.0 && fov50 > 39.0 && fov50 < 40.0
        && fov24 > fov35 && fov35 > fov50 && fov50 > fov85 { 1 } else { 0 };
    if fov_ok == 1 && golden_err < 1e-12 && calm_rc == 0 && red_ok_rc == 0
        && grain_ok == 1 && spike_rc == -301 && red_bad_rc == -302 {
        println!(
            "[PASS] K2_CINEMATOGRAPHY fov50={:.4} calm_jerk={:.4} spike_jerk={:.2} planted=2/2",
            fov50, calm_jerk, spike_jerk
        );
        return 0;
    }
    println!("[FAIL] K2_CINEMATOGRAPHY");
    return 1;
}
