//
// A modern reading of the Benson cube, kept apart from the historical kernel in benson.bld.
//
// Assumption, ours and absent from the 1872 book: the red, green and blue lights are taken to be the three
// primaries of an additive display, and a level of k steps out of n is taken to be the fraction k / n of full
// intensity in linear light (light measured in proportion to physical power, before any display encoding).
// Each output is one IEEE 754 double division, so the result has the same bits on every target.
//
// Status codes as in benson.bld: 0 accepted, 1 steps outside 1 to 4096, 2 point outside the cube. The named
// mappings below add 6 for an unknown space or white.
extern "C" fn cm_modern_benson_linear_rgb(n: i64, r: i64, g: i64, b: i64, out: *mut f64) -> i32 {
    if n < 1 || n > 4096 {
        return 1;
    }
    if r < 0 || r > n || g < 0 || g > n || b < 0 || b > n {
        return 2;
    }
    let o = unsafe { slice::from_raw_parts_mut(out, 3) };
    let d = n as f64;
    o[0] = (r as f64) / d;
    o[1] = (g as f64) / d;
    o[2] = (b as f64) / d;
    0
}

// The cube point as CIE XYZ: the fractions above taken as linear RGB of a named space (rgbspace.bld), under
// the chosen white. Status 6 for an unknown space or white.
extern "C" fn cm_modern_benson_xyz(space: i64, white: i64, n: i64, r: i64, g: i64, b: i64, out: *mut f64) -> i32 {
    if n < 1 || n > 4096 {
        return 1;
    }
    if r < 0 || r > n || g < 0 || g > n || b < 0 || b > n {
        return 2;
    }
    let d = n as f64;
    cm_modern_rgb_to_xyz(space, white, (r as f64) / d, (g as f64) / d, (b as f64) / d, out)
}

// The cube point as encoded RGB of a named space: each fraction passed through the transfer function of the
// space (transfer.bld). Status 6 for an unknown space.
extern "C" fn cm_modern_benson_encoded(space: i64, n: i64, r: i64, g: i64, b: i64, out: *mut f64) -> i32 {
    if n < 1 || n > 4096 {
        return 1;
    }
    if r < 0 || r > n || g < 0 || g > n || b < 0 || b > n {
        return 2;
    }
    if space < 0 || space > 2 {
        return 6;
    }
    let d = n as f64;
    let o = unsafe { slice::from_raw_parts_mut(out, 3) };
    // cm_modern_encode writes out[0], so blue and green are encoded first and moved to their places.
    cm_modern_encode(space, (b as f64) / d, out);
    o[2] = o[0];
    cm_modern_encode(space, (g as f64) / d, out);
    o[1] = o[0];
    cm_modern_encode(space, (r as f64) / d, out);
    0
}
