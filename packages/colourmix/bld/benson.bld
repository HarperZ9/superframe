//
// The colour cube of William Benson (Principles of the Science of Colour, 1868 and 1872). See docs/BENSON.md.
//
// A colour is a count of equal steps of three lights: red, green, blue, each from 0 (nil) to n (full
// intensity). Black is (0, 0, 0) and white is (n, n, n). The coloured plate shows n = 2: nil, half, full.
//
// Status codes: 0 accepted, 1 steps outside 1 to 4096, 2 point outside the cube, 3 axis outside 0 to 2,
// 4 the requested point of a line is not on the lattice. A rejected call writes nothing.

fn cm_steps_ok(n: i64) -> bool {
    n >= 1 && n <= 4096
}

fn cm_level_ok(n: i64, v: i64) -> bool {
    v >= 0 && v <= n
}

// Number of lattice points in the cube, or -1 when n is rejected.
extern "C" fn cm_benson_count(n: i64) -> i64 {
    if !cm_steps_ok(n) {
        return -1;
    }
    (n + 1) * (n + 1) * (n + 1)
}

// A section at right angles to a primary axis: the light `axis` (0 red, 1 green, 2 blue) is held at `level`
// and u, v are the levels of the other two lights in red, green, blue order. Writes red, green, blue.
extern "C" fn cm_benson_section(n: i64, axis: i64, level: i64, u: i64, v: i64, out: *mut i64) -> i32 {
    if !cm_steps_ok(n) {
        return 1;
    }
    if axis < 0 || axis > 2 {
        return 3;
    }
    if !cm_level_ok(n, level) || !cm_level_ok(n, u) || !cm_level_ok(n, v) {
        return 2;
    }
    let o = unsafe { slice::from_raw_parts_mut(out, 3) };
    if axis == 0 {
        o[0] = level;
        o[1] = u;
        o[2] = v;
    } else if axis == 1 {
        o[0] = u;
        o[1] = level;
        o[2] = v;
    } else {
        o[0] = u;
        o[1] = v;
        o[2] = level;
    }
    0
}

// The complementary colour: the point that adds with (r, g, b) to white.
extern "C" fn cm_benson_complement(n: i64, r: i64, g: i64, b: i64, out: *mut i64) -> i32 {
    if !cm_steps_ok(n) {
        return 1;
    }
    if !cm_level_ok(n, r) || !cm_level_ok(n, g) || !cm_level_ok(n, b) {
        return 2;
    }
    let o = unsafe { slice::from_raw_parts_mut(out, 3) };
    o[0] = n - r;
    o[1] = n - g;
    o[2] = n - b;
    0
}

// The letter Benson gives a corner, as its ASCII code: Z black, R red, G green, B blue, Y yellow,
// S sea-green, P pink, W white. Returns 0 for a point that is not a corner and -1 when the input is rejected.
extern "C" fn cm_benson_corner(n: i64, r: i64, g: i64, b: i64) -> i64 {
    if !cm_steps_ok(n) || !cm_level_ok(n, r) || !cm_level_ok(n, g) || !cm_level_ok(n, b) {
        return -1;
    }
    if (r != 0 && r != n) || (g != 0 && g != n) || (b != 0 && b != n) {
        return 0;
    }
    let code = r / n * 4 + g / n * 2 + b / n;
    if code == 0 {
        return 90;
    }
    if code == 1 {
        return 66;
    }
    if code == 2 {
        return 71;
    }
    if code == 3 {
        return 83;
    }
    if code == 4 {
        return 82;
    }
    if code == 5 {
        return 80;
    }
    if code == 6 {
        return 89;
    }
    87
}

// One coordinate of the point k steps along a line of `steps` equal steps from a to b; -1 when it falls
// between lattice points. The caller has checked every input.
fn cm_line_coord(a: i64, b: i64, steps: i64, k: i64) -> i64 {
    let num = (b - a) * k;
    if num % steps != 0 {
        return -1;
    }
    a + num / steps
}

// Point k (0 to steps) of the straight line from lattice point a to lattice point b, cut into `steps` equal
// steps. ends holds a red, a green, a blue, b red, b green, b blue. Writes red, green, blue.
extern "C" fn cm_benson_line(n: i64, ends: *const i64, steps: i64, k: i64, out: *mut i64) -> i32 {
    if !cm_steps_ok(n) {
        return 1;
    }
    if !cm_steps_ok(steps) || k < 0 || k > steps {
        return 4;
    }
    let e = unsafe { slice::from_raw_parts(ends, 6) };
    let mut i: usize = 0;
    while i < 6 {
        if !cm_level_ok(n, e[i]) {
            return 2;
        }
        i = i + 1;
    }
    let r = cm_line_coord(e[0], e[3], steps, k);
    let g = cm_line_coord(e[1], e[4], steps, k);
    let b = cm_line_coord(e[2], e[5], steps, k);
    if r < 0 || g < 0 || b < 0 {
        return 4;
    }
    let o = unsafe { slice::from_raw_parts_mut(out, 3) };
    o[0] = r;
    o[1] = g;
    o[2] = b;
    0
}
