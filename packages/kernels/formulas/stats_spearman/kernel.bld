//
// stats.spearman/1 (registry row STA-008): Spearman's rank correlation with mid-ranks for ties.
//
//   in   a [1], 2 to 1,000,000 finite values, not all equal
//        b [1], as many finite values as a, not all equal
//   out  rho [1]
//   loss monotone association only; a constant input is refused
//
// Ranks come from a stable merge sort; tied values share the mean of the ranks they span. rho is the Pearson
// correlation of the ranks about the exact mean (n + 1) / 2, summed in index order, clamped to -1 and 1
// against rounding only.
//
// Status: 0 accepted, 1 a is refused, 2 b is refused.

mod shared;

fn fk_sp_finite(x: f64) -> bool {
    x - x == 0.0
}

// True when every one of the n values is finite and they are not all equal.
fn fk_sp_usable(x: &[f64], n: i64) -> bool {
    let mut i: i64 = 0;
    while i < n {
        if !fk_sp_finite(x[i as usize]) {
            return false;
        }
        i = i + 1;
    }
    i = 1;
    while i < n {
        if x[i as usize] != x[0] {
            return true;
        }
        i = i + 1;
    }
    false
}

fn fk_sp_midranks(x: &[f64], n: i64) -> Vec<f64> {
    let order = stable_order(x, n);
    let mut ranks: Vec<f64> = Vec::new();
    let mut k: i64 = 0;
    while k < n {
        ranks.push(0.0);
        k = k + 1;
    }
    let mut i: i64 = 0;
    while i < n {
        let mut j = i;
        while j + 1 < n && x[order[(j + 1) as usize] as usize] == x[order[i as usize] as usize] {
            j = j + 1;
        }
        let r = ((i as f64) + (j as f64)) / 2.0 + 1.0;
        let mut t = i;
        while t <= j {
            ranks[order[t as usize] as usize] = r;
            t = t + 1;
        }
        i = j + 1;
    }
    ranks
}

extern "C" fn fk_stats_spearman(pa: *const f64, na: i64, pb: *const f64, nb: i64, out: *mut f64) -> i32 {
    if na < 2 || na > 1000000 {
        return 1;
    }
    let a = unsafe { slice::from_raw_parts(pa, na as usize) };
    if !fk_sp_usable(a, na) {
        return 1;
    }
    if nb != na {
        return 2;
    }
    let b = unsafe { slice::from_raw_parts(pb, nb as usize) };
    if !fk_sp_usable(b, nb) {
        return 2;
    }
    let ra = fk_sp_midranks(a, na);
    let rb = fk_sp_midranks(b, nb);
    let mean = ((na as f64) + 1.0) / 2.0;
    let mut sxy: f64 = 0.0;
    let mut sxx: f64 = 0.0;
    let mut syy: f64 = 0.0;
    let mut i: i64 = 0;
    while i < na {
        let dx = ra[i as usize] - mean;
        let dy = rb[i as usize] - mean;
        sxy = sxy + dx * dy;
        sxx = sxx + dx * dx;
        syy = syy + dy * dy;
        i = i + 1;
    }
    let mut r = sxy / sqrt(sxx * syy);
    if r > 1.0 {
        r = 1.0;
    }
    if r < -1.0 {
        r = -1.0;
    }
    let o = unsafe { slice::from_raw_parts_mut(out, 1) };
    o[0] = r;
    0
}
