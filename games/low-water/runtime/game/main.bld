//
// Low Water's native game code, milestone N0: one terrain tile and a walking capsule.
//
// This file is the game side of the native shell. `buildc build --emit staticlib` turns it into a
// static library and a C header (main.h); the engine's shell (native/app/lw_shell_main.cpp) links
// both and calls the functions below over the C ABI. The engine owns the window, the input
// devices, the GPU and the clock; this file owns everything the player's state depends on.
//
// Determinism. The simulation advances in fixed ticks of 1/60 s. Input crosses as integers, so a
// recorded input trace replays to the same state on any machine. The arithmetic is the rule of
// design/DETMATH.md: + - * / sqrt and comparisons only, no libm, so the bits do not depend on a
// C library. The heading turns by a fifth-order polynomial of a small angle, then renormalises.
//
// The ground. Vertex (i, j) of the tile stands at (i * cell, height, j * cell). Each cell is two
// triangles split on the diagonal from (i + 1, j) to (i, j + 1). `lw_game_ground` interpolates on
// that triangle, and the renderer's vertex shader draws the same triangles from the same heights,
// so the feet stand on the surface that is drawn.

// ---------------------------------------------------------------- the C ABI types

// One tick of input. Sticks and the turn axis run from -1000 to 1000. Buttons: bit 0 jump,
// bit 1 run.
#[repr(C)]
struct LwInput {
    move_x: i32,
    move_y: i32,
    turn: i32,
    buttons: i32,
}

// What the renderer needs from the state after a tick. Feet position, velocity, heading, the
// stub camera's eye and target, and whether the capsule stands on the ground.
#[repr(C)]
struct LwView {
    x: f64,
    y: f64,
    z: f64,
    vx: f64,
    vy: f64,
    vz: f64,
    hx: f64,
    hz: f64,
    eye_x: f64,
    eye_y: f64,
    eye_z: f64,
    at_x: f64,
    at_y: f64,
    at_z: f64,
    grounded: i32,
    tick: i32,
}

struct Game {
    w: i64,
    h: i64,
    cell: f64,
    heights: Vec<f64>,
    x: f64,
    y: f64,
    z: f64,
    vx: f64,
    vy: f64,
    vz: f64,
    hx: f64,
    hz: f64,
    grounded: bool,
    tick: i64,
    blocked: i64,
}

// ---------------------------------------------------------------- constants

fn dt() -> f64 { 1.0 / 60.0 }
fn walk_speed() -> f64 { 2.2 }
fn run_speed() -> f64 { 7.0 }
fn turn_rate() -> f64 { 2.4 }
fn gravity() -> f64 { 9.81 }
fn jump_speed() -> f64 { 4.6 }
fn radius() -> f64 { 0.35 }
fn capsule_height() -> f64 { 1.8 }
// A step is refused when the ground rises more than this much per metre walked (about 50 degrees).
fn max_climb() -> f64 { 1.2 }
// Ground this far below the feet is still stood on while walking downhill.
fn snap_down() -> f64 { 0.6 }

static mut LAST_ERROR: i32 = 0;

// ---------------------------------------------------------------- the tile

fn is_space(c: u8) -> bool { c == 32 || c == 10 || c == 13 || c == 9 }

// The next unsigned decimal in the text at *at, skipping white space and '#' comments.
// -1 when the text ends first.
fn next_uint(p: *const u8, n: usize, at: *mut usize) -> i64 ~ Foreign {
    let bytes = unsafe { slice::from_raw_parts(p, n) };
    let mut i: usize = unsafe { *at };
    while i < n {
        let c = bytes[i];
        if c == 35 {
            while i < n && bytes[i] != 10 { i = i + 1; }
        } else if is_space(c) {
            i = i + 1;
        } else {
            break;
        }
    }
    if i >= n {
        unsafe { *at = i; }
        return -1;
    }
    let mut v: i64 = 0;
    let mut digits = 0;
    while i < n && bytes[i] >= 48 && bytes[i] <= 57 {
        v = v * 10 + ((bytes[i] - 48) as i64);
        i = i + 1;
        digits = digits + 1;
    }
    unsafe { *at = i; }
    if digits == 0 { return -1; }
    v
}

// A plain PGM (P2) of 16-bit height codes, code = (metres + 512) x 16, as the world generator
// writes them (games/low-water/world/gen/out.bld).
fn parse_tile(p: *const u8, n: usize, cell: f64) -> Game ~ Foreign {
    let mut g = Game {
        w: 0, h: 0, cell: cell, heights: Vec::new(),
        x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, hx: 0.0, hz: 1.0,
        grounded: false, tick: 0, blocked: 0,
    };
    let bytes = unsafe { slice::from_raw_parts(p, n) };
    if n < 2 || bytes[0] != 80 || bytes[1] != 50 {
        unsafe { LAST_ERROR = 1; }
        return g;
    }
    let mut at: usize = 2;
    let w = next_uint(p, n, &mut at as *mut usize);
    let h = next_uint(p, n, &mut at as *mut usize);
    let maxv = next_uint(p, n, &mut at as *mut usize);
    if w < 2 || h < 2 || maxv != 65535 {
        unsafe { LAST_ERROR = 2; }
        return g;
    }
    let count = w * h;
    let mut k: i64 = 0;
    while k < count {
        let code = next_uint(p, n, &mut at as *mut usize);
        if code < 0 {
            unsafe { LAST_ERROR = 3; }
            return g;
        }
        g.heights.push((code as f64) / 16.0 - 512.0);
        k = k + 1;
    }
    g.w = w;
    g.h = h;
    g
}

fn vertex(g: &Game, i: i64, j: i64) -> f64 {
    let mut a = i;
    let mut b = j;
    if a < 0 { a = 0; }
    if b < 0 { b = 0; }
    if a > g.w - 1 { a = g.w - 1; }
    if b > g.h - 1 { b = g.h - 1; }
    g.heights[(b * g.w + a) as usize]
}

// Height of the drawn surface at (x, z), in metres.
fn ground(g: &Game, x: f64, z: f64) -> f64 {
    let u = x / g.cell;
    let v = z / g.cell;
    let mut i = floor(u) as i64;
    let mut j = floor(v) as i64;
    if i < 0 { i = 0; }
    if j < 0 { j = 0; }
    if i > g.w - 2 { i = g.w - 2; }
    if j > g.h - 2 { j = g.h - 2; }
    let fx = u - (i as f64);
    let fz = v - (j as f64);
    let h00 = vertex(g, i, j);
    let h10 = vertex(g, i + 1, j);
    let h01 = vertex(g, i, j + 1);
    let h11 = vertex(g, i + 1, j + 1);
    if fx + fz <= 1.0 {
        return h00 + fx * (h10 - h00) + fz * (h01 - h00);
    }
    h11 + (1.0 - fx) * (h01 - h11) + (1.0 - fz) * (h10 - h11)
}

fn clampd(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo { return lo; }
    if x > hi { return hi; }
    x
}

// ---------------------------------------------------------------- the step

// Turn the heading by angle a (|a| <= 0.05 rad a tick), with no libm.
fn turn(g: &mut Game, a: f64) {
    let a2 = a * a;
    let s = a * (1.0 - a2 / 6.0 * (1.0 - a2 / 20.0));
    let c = 1.0 - a2 / 2.0 * (1.0 - a2 / 12.0);
    let nx = g.hx * c + g.hz * s;
    let nz = g.hz * c - g.hx * s;
    let l = sqrt(nx * nx + nz * nz);
    g.hx = nx / l;
    g.hz = nz / l;
}

// Move horizontally by (dx, dz) unless the ground rises too steeply; true when the move stood.
fn try_move(g: &mut Game, dx: f64, dz: f64) -> bool {
    let lo = radius();
    let hix = (g.w - 1) as f64 * g.cell - radius();
    let hiz = (g.h - 1) as f64 * g.cell - radius();
    let nx = clampd(g.x + dx, lo, hix);
    let nz = clampd(g.z + dz, lo, hiz);
    let run = sqrt((nx - g.x) * (nx - g.x) + (nz - g.z) * (nz - g.z));
    if run == 0.0 { return false; }
    let rise = ground(g, nx, nz) - ground(g, g.x, g.z);
    if g.grounded && rise > max_climb() * run {
        return false;
    }
    g.x = nx;
    g.z = nz;
    true
}

fn step(g: &mut Game, inp: LwInput) {
    let mx = (clampd(inp.move_x as f64, -1000.0, 1000.0)) / 1000.0;
    let my = (clampd(inp.move_y as f64, -1000.0, 1000.0)) / 1000.0;
    let tr = (clampd(inp.turn as f64, -1000.0, 1000.0)) / 1000.0;
    turn(g, tr * turn_rate() * dt());

    // Stick: y forward along the heading, x to the right of it.
    let mut sx = mx;
    let mut sy = my;
    let len = sqrt(sx * sx + sy * sy);
    if len > 1.0 {
        sx = sx / len;
        sy = sy / len;
    }
    let mut speed = walk_speed();
    if (inp.buttons & 2) != 0 { speed = run_speed(); }
    // right of heading (hx, hz) is (hz, -hx) in a left-handed y-up frame seen from above
    let wx = (g.hx * sy + g.hz * sx) * speed;
    let wz = (g.hz * sy - g.hx * sx) * speed;
    g.vx = wx;
    g.vz = wz;

    if g.grounded && (inp.buttons & 1) != 0 {
        g.vy = jump_speed();
        g.grounded = false;
    }
    if !g.grounded {
        g.vy = g.vy - gravity() * dt();
    }

    let dx = g.vx * dt();
    let dz = g.vz * dt();
    if !try_move(g, dx, dz) {
        // slide along whichever axis still stands
        let a = try_move(g, dx, 0.0);
        let b = try_move(g, 0.0, dz);
        if !a && !b && (dx != 0.0 || dz != 0.0) { g.blocked = g.blocked + 1; }
    }

    let floor_y = ground(g, g.x, g.z);
    let ny = g.y + g.vy * dt();
    if g.grounded {
        if floor_y >= g.y - snap_down() {
            g.y = floor_y;
            g.vy = 0.0;
        } else {
            g.grounded = false;
            g.y = ny;
        }
    } else if ny <= floor_y {
        g.y = floor_y;
        g.vy = 0.0;
        g.grounded = true;
    } else {
        g.y = ny;
    }
    g.tick = g.tick + 1;
}

// ---------------------------------------------------------------- the hash

fn fnv(h0: u64, bits: u64) -> u64 {
    let mut h: u64 = h0;
    let mut k: u64 = 0;
    while k < 8 {
        h = h ^ ((bits >> (8 * k)) & 255);
        h = h.wrapping_mul(1099511628211);
        k = k + 1;
    }
    h
}

fn state_hash(g: &Game) -> u64 {
    let mut h: u64 = 14695981039346656037;
    h = fnv(h, g.x.to_bits());
    h = fnv(h, g.y.to_bits());
    h = fnv(h, g.z.to_bits());
    h = fnv(h, g.vx.to_bits());
    h = fnv(h, g.vy.to_bits());
    h = fnv(h, g.vz.to_bits());
    h = fnv(h, g.hx.to_bits());
    h = fnv(h, g.hz.to_bits());
    let mut gr: u64 = 0;
    if g.grounded { gr = 1; }
    h = fnv(h, gr);
    h = fnv(h, g.tick as u64);
    h = fnv(h, g.blocked as u64);
    h
}

// ---------------------------------------------------------------- the C ABI

// A game on the tile in `pgm` (n bytes of P2 text), cells `cell` metres apart, the capsule
// standing at the tile's centre facing +z. Null when the text is not a 16-bit P2 image;
// lw_game_last_error says why (1 not P2, 2 bad header, 3 too few values).
extern "C" fn lw_game_create(pgm: *const u8, n: usize, cell: f64) -> *mut Game ~ Foreign {
    unsafe { LAST_ERROR = 0; }
    let mut g = parse_tile(pgm, n, cell);
    if g.w == 0 {
        return 0 as *mut Game;
    }
    g.x = ((g.w - 1) as f64) * g.cell * 0.5;
    g.z = ((g.h - 1) as f64) * g.cell * 0.5;
    g.y = ground(&g, g.x, g.z);
    g.grounded = true;
    let b = Box::new(g);
    b as *mut Game
}

extern "C" fn lw_game_last_error() -> i32 ~ Foreign {
    unsafe { LAST_ERROR }
}

extern "C" fn lw_game_destroy(g: *mut Game) ~ Foreign {
    if g as usize == 0 { return; }
    unsafe { free(g as *mut u8); }
}

extern "C" fn lw_game_width(g: *const Game) -> i32 ~ Foreign {
    unsafe { (*g).w as i32 }
}

extern "C" fn lw_game_depth(g: *const Game) -> i32 ~ Foreign {
    unsafe { (*g).h as i32 }
}

extern "C" fn lw_game_cell(g: *const Game) -> f64 ~ Foreign {
    unsafe { (*g).cell }
}

// The height of vertex (i, j), for the renderer's height buffer.
extern "C" fn lw_game_vertex(g: *const Game, i: i32, j: i32) -> f64 ~ Foreign {
    unsafe { vertex(&*g, i as i64, j as i64) }
}

extern "C" fn lw_game_ground(g: *const Game, x: f64, z: f64) -> f64 ~ Foreign {
    unsafe { ground(&*g, x, z) }
}

extern "C" fn lw_game_step(g: *mut Game, inp: LwInput) ~ Foreign {
    unsafe { step(&mut *g, inp); }
}

extern "C" fn lw_game_hash(g: *const Game) -> u64 ~ Foreign {
    unsafe { state_hash(&*g) }
}

// The stub camera: behind and above the capsule along its heading, looking at its chest. The
// camera and player work in world/ replaces it when it lands on main.
extern "C" fn lw_game_view(g: *const Game, out: *mut LwView) ~ Foreign {
    unsafe {
        let s = &*g;
        (*out).x = s.x;
        (*out).y = s.y;
        (*out).z = s.z;
        (*out).vx = s.vx;
        (*out).vy = s.vy;
        (*out).vz = s.vz;
        (*out).hx = s.hx;
        (*out).hz = s.hz;
        let back = 7.0;
        let ex = s.x - s.hx * back;
        let ez = s.z - s.hz * back;
        let mut ey = s.y + 3.0;
        let floor_at_eye = ground(s, ex, ez) + 1.0;
        if ey < floor_at_eye { ey = floor_at_eye; }
        (*out).eye_x = ex;
        (*out).eye_y = ey;
        (*out).eye_z = ez;
        (*out).at_x = s.x;
        (*out).at_y = s.y + 1.2;
        (*out).at_z = s.z;
        let mut gr = 0;
        if s.grounded { gr = 1; }
        (*out).grounded = gr;
        (*out).tick = s.tick as i32;
    }
}

extern "C" {
    fn free(p: *mut u8);
}
