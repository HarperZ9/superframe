hotspot: "The guild hall" -> gut3.steward {at: 1.0 0 0, r: 0.9}
hotspot: "Shadwell's smokehouse" -> gut3.smoke {at: -4.0 0 -1.2, r: 0.9}
hotspot: "Back to the quay" -> quay3.hub {at: 14 0 0, r: 1.0}
