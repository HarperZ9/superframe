hotspot: "Out to the Gut" -> gut3.hub {at: 2.2 0 0.9, r: 0.7}
figure: shadwell {at: 1.6 0 -1.4, face: -1, when: clock < 03:30}
figure: shadwell {at: -1.4 0 1.2, face: 1, pose: seated, when: clock >= 03:30}

@area a3.hill
