@area a3.mole
name: The mole
plate: mole
place: mole
spawn: 28.0 0.35 -2.6
camera: 1.9
hotspot: "Along the mole" -> mole3.hub {at: 30.0 0.35 -2.0, r: 1.6}
hotspot: "The KEEPER door, and the stairs" -> mole3.stairs {at: 34.1 0.35 -1.1, r: 0.9}
hotspot: "Back to the quay" -> quay3.hub {at: 26.5 0.35 -3, r: 1.2}
