# Low Water, Act 3: the walkable plates wired to the script's places, as wiring/act2-areas.lwd: the
# second daylight page on the day plates, then the gale on the night plates with Act 3's own hubs.
# Coordinates from content/<plate>/place.json marks; cameras set so a person stands about 136 px at
# 1080p (design/CAMERA.md, 2026-10-21). People by design/ACT3-PLAN.md's beats. The Old Light and the
# eye's water have no plate yet and show their place card. Loaded by the shell (ui/app.mjs
# content=act3). 2026-10-21.

# ---------------------------------------------------------------- the second daylight page
@area a3.day_room
name: The room above the Brine, by day
plate: room_day
variant: day
place: day2_room
spawn: -0.51 0 0.39
camera: 0.5
hotspot: "Down through the bar to the quay" -> day2.hub {at: -0.4 0 1.1, r: 0.8}

@area a3.day_quay
name: Lamp Quay, by day
plate: quay_day
variant: day
place: day2_quay
spawn: -1.2 0 -2.6
camera: 2.66
hotspot: "Look along the quay" -> day2.hub {at: 0.2 0 -1.4, r: 1.2}
hotspot: "Out along the mole, where Wenna is" -> day2.wenna.go {at: 26.5 0.35 -3, r: 1.4}
hotspot: "The weigh-house, where Pip minds the tube" -> day2.pip.go {at: 3.3 0 -2.5, r: 1.0}

@area a3.day_mole
name: The mole, by day
plate: mole_day
variant: day
place: day2_mole
spawn: 28.0 0.35 -2.6
camera: 1.9
hotspot: "Back along the mole to the quay" -> day2.hub {at: 26.5 0.35 -3, r: 1.4}
figure: wenna {at: 31.5 0.35 -2.2, face: 1, wander: 1.0, when: clock < 16:30}

@area a3.day_weigh
name: The weigh-house, by day
plate: weigh_day
variant: day
place: day2_tube
spawn: 3.0 0 -3.6
camera: 0.85
hotspot: "Back out to the quay" -> day2.hub {at: 3.4 0 -4.2, r: 0.8}
figure: pip {at: -4.6 0 -3.1, face: 1}

# ---------------------------------------------------------------- the gale
@area a3.quay
name: Lamp Quay
plate: quay
variant: night
variant: dawn ? clock >= 05:50
variant: rain ? rain > 0.5
place: quay
places: steps mole_steps weigh_out
spawn: -1.2 0 -2.6
camera: 2.66
hotspot: "Look along the quay" -> quay3.hub {at: 0.2 0 -1.4, r: 1.2}
hotspot: "The Brine" -> brine3.hub {at: -6.6 0 -1.8, r: 1.1}
hotspot: "The weigh-house" -> weigh3.hub {at: 3.3 0 -2.5, r: 1.0}
hotspot: "Along the mole" -> mole3.hub {at: 33.0 0.35 -1.6, r: 1.6}
figure: hobb {at: 3.83 0 -2.42, face: 1, when: clock < 06:00}
figure: cockle {at: 24.0 0 -2.6, face: 1, wander: 1.2, when: clock < 00:15}

@area a3.harbour
name: The harbour office
plate: office
place: harbour
spawn: 1.78 0 -0.97
camera: 0.55
hotspot: "Back out to the quay" -> quay3.hub {at: 2.2 0 -1.35, r: 0.8}

@area a3.brine
name: The Brine
plate: brine
variant: night
variant: wethour ? clock >= 05:30
place: brine
places: oven
spawn: 4.9 0 1.2
camera: 0.78
hotspot: "The bar" -> brine3.hub {at: -1.0 0 -1.8, r: 1.4}
hotspot: "Out to the quay" -> quay3.hub {at: 5.3 0 1.4, r: 0.8}
figure: sabine {at: -1.0 0 -1.9, face: 1, wander: 1.2}
figure: marrow {at: -1.18 0 0.29, face: -1, when: clock >= 05:30}
figure: spratt {at: 1.57 0 0.29, face: -1, when: clock >= 05:30}
figure: keel {at: 3.07 0 -0.46, face: -1, when: clock >= 05:30}
figure: fennick {at: -3.1 0 0.39, face: 1, pose: seated, when: clock >= 05:30}
figure: penhallow {at: -5.0 0 1.3, face: 1, pose: seated, when: clock >= 05:30}

@area a3.weigh
