// River lines and the hydrology check. A line starts where a river cell has no river cell above
// it and follows receivers until the sea, a lake, or a line already drawn.

// Trace every river. pts holds cell indices end to end; off[i] is where line i starts
// (off has one more entry than there are lines); ends[i] is 0 sea, 1 lake, 2 joins another line.
pub fn trace(riv: Vec<i64>, rcv: Vec<i64>, sea: Vec<i64>, lake: Vec<i64>, w: i64, hh: i64, pts: Vec<i64>, off: Vec<i64>, ends: Vec<i64>) -> i64 {
    let n = (w * hh) as usize;
    let mut above: Vec<i64> = Vec::new();
    let mut seen: Vec<i64> = Vec::new();
    let mut c: usize = 0;
    while c < n {
        above.push(0);
        seen.push(0);
        c += 1;
    }
    c = 0;
    while c < n {
        if riv[c] > 0 && rcv[c] >= 0 {
            let r = rcv[c] as usize;
            above[r] = above[r] + 1;
        }
        c += 1;
    }
    let mut lines: i64 = 0;
    c = 0;
    while c < n {
        if riv[c] > 0 && above[c] == 0 {
            off.push(pts.len() as i64);
            let mut cur = c as i64;
            let mut end: i64 = -1;
            while end < 0 {
                pts.push(cur);
                let cu = cur as usize;
                if sea[cu] == 1 {
                    end = 0;
                } else if lake[cu] > 0 {
                    end = 1;
                } else if seen[cu] == 1 {
                    end = 2;
                } else {
                    seen[cu] = 1;
                    cur = rcv[cu];
                    if cur < 0 { end = 0; }
                }
            }
            ends.push(end);
            lines += 1;
        }
        c += 1;
    }
    off.push(pts.len() as i64);
    lines
}

// The check: along every line the water surface never rises, and the line ends in the sea, in a
// lake or on another line. Returns the number of faults; the first is described in `first`.
pub fn check(surface: Vec<f64>, pts: Vec<i64>, off: Vec<i64>, ends: Vec<i64>, first: Vec<i64>) -> i64 {
    let mut faults: i64 = 0;
    let mut i: usize = 0;
    while i + 1 < off.len() {
        let a = off[i] as usize;
        let b = off[i + 1] as usize;
        let mut k = a + 1;
        while k < b {
            if surface[pts[k] as usize] > surface[pts[k - 1] as usize] + 0.03125 {
                if faults == 0 {
                    first.push(i as i64);
                    first.push((k - a) as i64);
                    first.push(pts[k]);
                }
                faults += 1;
            }
            k += 1;
        }
        if ends[i] < 0 || ends[i] > 2 { faults += 1; }
        i += 1;
    }
    faults
}
