// The combat world's data, as the JS sim keeps it (combat/sim/*.mjs). Numbers
// are f64 as in JS. A JS null string is "" here. Where the JS object gains keys
// as the fight runs (a fighter's `seq`, a brain's `pur`), the struct keeps the
// order the keys were first set, so the world hash sees the same JSON text.

struct Win {
    has: bool,
    a: f64,
    b: f64,
    n: f64,
}

struct HitVol {
    arc0: f64,
    arc1: f64,
    r0: f64,
    r1: f64,
    y0: f64,
    y1: f64,
    at0: f64,
    at1: f64,
}

struct Root {
    a: f64,
    b: f64,
    s: f64,
}

struct Proj {
    speed: f64,
    mass: f64,
    dmg: f64,
    poise: f64,
    r: f64,
    has_light: bool,
    light_r: f64,
    light_k: f64,
    light_frames: f64,
    knockdown: bool,
    parryable: bool,
    blockable: bool,
    blind: f64,
    knock: f64,
    hitstop: f64,
    shake: f64,
    has_up: bool,
    up: f64,
    snare: bool,
}

struct Move {
    id: str,
    kind: str,
    startup: f64,
    active: f64,
    recovery: f64,
    total: f64,
    stamina: f64,
    dmg: f64,
    poise: f64,
    hits: Vec<HitVol>,
    root: Vec<Root>,
    iframes: Win,
    armor: Win,
    parry: Win,
    cancel_keys: Vec<str>,
    cancel_wins: Vec<Win>,
    next_keys: Vec<str>,
    next_ids: Vec<str>,
    track: f64,
    track_until: f64,
    hitstop: f64,
    knock: f64,
    shake: f64,
    dir: str,
    parryable: bool,
    has_tell: bool,
    tell_kind: str,
    has_charge: bool,
    charge_at: f64,
    charge_max: f64,
    charge_min: f64,
    charge_into: str,
    has_item: bool,
    item_use: str,
    item_heal: f64,
    has_proj: bool,
    proj: Proj,
    then: str,
    knockdown: bool,
    shove: bool,
    grapple: bool,
    blockable: bool,
    guard_break: bool,
    toward: str,
    takedown: bool,
    has_tap: bool,
    tap_before: f64,
    tap_into: str,
    composure: f64,
    pierce: bool,
    through: bool,
    snare: bool,
    reset_read: bool,
    behind: bool,
    has_shout: bool,
    shout_r: f64,
    shout_cool: bool,
    shout_poise: f64,
    shout_stamina: f64,
    drain: f64,
    blind: f64,
}

struct Def {
    kind: str,
    hp: f64,
    stamina_regen: f64,
    stamina_delay: f64,
    speed: f64,
    accel: f64,
    turn: f64,
    radius: f64,
    height: f64,
    view: f64,
    sight: str,
    load: str,
    grip: f64,
    tool_cls: str,
    tool_chip: f64,
    tool_block0: f64,
    tool_block1: f64,
    faction: str,
    has_yields: bool,
    yields: f64,
    soften: f64,
    dmg_mul: f64,
    front_guard: f64,
    floor: f64,
    keep_feet: bool,
    style: str,
    lantern: f64,
    boss: bool,
    // Lamb's build (zero for foes)
    has_bonus: bool,
    bonus_weak: f64,
    bonus_read: f64,
    has_levels: bool,
    lv_keys: Vec<str>,
    lv_vals: Vec<f64>,
    has_tempo: bool,
    tempo_stun: f64,
    tempo_regain: f64,
    learned: Vec<str>,
    brk_nose8: bool,
    brk_pen8: bool,
    brk_coat8: bool,
    brk_hat8: bool,
    set_keys: Vec<str>,
    set_vals: Vec<str>,
    roll_keys: Vec<str>,
    roll_vals: Vec<str>,
    use_list: Vec<str>,
    hand_keys: Vec<str>,
    hand_vals: Vec<str>,
    var_keys: Vec<str>,
    var_lists: Vec<Vec<str>>,
    moves: Vec<str>,
}

struct Act {
    id: str,
    f: f64,
    end: f64,
    hit: Vec<str>,
    charge: f64,
    charging: bool,
    dir: f64,
    seq: f64,
    has_carry: bool,
    carry0: f64,
    carry1: f64,
    has_charged: bool,
    charged: f64,
    // keys set later, in the order set: "gusted", "evaded"
    extra: Vec<str>,
    gusted: bool,
    evaded: Vec<str>,
}

struct BufEntry {
    a: str,
    t: f64,
    held: bool,
    seq: f64,
}

struct Seen {
    x: f64,
    z: f64,
    t: f64,
}

struct Pur {
    clock: f64,
    cut: f64,
    thrown: f64,
    lunged: f64,
    chase: f64,
    rest: f64,
    away: bool,
}

struct Mem {
    // false until the brain's first think: then the JS object is rebuilt
    inited: bool,
    next: f64,
    has_seen: bool,
    seen: Seen,
    move_mx: f64,
    move_mz: f64,
    cool: f64,
    stag: bool,
    retreat: f64,
    retreated: bool,
    side: f64,
    searched: f64,
    // keys set later, in the order set: lost, called, pur, chain, home
    extra: Vec<str>,
    lost: f64,
    called: bool,
    pur: Pur,
    chain: f64,
    home_x: f64,
    home_z: f64,
    home_face: f64,
}

struct Token {
    id: str,
    until: f64,
}

struct Fighter {
    id: str,
    team: str,
    kind: str,
    x: f64,
    z: f64,
    face: f64,
    vx: f64,
    vz: f64,
    kx: f64,
    kz: f64,
    hp: f64,
    hp_max: f64,
    st: f64,
    st_max: f64,
    st_wait: f64,
    winded: bool,
    poise: f64,
    poise_max: f64,
    poise_wait: f64,
    guard_t: f64,
    blind: f64,
    has_act: bool,
    act: Act,
    hitstop: f64,
    flash: f64,
    lock: str,
    lock_lost: f64,
    buf: Vec<BufEntry>,
    item_keys: Vec<str>,
    item_vals: Vec<f64>,
    out: bool,
    fallen: bool,
    yielded: bool,
    last_offense: f64,
    aware: bool,
    notice: f64,
    composure: f64,
    composure_max: f64,
    running: bool,
    lantern: f64,
    last_hit_by: str,
    tool: str,
    // keys set later, in the order set (see fighter_json)
    extra: Vec<str>,
    has_mem: bool,
    mem: Mem,
    engaged: bool,
    seq: f64,
    catch_miss: f64,
    catch_miss_null: bool,
    tokens: Vec<Token>,
    struck_at: f64,
    kited_by: f64,
    flinch_at: f64,
    carriage: bool,
    disarmed: bool,
    dropped: f64,
    trip_at: f64,
    called_at: f64,
    // the frame's input (not hashed)
    inp: Inp,
}

// A brain's or the pilot's input for one frame. Keys that the JS object does
// not have are marked absent; hold flags are -1 absent, 0 false, 1 true.
struct Inp {
    has_mx: bool,
    mx: f64,
    has_mz: bool,
    mz: f64,
    has_press: bool,
    press: Vec<str>,
    has_hold: bool,
    hold_heavy: i64,
    hold_block: i64,
    hold_run: i64,
    choke: bool,
}

struct Light {
    x: f64,
    z: f64,
    r: f64,
    k: f64,
    sodium: bool,
    off: bool,
}

struct GroundLight {
    x: f64,
    z: f64,
    r: f64,
    k: f64,
    until: f64,
}

struct Flood {
    z0: f64,
    z1: f64,
    z2: f64,
    z3: f64,
    add: f64,
}

struct Prop {
    kind: str,
    has_x: bool,
    x: f64,
    z: f64,
    on: bool,
    zone: Vec<f64>,
    rise: f64,
    open: bool,
    has_at: bool,
    at: f64,
    armed: bool,
    n: f64,
    light: f64,
}

struct Projectile {
    n: f64,
    owner: str,
    team: str,
    use_: str,
    x: f64,
    z: f64,
    y: f64,
    vx: f64,
    vz: f64,
    vy: f64,
    mass: f64,
    r: f64,
    has_light: bool,
    light_r: f64,
    light_k: f64,
    light_frames: f64,
    mv: Move,
    has_gh: bool,
    gh: f64,
    done: bool,
    evaded: Vec<str>,
    // keys set later, in the order set: gh, evaded
    extra: Vec<str>,
}

struct Cell {
    surface: str,
    h: f64,
    solid: bool,
}

struct Terms {
    tide: f64,
    fog: f64,
    rain: f64,
    frost: f64,
    light: f64,
    sodium: f64,
    wind_speed: f64,
    wind_x: f64,
    wind_z: f64,
    outdoors: bool,
    dark: f64,
    mother: str,
}

struct Arena {
    cell: f64,
    ox: f64,
    oz: f64,
    rows: Vec<str>,
    legend_keys: Vec<str>,
    legend_cells: Vec<Cell>,
    has_water: bool,
    water_a: f64,
    water_b: f64,
    water_vscale: f64,
    lights: Vec<Light>,
    exits: Vec<Vec<f64>>,
    tide_ends: bool,
    anchor_keys: Vec<str>,
    anchor_pts: Vec<Vec<f64>>,
    width: f64,
    depth: f64,
}

struct Ev {
    t: i64,
    typ: str,
    id: str,
    by: str,
    mv: str,
    kind: str,
    voice: str,
    yielded: bool,
    has_x: bool,
    x: f64,
    z: f64,
    // every field but t and type, as JSON text, for the trace
    keys: Vec<str>,
    vals: Vec<str>,
}

struct Attack {
    mv: str,
    min: f64,
    max: f64,
    w: f64,
    chain: f64,
    allies: f64,
}

struct BrainCfg {
    think: f64,
    range0: f64,
    range1: f64,
    flank_slot: f64,
    retreat_hp: f64,
    low_stamina: f64,
    cool0: f64,
    cool1: f64,
    attacks: Vec<Attack>,
    on_stagger: str,
    braced: str,
    dodge: str,
}

struct Pilot {
    hold: f64,
    cool: f64,
    style: str,
    catch_share: f64,
    has_goal: bool,
    goal_x: f64,
    goal_z: f64,
    stuck: f64,
    has_at: bool,
    at_x: f64,
    at_z: f64,
}

struct World {
    tick: i64,
    seed: u32,
    arena_name: str,
    move_ids: Vec<str>,
    moves: HashMap<str, Move>,
    def_ids: Vec<str>,
    defs: Vec<Def>,
    fighters: Vec<Fighter>,
    brain_ids: Vec<str>,
    brains: Vec<BrainCfg>,
    projectiles: Vec<Projectile>,
    next_proj: f64,
    ground_lights: Vec<GroundLight>,
    events: Vec<Ev>,
    arena: Arena,
    terms: Terms,
    floods: Vec<Flood>,
    seconds: f64,
    grip_keys: Vec<str>,
    grip_vals: Vec<f64>,
    lamps_now: Vec<GroundLight>,
    has_result: bool,
    outcome: str,
    reason: str,
    flee_t: f64,
    struck: Vec<str>,
    seen_violence: bool,
    props: Vec<Prop>,
    kited: f64,
    apart: f64,
    telegraphs_seen: f64,
    // barks
    bark_last_keys: Vec<str>,
    bark_last_vals: Vec<f64>,
    bark_last_any: f64,
    bark_has_tide: bool,
    bark_tide: f64,
    pilot: Pilot,
    crowd: f64,
    // the field's terms at each refresh (frames 1, 31, 61 ...) and the clock after each frame
    terms_list: Vec<Terms>,
    clocks: Vec<f64>,
}
