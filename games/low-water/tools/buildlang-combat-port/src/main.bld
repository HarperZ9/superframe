// The Low Water combat step in BuildLang: run the 40 corpus fights from the
// exported setup with the ported sim, brains and pilot, write each trace, and
// compare it line by line with the JS trace.
// Usage: main.exe <step-inputs.json> <js-traces dir> <out dir>
mod json;
mod jsmath;
mod detmath;
mod util;
mod data;
mod load;
mod events;
mod field;
mod fighter;
mod target;
mod stealth;
mod hits;
mod props;
mod world;
mod brain;
mod pilot;
mod trace;

fn run_fight(w: &mut World) -> Vec<str> {
    let mut out: Vec<str> = Vec::new();
    out.push(rec_cbegin(w));
    let mut last = "";
    let mut f = 0;
    while f < 900 && !w.has_result {
        let tick = w.tick;
        let inp = pilot_input(w);
        let key = inp_json(inp);
        if key != last {
            out.push(rec_cin(tick, inp));
            last = key;
        }
        step(w, inp);
        let mut i = 0;
        while i < w.events.len() {
            out.push(rec_cev(w.events[i]));
            i += 1;
        }
        if w.tick % 60 == 0 {
            out.push(rec_cstate(w, w.clocks[(w.tick - 1) as usize]));
        }
        f += 1;
    }
    out.push(rec_cend(w, w.clocks[(w.tick - 1) as usize]));
    out
}

fn kind_of_line(line: str) -> str {
    if line.starts_with("{\"t\":\"cin\"") {
        return "cin";
    }
    if line.starts_with("{\"t\":\"cev\"") {
        return "cev";
    }
    if line.starts_with("{\"t\":\"cstate\"") {
        return "cstate";
    }
    if line.starts_with("{\"t\":\"cend\"") {
        return "cend";
    }
    "cbegin"
}

fn main() ~ Console + FileSystem + Environment {
    let text = read_file(args_get(1));
    let dir = args_get(2);
    let out_dir = args_get(3);
    let root = match json_parse(text) {
        Ok(j) => j,
        Err(e) => {
            println!("parse error {}", e);
            return;
        },
    };
    let runs = jitems(root, "runs");
    let kinds: Vec<str> = vec!["cbegin", "cin", "cev", "cstate", "cend"];
    let mut same: Vec<i64> = vec![0, 0, 0, 0, 0];
    let mut total: Vec<i64> = vec![0, 0, 0, 0, 0];
    let mut files_same = 0;
    let mut i = 0;
    while i < runs.len() {
        let name = jstr(runs[i], "name");
        let mut w = world_of(runs[i]);
        let lines = run_fight(&mut w);
        let body = join_lines(lines);
        let ok = write_file(format!("{}/{}.jsonl", out_dir, name), body);
        let js = read_file(format!("{}/{}.jsonl", dir, name));
        let js_lines = js.split("\n");
        if body == js {
            files_same += 1;
        }
        let mut first_bad = -1;
        let mut k = 0;
        while k < js_lines.len() {
            let jl = js_lines[k];
            if jl.len() > 0 {
                let kd = index_of(kinds, kind_of_line(jl)) as usize;
                total[kd] = total[kd] + 1;
                if k < lines.len() && lines[k] == jl {
                    same[kd] = same[kd] + 1;
                } else if first_bad < 0 {
                    first_bad = k as i64;
                }
            }
            k += 1;
        }
        if first_bad >= 0 {
            let b = first_bad as usize;
            println!("{}: first difference at line {}", name, b + 1);
            println!("  js: {}", js_lines[b]);
            if b < lines.len() {
                println!("  bl: {}", lines[b]);
            }
        }
        if !ok {
            println!("could not write {}", name);
        }
        i += 1;
    }
    println!("files byte-identical: {} of {}", files_same, runs.len());
    let mut k = 0;
    while k < kinds.len() {
        println!("{}: {} of {} lines identical", kinds[k], same[k], total[k]);
        k += 1;
    }
}
