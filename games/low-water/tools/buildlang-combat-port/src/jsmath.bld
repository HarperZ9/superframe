// JS Math functions the pilot calls (tools/pilot.mjs uses Math.sin, Math.cos,
// Math.atan2 and Math.hypot, not the sim's DETMATH). V8 computes the first
// three with fdlibm (src/base/ieee754.cc) and hypot with a scaled Kahan sum
// (src/builtins/math.tq); these are ports of those routines, so they give the
// same bits. Arguments beyond 2^19 pi/2 are not reduced (the fight never
// passes one).

fn fd_hi(x: f64) -> i32 {
    ((x.to_bits() >> 32) as u32) as i32
}

fn fd_lo(x: f64) -> u32 {
    (x.to_bits() & 0xffffffff_u64) as u32
}

fn fd_from_words(hi: u32, lo: u32) -> f64 {
    f64::from_bits(((hi as u64) << 32) | (lo as u64))
}

fn fd_kernel_sin(x: f64, y: f64, iy: i32) -> f64 {
    let s1 = -1.66666666666666324348e-01;
    let s2 = 8.33333333332248946124e-03;
    let s3 = -1.98412698298579493134e-04;
    let s4 = 2.75573137070700676789e-06;
    let s5 = -2.50507602534068634195e-08;
    let s6 = 1.58969099521155010221e-10;
    let ix = fd_hi(x) & 0x7fffffff;
    if ix < 0x3e400000 {
        if (x as i64) == 0 {
            return x;
        }
    }
    let z = x * x;
    let v = z * x;
    let r = s2 + z * (s3 + z * (s4 + z * (s5 + z * s6)));
    if iy == 0 {
        x + v * (s1 + z * r)
    } else {
        x - ((z * (0.5 * y - v * r) - y) - v * s1)
    }
}

fn fd_kernel_cos(x: f64, y: f64) -> f64 {
    let c1 = 4.16666666666666019037e-02;
    let c2 = -1.38888888888741095749e-03;
    let c3 = 2.48015872894767294178e-05;
    let c4 = -2.75573143513906633035e-07;
    let c5 = 2.08757232129817482790e-09;
    let c6 = -1.13596475577881948265e-11;
    let ix = fd_hi(x) & 0x7fffffff;
    if ix < 0x3e400000 {
        if (x as i64) == 0 {
            return 1.0;
        }
    }
    let z = x * x;
    let r = z * (c1 + z * (c2 + z * (c3 + z * (c4 + z * (c5 + z * c6)))));
    if ix < 0x3fd33333 {
        return 1.0 - (0.5 * z - (z * r - x * y));
    }
    let mut qx = 0.28125;
    if ix <= 0x3fe90000 {
        qx = fd_from_words((ix - 0x00200000) as u32, 0_u32);
    }
    let iz = 0.5 * z - qx;
    let a = 1.0 - qx;
    a - (iz - (z * r - x * y))
}

fn fd_npio2_hw(n: i64) -> i32 {
    let t: Vec<i32> = vec![
        0x3ff921fb, 0x400921fb, 0x4012d97c, 0x401921fb, 0x401f6a7a, 0x4022d97c, 0x4025fdbb,
        0x402921fb, 0x402c463a, 0x402f6a7a, 0x4031475c, 0x4032d97c, 0x40346b9c, 0x4035fdbb,
        0x40378fdb, 0x403921fb, 0x403ab41b, 0x403c463a, 0x403dd85a, 0x403f6a7a, 0x40407e4c,
        0x4041475c, 0x4042106c, 0x4042d97c, 0x4043a28c, 0x40446b9c, 0x404534ac, 0x4045fdbb,
        0x4046c6cb, 0x40478fdb, 0x404858eb, 0x404921fb
    ];
    t[n as usize]
}

// x = n pi/2 + (y0 + y1); returns (n, y0, y1).
fn fd_rem_pio2(x: f64) -> (i64, f64, f64) {
    let pio2_1 = 1.57079632673412561417e+00;
    let pio2_1t = 6.07710050650619224932e-11;
    let pio2_2 = 6.07710050630396597660e-11;
    let pio2_2t = 2.02226624879595063154e-21;
    let pio2_3 = 2.02226624871116645580e-21;
    let pio2_3t = 8.47842766036889956997e-32;
    let invpio2 = 6.36619772367581382433e-01;
    let hx = fd_hi(x);
    let ix = hx & 0x7fffffff;
    if ix <= 0x3fe921fb {
        return (0, x, 0.0);
    }
    if ix < 0x4002d97c {
        if hx > 0 {
            let mut z = x - pio2_1;
            if ix != 0x3ff921fb {
                let y0 = z - pio2_1t;
                return (1, y0, (z - y0) - pio2_1t);
            }
            z = z - pio2_2;
            let y0 = z - pio2_2t;
            return (1, y0, (z - y0) - pio2_2t);
        }
        let mut z = x + pio2_1;
        if ix != 0x3ff921fb {
            let y0 = z + pio2_1t;
            return (-1, y0, (z - y0) + pio2_1t);
        }
        z = z + pio2_2;
        let y0 = z + pio2_2t;
        return (-1, y0, (z - y0) + pio2_2t);
    }
    let t0 = x.abs();
    let n = (t0 * invpio2 + 0.5) as i64;
    let fnn = n as f64;
    let mut r = t0 - fnn * pio2_1;
    let mut w = fnn * pio2_1t;
    let mut y0 = r - w;
    if !(n < 32 && ix != fd_npio2_hw(n - 1)) {
        let j = ix >> 20;
        let mut i = j - ((fd_hi(y0) >> 20) & 0x7ff);
        if i > 16 {
            let t = r;
            w = fnn * pio2_2;
            r = t - w;
            w = fnn * pio2_2t - ((t - r) - w);
            y0 = r - w;
            i = j - ((fd_hi(y0) >> 20) & 0x7ff);
            if i > 49 {
                let t2 = r;
                w = fnn * pio2_3;
                r = t2 - w;
                w = fnn * pio2_3t - ((t2 - r) - w);
                y0 = r - w;
            }
        }
    }
    let y1 = (r - y0) - w;
    if hx < 0 {
        return (-n, -y0, -y1);
    }
    (n, y0, y1)
}

fn js_sin(x: f64) -> f64 {
    let ix = fd_hi(x) & 0x7fffffff;
    if ix <= 0x3fe921fb {
        return fd_kernel_sin(x, 0.0, 0);
    }
    if ix >= 0x7ff00000 {
        return x - x;
    }
    let red = fd_rem_pio2(x);
    let q = ((red.0 % 4) + 4) % 4;
    if q == 0 {
        fd_kernel_sin(red.1, red.2, 1)
    } else if q == 1 {
        fd_kernel_cos(red.1, red.2)
    } else if q == 2 {
        -fd_kernel_sin(red.1, red.2, 1)
    } else {
        -fd_kernel_cos(red.1, red.2)
    }
}

fn js_cos(x: f64) -> f64 {
    let ix = fd_hi(x) & 0x7fffffff;
    if ix <= 0x3fe921fb {
        return fd_kernel_cos(x, 0.0);
    }
    if ix >= 0x7ff00000 {
        return x - x;
    }
    let red = fd_rem_pio2(x);
    let q = ((red.0 % 4) + 4) % 4;
    if q == 0 {
        fd_kernel_cos(red.1, red.2)
    } else if q == 1 {
        -fd_kernel_sin(red.1, red.2, 1)
    } else if q == 2 {
        -fd_kernel_cos(red.1, red.2)
    } else {
        fd_kernel_sin(red.1, red.2, 1)
    }
}

fn fd_atan(x0: f64) -> f64 {
    let at: Vec<f64> = vec![
        3.33333333333329318027e-01, -1.99999999998764832476e-01, 1.42857142725034663711e-01,
        -1.11111104054623557880e-01, 9.09088713343650656196e-02, -7.69187620504482999495e-02,
        6.66107313738753120669e-02, -5.83357013379057348645e-02, 4.97687799461593236017e-02,
        -3.65315727442169155270e-02, 1.62858201153657823623e-02
    ];
    let atanhi: Vec<f64> = vec![
        4.63647609000806093515e-01, 7.85398163397448278999e-01, 9.82793723247329054082e-01,
        1.57079632679489655800e+00
    ];
    let atanlo: Vec<f64> = vec![
        2.26987774529616870924e-17, 3.06161699786838301793e-17, 1.39033110312309984516e-17,
        6.12323399573676603587e-17
    ];
    let hx = fd_hi(x0);
    let ix = hx & 0x7fffffff;
    let mut x = x0;
    if ix >= 0x44100000 {
        if x != x {
            return x + x;
        }
        if hx > 0 {
            return atanhi[3] + atanlo[3];
        }
        return -atanhi[3] - atanlo[3];
    }
    let mut id: i64 = -1;
    if ix < 0x3fdc0000 {
        if ix < 0x3e400000 {
            return x;
        }
    } else {
        x = x.abs();
        if ix < 0x3ff30000 {
            if ix < 0x3fe60000 {
                id = 0;
                x = (2.0 * x - 1.0) / (2.0 + x);
            } else {
                id = 1;
                x = (x - 1.0) / (x + 1.0);
            }
        } else if ix < 0x40038000 {
            id = 2;
            x = (x - 1.5) / (1.0 + 1.5 * x);
        } else {
            id = 3;
            x = -1.0 / x;
        }
    }
    let z = x * x;
    let w = z * z;
    let s1 = z * (at[0] + w * (at[2] + w * (at[4] + w * (at[6] + w * (at[8] + w * at[10])))));
    let s2 = w * (at[1] + w * (at[3] + w * (at[5] + w * (at[7] + w * at[9]))));
    if id < 0 {
        return x - x * (s1 + s2);
    }
    let k = id as usize;
    let r = atanhi[k] - ((x * (s1 + s2) - atanlo[k]) - x);
    if hx < 0 {
        -r
    } else {
        r
    }
}

fn js_atan2(y: f64, x: f64) -> f64 {
    let pi_o_2 = 1.5707963267948965580e+00;
    let pi = 3.1415926535897931160e+00;
    let pi_lo = 1.2246467991473531772e-16;
    let pi_o_4 = 7.8539816339744827900e-01;
    if x != x || y != y {
        return x + y;
    }
    let hx = fd_hi(x);
    let lx = fd_lo(x);
    let hy = fd_hi(y);
    let ly = fd_lo(y);
    let ix = hx & 0x7fffffff;
    let iy = hy & 0x7fffffff;
    if hx == 0x3ff00000 && lx == 0_u32 {
        return fd_atan(y);
    }
    let mut m = ((hy >> 31) & 1) | ((hx >> 30) & 2);
    if iy == 0 && ly == 0_u32 {
        if m == 0 || m == 1 {
            return y;
        }
        if m == 2 {
            return pi;
        }
        return -pi;
    }
    if ix == 0 && lx == 0_u32 {
        if hy < 0 {
            return -pi_o_2;
        }
        return pi_o_2;
    }
    if ix == 0x7ff00000 {
        if iy == 0x7ff00000 {
            if m == 0 {
                return pi_o_4;
            }
            if m == 1 {
                return -pi_o_4;
            }
            if m == 2 {
                return 3.0 * pi_o_4;
            }
            return -3.0 * pi_o_4;
        }
        if m == 0 {
            return 0.0;
        }
        if m == 1 {
            return -0.0;
        }
        if m == 2 {
            return pi;
        }
        return -pi;
    }
    if iy == 0x7ff00000 {
        if hy < 0 {
            return -pi_o_2;
        }
        return pi_o_2;
    }
    let k = (iy - ix) >> 20;
    let mut z = 0.0;
    if k > 60 {
        z = pi_o_2 + 0.5 * pi_lo;
        m = m & 1;
    } else if hx < 0 && k < -60 {
        z = 0.0;
    } else {
        z = fd_atan((y / x).abs());
    }
    if m == 0 {
        z
    } else if m == 1 {
        -z
    } else if m == 2 {
        pi - (z - pi_lo)
    } else {
        (z - pi_lo) - pi
    }
}

// Math.hypot(a, b) as V8 computes it: scale by the larger magnitude, Kahan sum.
fn js_hypot(a: f64, b: f64) -> f64 {
    if a.abs() == f64::INFINITY || b.abs() == f64::INFINITY {
        return f64::INFINITY;
    }
    if a != a || b != b {
        return f64::NAN;
    }
    let x = a.abs();
    let y = b.abs();
    let mut max = 0.0;
    if x > max {
        max = x;
    }
    if y > max {
        max = y;
    }
    if max == 0.0 {
        return 0.0;
    }
    let mut sum = 0.0;
    let mut comp = 0.0;
    let n1 = x / max;
    let s1 = n1 * n1 - comp;
    let p1 = sum + s1;
    comp = (p1 - sum) - s1;
    sum = p1;
    let n2 = y / max;
    let s2 = n2 * n2 - comp;
    let p2 = sum + s2;
    sum = p2;
    sum.sqrt() * max
}
